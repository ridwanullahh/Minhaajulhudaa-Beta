{
  "name": "minhaajulhudaa-beta",
  "type": "module",
  "version": "1.0.0",
  "description": "Minhaajulhudaa multi-platform organization (School, Masjid, Charity, Travels) built with Astro and Lightbase",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:create": "node scripts/create-collections.mjs",
    "db:seed": "node scripts/seed-data.mjs",
    "db:seed:new": "node scripts/seed-new-lightbase.mjs",
    "db:verify": "node scripts/verify-seed.mjs",
    "db:setup": "npm run db:create && npm run db:seed && npm run db:verify",
    "build:paas": "BUILD_TARGET=node astro build",
    "postbuild": "lightbase-edge deploy"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.11",
    "@astrojs/sitemap": "^3.2.1",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.4.7",
    "bcryptjs": "^2.4.3",
    "cookie": "^2.0.1",
    "dotenv": "^17.4.2",
    "nodemailer": "^10.4.0",
    "source-map-js": "^1.2.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "undici": "^8.12.4",
    "vite": "^8.3.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "lightbase-edge": "^0.1.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "sharp@0.34.5": true
  },
  "overrides": {
    "zod": "^4.6.7",
    "source-map-js": "^1.2.2",
    "undici": "^8.12.4"
  }
}