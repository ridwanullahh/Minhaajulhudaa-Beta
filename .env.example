# ============================================
# MINHAAJULHUDAA BETA - ENVIRONMENT CONFIGURATION
# ============================================

# ============================================
# LIGHTBASE DATABASE (server-side only)
# ============================================
LIGHTBASE_API_KEY=your_lightbase_api_key_here
LIGHTBASE_PROJECT_ID=minhaajulhuda-beta
LIGHTBASE_BASE_URL=http://lightbase.80.225.189.74.sslip.io

# ============================================
# SESSION SECURITY
# ============================================
# HMAC-SHA256 secret for signing session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-this-secret-in-production-min-32-chars

# ============================================
# ADMIN CREDENTIALS (env-based, per-platform)
# ============================================
# Format: email:password:role:firstName:lastName,email2:password2:...
# Roles: super_admin, platform_admin, editor, author
# Super admins have access to ALL platforms.
#
# Examples:
# ADMIN_USERS_SCHOOL=admin@school.com:SecurePass2026!:platform_admin:Admin:School
# ADMIN_USERS_SCHOOL=teacher@school.com:TeacherPass:editor:Ustadh:Ahmad
# ADMIN_USERS_MASJID=imam@masjid.com:ImamPass2026!:platform_admin:Imam:Masjid
# ADMIN_USERS_CHARITY=director@charity.com:CharityPass2026!:platform_admin:Director:Charity
# ADMIN_USERS_TRAVELS=manager@travels.com:TravelsPass2026!:platform_admin:Manager:Travels
# ADMIN_USERS_SUPER=super@minhaajulhudaa.com:SuperPass2026!:super_admin:Super:Admin
ADMIN_USERS_SCHOOL=
ADMIN_USERS_MASJID=
ADMIN_USERS_CHARITY=
ADMIN_USERS_TRAVELS=
ADMIN_USERS_SUPER=

# ============================================
# PAYSTACK PAYMENT GATEWAY
# ============================================
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# ============================================
# CLOUDINARY MEDIA MANAGEMENT
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ============================================
# EMAIL SERVICE (Gmail SMTP)
# ============================================
# Option A: App Password (recommended for most setups)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_NAME=Minhaajulhudaa

# Option B: OAuth2 Refresh Token (for enterprise/service accounts)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REFRESH_TOKEN=your-refresh-token

# Email sender address (used in From header and email templates)
FROM_EMAIL=noreply@minhaajulhudaa.org

# ============================================
# SITE SETTINGS
# ============================================
SITE_URL=http://localhost:4321
