---
/**
 * Footer component
 * Uses dynamic contact settings from the DB (platform_settings collection).
 */
import { PLATFORMS, BRAND } from '../../lib/constants';
import { getContactSettings } from '../../lib/contact-settings';

interface Props {
  platform?: string;
}

const { platform } = Astro.props;
const platformConfig = platform ? PLATFORMS[platform as keyof typeof PLATFORMS] : null;
const year = new Date().getFullYear();

// Load contact settings from DB
let contactSettings;
try {
  contactSettings = await getContactSettings(platform || 'general');
} catch {
  contactSettings = {
    phone: '+234 800 000 0000',
    email: 'info@minhaajulhudaa.org',
    address: 'Lagos, Nigeria',
    whatsapp: '',
    facebook: '',
    twitter: '',
    instagram: '',
    officeHours: 'Mon-Fri: 8AM-4PM',
  };
}
---

<footer class="border-t mt-16" style="border-color: var(--color-border); background: var(--color-surface);">
  <div class="container-app py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="md:col-span-1">
        <div class="flex items-center gap-2 mb-4">
          <svg width="28" height="28" viewBox="0 0 64 64">
            <rect width="64" height="64" rx="16" fill="var(--color-primary)"/>
            <path d="M16 28 L32 24 L48 28 L48 44 L32 40 L16 44 Z" fill="#FFFFFF" opacity="0.95"/>
            <path d="M32 24 L32 40" stroke="var(--color-primary)" stroke-width="1.5"/><path d="M22 33 Q26 30 30 33 M34 33 Q38 30 42 33" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" fill="none"/><path d="M28 20 A6 6 0 1 0 34 24 A4 4 0 1 1 28 20 Z" fill="var(--color-accent)"/>
            <circle cx="32" cy="32" r="3" fill="var(--color-accent)"/>
          </svg>
          <span class="font-bold" style="font-family: var(--font-heading);">
            {platformConfig ? platformConfig.name : BRAND.name}
          </span>
        </div>
        <p class="text-sm" style="color: var(--color-muted);">
          {platformConfig ? platformConfig.description : BRAND.tagline}
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-semibold mb-4 text-sm">Quick Links</h4>
        <ul class="space-y-2 text-sm" style="color: var(--color-muted);">
          {platform === 'school' && (
            <>
              <li><a href="/school" class="hover:text-[var(--color-primary)]">Home</a></li>
              <li><a href="/school/about" class="hover:text-[var(--color-primary)]">About</a></li>
              <li><a href="/school/admission" class="hover:text-[var(--color-primary)]">Admission</a></li>
              <li><a href="/school/news" class="hover:text-[var(--color-primary)]">News</a></li>
            </>
          )}
          {platform === 'masjid' && (
            <>
              <li><a href="/masjid" class="hover:text-[var(--color-primary)]">Home</a></li>
              <li><a href="/masjid/about" class="hover:text-[var(--color-primary)]">About</a></li>
              <li><a href="/masjid/quran" class="hover:text-[var(--color-primary)]">Qur'an Player</a></li>
              <li><a href="/masjid/donate" class="hover:text-[var(--color-primary)]">Donate</a></li>
            </>
          )}
          {platform === 'charity' && (
            <>
              <li><a href="/charity" class="hover:text-[var(--color-primary)]">Home</a></li>
              <li><a href="/charity/campaigns" class="hover:text-[var(--color-primary)]">Campaigns</a></li>
              <li><a href="/charity/how-to-help" class="hover:text-[var(--color-primary)]">How to Help</a></li>
              <li><a href="/charity/faq" class="hover:text-[var(--color-primary)]">FAQ</a></li>
            </>
          )}
          {platform === 'travels' && (
            <>
              <li><a href="/travels" class="hover:text-[var(--color-primary)]">Home</a></li>
              <li><a href="/travels/hajj-umrah" class="hover:text-[var(--color-primary)]">Hajj & Umrah</a></li>
              <li><a href="/travels/book" class="hover:text-[var(--color-primary)]">Book Now</a></li>
              <li><a href="/travels/guide" class="hover:text-[var(--color-primary)]">Travel Guide</a></li>
            </>
          )}
          {!platform && (
            <>
              <li><a href="/school" class="hover:text-[var(--color-primary)]">School</a></li>
              <li><a href="/masjid" class="hover:text-[var(--color-primary)]">Masjid</a></li>
              <li><a href="/charity" class="hover:text-[var(--color-primary)]">Charity</a></li>
              <li><a href="/travels" class="hover:text-[var(--color-primary)]">Travels</a></li>
            </>
          )}
        </ul>
      </div>

      <!-- Platforms -->
      {platform && (
        <div>
          <h4 class="font-semibold mb-4 text-sm">Platforms</h4>
          <ul class="space-y-2 text-sm" style="color: var(--color-muted);">
            <li><a href="/school" class="hover:text-[var(--color-primary)]">School</a></li>
            <li><a href="/masjid" class="hover:text-[var(--color-primary)]">Masjid</a></li>
            <li><a href="/charity" class="hover:text-[var(--color-primary)]">Charity</a></li>
            <li><a href="/travels" class="hover:text-[var(--color-primary)]">Travels</a></li>
          </ul>
        </div>
      )}

      <!-- Contact (dynamic from DB) -->
      <div>
        <h4 class="font-semibold mb-4 text-sm">Contact</h4>
        <ul class="space-y-3 text-sm" style="color: var(--color-muted);">
          <li class="flex items-start gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5" style="color: var(--color-primary);"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{contactSettings.address}, {contactSettings.city}, {contactSettings.country}</span>
          </li>
          <li class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0" style="color: var(--color-primary);"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href={`tel:${contactSettings.phone}`} class="hover:text-[var(--color-primary)]">{contactSettings.phone}</a>
          </li>
          <li class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0" style="color: var(--color-primary);"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href={`mailto:${contactSettings.email}`} class="hover:text-[var(--color-primary)]">{contactSettings.email}</a>
          </li>
          {contactSettings.officeHours && (
            <li class="flex items-start gap-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5" style="color: var(--color-primary);"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span>{contactSettings.officeHours}</span>
            </li>
          )}
        </ul>
        <!-- Social Links -->
        {(contactSettings.facebook || contactSettings.twitter || contactSettings.instagram || contactSettings.whatsapp) && (
          <div class="flex items-center gap-3 mt-4">
            {contactSettings.facebook && (
              <a href={contactSettings.facebook} target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg flex items-center justify-center border transition-colors hover:bg-[rgb(5,179,77,0.08)]" style="border-color: var(--color-border); color: var(--color-muted);" aria-label="Facebook">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
            )}
            {contactSettings.twitter && (
              <a href={contactSettings.twitter} target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg flex items-center justify-center border transition-colors hover:bg-[rgb(5,179,77,0.08)]" style="border-color: var(--color-border); color: var(--color-muted);" aria-label="Twitter/X">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            )}
            {contactSettings.instagram && (
              <a href={contactSettings.instagram} target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg flex items-center justify-center border transition-colors hover:bg-[rgb(5,179,77,0.08)]" style="border-color: var(--color-border); color: var(--color-muted);" aria-label="Instagram">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
            )}
            {contactSettings.whatsapp && (
              <a href={`https://wa.me/${contactSettings.whatsapp.replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg flex items-center justify-center border transition-colors hover:bg-[rgb(5,179,77,0.08)]" style="border-color: var(--color-border); color: var(--color-muted);" aria-label="WhatsApp">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.149-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
              </a>
            )}
          </div>
        )}
      </div>
    </div>

    <div class="border-t mt-8 pt-6 flex flex-col md:flex-row justify-between items-center gap-4" style="border-color: var(--color-border);">
      <p class="text-xs" style="color: var(--color-muted);">
        {year} {BRAND.name}. All rights reserved.
      </p>
      <p class="text-xs arabic" style="color: var(--color-muted);" dir="rtl">
        بسم الله الرحمن الرحيم
      </p>
    </div>
  </div>
</footer>
