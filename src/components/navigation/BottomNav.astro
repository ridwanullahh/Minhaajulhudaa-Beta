---

<nav class="lg:hidden fixed bottom-0 left-0 right-0 z-50 backdrop-blur-lg border-t" style="background: color-mix(in srgb, var(--color-surface) 95%, transparent); border-color: var(--color-border); padding-bottom: env(safe-area-inset-bottom);">
  <div class="flex items-center justify-around h-16">
    {bottomItems.map((item) => {
      const isActive = currentPath === item.href || (item.href !== `/${platform}` && currentPath.startsWith(item.href));
      const icon = ICONS[item.label] || ICONS['Home'];
      return (
        <a
          href={item.href}
          class="flex flex-col items-center justify-center gap-1 px-2 py-1 min-w-[56px] transition-colors"
          style={isActive ? 'color: var(--color-primary);' : 'color: var(--color-muted);'}
        >
          <Fragment set:html={icon} />
          <span class="text-[10px] font-semibold">{item.label}</span>
          <div class="w-1 h-1 rounded-full" style={isActive ? 'background: var(--color-primary);' : 'background: transparent;'}></div>
        </a>
      );
    })}
  </div>
</nav>
