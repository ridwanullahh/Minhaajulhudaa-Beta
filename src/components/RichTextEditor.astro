---
/**
 * RichTextEditor Component
 *
 * A reusable rich text editor for admin pages that supports both
 * markdown editing and a WYSIWYG-style toolbar.
 *
 * Usage:
 * <RichTextEditor id="post-content" name="content" label="Content" value={post.content} rows={12} />
 *
 * Features:
 * - Markdown syntax support (headings, bold, italic, lists, links, etc.)
 * - Toolbar with formatting buttons (no emojis, SVG icons only)
 * - Preview mode (toggles between markdown source and rendered HTML)
 * - Fullscreen mode
 * - Keyboard shortcuts (Ctrl+B bold, Ctrl+I italic, Ctrl+K link)
 * - Auto-resize textarea
 * - Tab key inserts spaces (not focus change)
 */

interface Props {
  id: string;
  name: string;
  label?: string;
  value?: string;
  rows?: number;
  placeholder?: string;
  required?: boolean;
  hint?: string;
}

const {
  id,
  name,
  label,
  value = '',
  rows = 10,
  placeholder = 'Write your content here. Markdown supported: # Heading, **bold**, *italic*, - list item, [link](url)',
  required = false,
  hint = 'Supports Markdown: # H1, ## H2, **bold**, *italic*, - lists, [links](url), > quote, ```code```',
} = Astro.props;
---

<div class="rte-wrapper" data-editor-id={id}>
  {label && (
    <div class="flex items-center justify-between mb-1">
      <label class="block text-sm font-medium" for={id}>{label}{required && <span style="color: var(--color-error);"> *</span>}</label>
      <div class="flex items-center gap-2">
        <button type="button" class="rte-tab rte-tab-write text-xs px-2 py-1 rounded" data-target={id} style="background: var(--color-primary); color: white;">Write</button>
        <button type="button" class="rte-tab rte-tab-preview text-xs px-2 py-1 rounded" data-target={id} style="background: var(--color-surface); color: var(--color-muted);">Preview</button>
      </div>
    </div>
  )}

  <!-- Toolbar -->
  <div class="rte-toolbar flex flex-wrap items-center gap-1 p-2 rounded-t-lg border" style="border-color: var(--color-border); background: var(--color-surface);">
    <button type="button" class="rte-btn" data-action="heading" data-target={id} title="Heading (Ctrl+H)" aria-label="Add heading">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 12h12M6 4v16M18 4v16"/></svg>
    </button>
    <button type="button" class="rte-btn" data-action="heading2" data-target={id} title="Heading 2" aria-label="Heading 2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12h12M4 4v16M16 4v16M20 16h.01M20 12h.01"/></svg>
    </button>
    <div class="rte-divider"></div>
    <button type="button" class="rte-btn" data-action="bold" data-target={id} title="Bold (Ctrl+B)" aria-label="Bold">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/></svg>
    </button>
    <button type="button" class="rte-btn" data-action="italic" data-target={id} title="Italic (Ctrl+I)" aria-label="Italic">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="4" x2="10" y2="4"/><line x1="14" y1="20" x2="5" y2="20"/><line x1="15" y1="4" x2="9" y2="20"/></svg>
    </button>
    <button type="button" class="rte-btn" data-action="strikethrough" data-target={id} title="Strikethrough" aria-label="Strikethrough">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4H9a3 3 0 0 0-2.83 4M14 12a4 4 0 0 1 0 8H6"/><line x1="4" y1="12" x2="20" y2="12"/></svg>
    </button>
    <div class="rte-divider"></div>
    <button type="button" class="rte-btn" data-action="ul" data-target={id} title="Bullet List" aria-label="Bullet list">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
    </button>
    <button type="button" class="rte-btn" data-action="ol" data-target={id} title="Numbered List" aria-label="Numbered list">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="10" y1="6" x2="21" y2="6"/><line x1="10" y1="12" x2="21" y2="12"/><line x1="10" y1="18" x2="21" y2="18"/><path d="M4 6h1v4M4 10h2M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"/></svg>
    </button>
    <button type="button" class="rte-btn" data-action="quote" data-target={id} title="Quote" aria-label="Blockquote">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V21z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
    </button>
    <div class="rte-divider"></div>
    <button type="button" class="rte-btn" data-action="link" data-target={id} title="Link (Ctrl+K)" aria-label="Insert link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
    </button>
    <button type="button" class="rte-btn" data-action="image" data-target={id} title="Image" aria-label="Insert image">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
    </button>
    <button type="button" class="rte-btn" data-action="code" data-target={id} title="Code Block" aria-label="Code block">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
    </button>
    <button type="button" class="rte-btn" data-action="hr" data-target={id} title="Horizontal Rule" aria-label="Horizontal rule">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg>
    </button>
    <div class="rte-divider"></div>
    <button type="button" class="rte-btn" data-action="fullscreen" data-target={id} title="Fullscreen" aria-label="Toggle fullscreen">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
    </button>
  </div>

  <!-- Editor + Preview -->
  <div class="rte-content border border-t-0 rounded-b-lg overflow-hidden" style="border-color: var(--color-border);">
    <textarea
      id={id}
      name={name}
      rows={rows}
      class="rte-textarea w-full px-3 py-2 font-mono text-sm resize-y outline-none"
      style="background: var(--color-bg); color: var(--color-foreground); min-height: {rows * 24}px;"
      placeholder={placeholder}
      required={required}
    >{value}</textarea>
    <div id={`${id}-preview`} class="rte-preview hidden p-4 prose max-w-none" style="background: var(--color-bg); color: var(--color-foreground);"></div>
  </div>

  {hint && <p class="text-xs mt-1" style="color: var(--color-muted);">{hint}</p>}
</div>

<style>
  .rte-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 4px;
    color: var(--color-muted);
    cursor: pointer;
    transition: all 0.15s;
  }
  .rte-btn:hover {
    background: rgb(5 179 77 / 0.1);
    color: var(--color-primary);
  }
  .rte-btn:active {
    transform: scale(0.95);
  }
  .rte-divider {
    width: 1px;
    height: 20px;
    background: var(--color-border);
    margin: 0 4px;
  }
  .rte-wrapper.rte-fullscreen {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    background: var(--color-bg);
    padding: 1rem;
    max-width: none !important;
  }
  .rte-wrapper.rte-fullscreen .rte-textarea {
    min-height: calc(100vh - 200px) !important;
  }
  .rte-preview h1 { font-size: 1.75rem; font-weight: 700; margin: 1rem 0 0.5rem; }
  .rte-preview h2 { font-size: 1.5rem; font-weight: 700; margin: 1rem 0 0.5rem; }
  .rte-preview h3 { font-size: 1.25rem; font-weight: 600; margin: 0.875rem 0 0.5rem; }
  .rte-preview h4 { font-size: 1.125rem; font-weight: 600; margin: 0.75rem 0 0.5rem; }
  .rte-preview p { margin: 0.5rem 0; line-height: 1.7; }
  .rte-preview ul, .rte-preview ol { margin: 0.5rem 0; padding-left: 1.5rem; }
  .rte-preview li { margin: 0.25rem 0; }
  .rte-preview blockquote { border-left: 3px solid var(--color-primary); padding-left: 1rem; margin: 0.75rem 0; color: var(--color-muted); font-style: italic; }
  .rte-preview code { background: var(--color-surface); padding: 0.125rem 0.375rem; border-radius: 3px; font-size: 0.875em; }
  .rte-preview pre { background: var(--color-surface); padding: 0.75rem; border-radius: 6px; overflow-x: auto; margin: 0.75rem 0; }
  .rte-preview pre code { background: none; padding: 0; }
  .rte-preview table { width: 100%; border-collapse: collapse; margin: 0.75rem 0; }
  .rte-preview th, .rte-preview td { border: 1px solid var(--color-border); padding: 0.5rem; text-align: left; }
  .rte-preview th { background: var(--color-surface); font-weight: 600; }
  .rte-preview hr { border: none; border-top: 1px solid var(--color-border); margin: 1rem 0; }
  .rte-preview img { max-width: 100%; height: auto; border-radius: 6px; margin: 0.5rem 0; }
</style>

<script is:inline>
  (function() {
    function initRichTextEditor() {
      // Tab + toolbar handlers
      document.querySelectorAll('.rte-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var action = btn.dataset.action;
          var targetId = btn.dataset.target;
          var textarea = document.getElementById(targetId);
          if (!textarea) return;

          if (action === 'fullscreen') {
            var wrapper = textarea.closest('.rte-wrapper');
            wrapper.classList.toggle('rte-fullscreen');
            return;
          }

          if (action === 'preview') return; // handled by tab

          var start = textarea.selectionStart;
          var end = textarea.selectionEnd;
          var selected = textarea.value.substring(start, end);
          var before = textarea.value.substring(0, start);
          var after = textarea.value.substring(end);
          var newText = '';
          var cursorOffset = 0;

          switch (action) {
            case 'heading':
              newText = '## ' + (selected || 'Heading');
              cursorOffset = selected ? newText.length : 2;
              break;
            case 'heading2':
              newText = '### ' + (selected || 'Heading');
              cursorOffset = selected ? newText.length : 3;
              break;
            case 'bold':
              newText = '**' + (selected || 'bold text') + '**';
              cursorOffset = selected ? newText.length : 2;
              break;
            case 'italic':
              newText = '*' + (selected || 'italic text') + '*';
              cursorOffset = selected ? newText.length : 1;
              break;
            case 'strikethrough':
              newText = '~~' + (selected || 'strikethrough') + '~~';
              cursorOffset = selected ? newText.length : 2;
              break;
            case 'ul':
              newText = '- ' + (selected || 'List item');
              cursorOffset = newText.length;
              break;
            case 'ol':
              newText = '1. ' + (selected || 'List item');
              cursorOffset = newText.length;
              break;
            case 'quote':
              newText = '> ' + (selected || 'Quote');
              cursorOffset = newText.length;
              break;
            case 'link':
              var url = window.prompt('Enter URL:', 'https://');
              if (!url) return;
              newText = '[' + (selected || 'link text') + '](' + url + ')';
              cursorOffset = newText.length;
              break;
            case 'image':
              var imgUrl = window.prompt('Enter image URL:', 'https://');
              if (!imgUrl) return;
              var alt = window.prompt('Enter alt text:', selected || 'image') || 'image';
              newText = '![' + alt + '](' + imgUrl + ')';
              cursorOffset = newText.length;
              break;
            case 'code':
              if (selected) {
                newText = '```\n' + selected + '\n```';
              } else {
                newText = '```\ncode block\n```';
                cursorOffset = 7;
              }
              break;
            case 'hr':
              newText = '\n---\n';
              cursorOffset = newText.length;
              break;
          }

          textarea.value = before + newText + after;
          textarea.focus();
          if (selected || cursorOffset === newText.length) {
            textarea.selectionStart = start;
            textarea.selectionEnd = start + newText.length;
          } else {
            textarea.selectionStart = textarea.selectionEnd = start + cursorOffset;
          }
          textarea.dispatchEvent(new Event('input', { bubbles: true }));
        });
      });

      // Write/Preview tabs
      document.querySelectorAll('.rte-tab').forEach(function(tab) {
        tab.addEventListener('click', function() {
          var targetId = tab.dataset.target;
          var textarea = document.getElementById(targetId);
          var preview = document.getElementById(targetId + '-preview');
          if (!textarea || !preview) return;

          var isWrite = tab.classList.contains('rte-tab-write');
          var wrapper = textarea.closest('.rte-wrapper');
          var writeTab = wrapper.querySelector('.rte-tab-write');
          var previewTab = wrapper.querySelector('.rte-tab-preview');

          if (isWrite) {
            textarea.classList.remove('hidden');
            preview.classList.add('hidden');
            writeTab.style.background = 'var(--color-primary)';
            writeTab.style.color = 'white';
            previewTab.style.background = 'var(--color-surface)';
            previewTab.style.color = 'var(--color-muted)';
          } else {
            // Render preview
            var md = textarea.value;
            fetch('/api/render-markdown', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ markdown: md })
            }).then(function(r) { return r.json(); }).then(function(data) {
              preview.innerHTML = data.html || '<p style="color: var(--color-muted);">Nothing to preview</p>';
            }).catch(function() {
              preview.innerHTML = '<p style="color: var(--color-muted);">Preview unavailable</p>';
            });
            textarea.classList.add('hidden');
            preview.classList.remove('hidden');
            writeTab.style.background = 'var(--color-surface)';
            writeTab.style.color = 'var(--color-muted)';
            previewTab.style.background = 'var(--color-primary)';
            previewTab.style.color = 'white';
          }
        });
      });

      // Keyboard shortcuts
      document.querySelectorAll('.rte-textarea').forEach(function(textarea) {
        textarea.addEventListener('keydown', function(e) {
          if ((e.ctrlKey || e.metaKey) && !e.altKey) {
            var action = null;
            if (e.key === 'b') action = 'bold';
            else if (e.key === 'i') action = 'italic';
            else if (e.key === 'k') action = 'link';
            else if (e.key === 'h') action = 'heading';
            if (action) {
              e.preventDefault();
              var btn = textarea.closest('.rte-wrapper').querySelector('[data-action="' + action + '"]');
              if (btn) btn.click();
            }
          }
          // Tab key inserts spaces
          if (e.key === 'Tab') {
            e.preventDefault();
            var start = textarea.selectionStart;
            var end = textarea.selectionEnd;
            textarea.value = textarea.value.substring(0, start) + '  ' + textarea.value.substring(end);
            textarea.selectionStart = textarea.selectionEnd = start + 2;
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRichTextEditor);
    } else {
      initRichTextEditor();
    }
  })();
</script>
