---
// BismiLLAH Ar-Rahman Ar-Raheem.
// PageLoader — BirrPay-style global preloader for Minhaajulhudaa (bar + splash).
// Paints before bundled CSS; bar eases to 72%, completes on window load;
// splash hides on load with failsafes (2.5s / 8s); internal link clicks and
// form submits restart the bar; bfcache restores finish instantly; honors
// prefers-reduced-motion. Mount immediately after the opening <body> tag.
---
<div id="mh-bar" aria-hidden="true"><i></i></div>
<div id="mh-splash" aria-hidden="true">
  <svg class="mh-mark" width="52" height="52" viewBox="0 0 32 32" fill="none">
    <defs><linearGradient id="mh-g" x1="4" y1="2" x2="28" y2="30" gradientUnits="userSpaceOnUse">
      <stop stop-color="#05B34D"></stop><stop offset="1" stop-color="#F2B91C"></stop>
    </linearGradient></defs>
    <rect x="1.5" y="1.5" width="29" height="29" rx="9" stroke="url(#mh-g)" stroke-width="2.5"></rect>
    <path d="M22.5 12.5a6.5 6.5 0 1 0 0 7" stroke="url(#mh-g)" stroke-width="2.4" stroke-linecap="round"></path>
  </svg>
</div>
<style>
  #mh-bar { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 2147483646; pointer-events: none; opacity: 1; transition: opacity 0.35s ease 0.15s; }
  #mh-bar i { display: block; height: 100%; width: 0%; border-radius: 0 999px 999px 0; background: linear-gradient(90deg, #05B34D, #F2B91C); box-shadow: 0 0 10px rgba(5, 179, 77, 0.55); transition: width 0.2s ease-out; }
  #mh-bar.mh-done i { width: 100% !important; }
  #mh-bar.mh-off { opacity: 0; }
  #mh-splash { position: fixed; inset: 0; z-index: 2147483647; display: grid; place-items: center; background: #ffffff; transition: opacity 0.3s ease; }
  :global(html.dark) #mh-splash { background: #181F25; }
  #mh-splash.mh-hide { opacity: 0; pointer-events: none; }
  #mh-splash .mh-mark { animation: mh-pulse 1.15s ease-in-out infinite; }
  @keyframes mh-pulse { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(0.88); opacity: 0.65; } }
  @media (prefers-reduced-motion: reduce) { #mh-splash .mh-mark { animation: none; } }
</style>
<script is:inline>
  (function () {
    var bar = document.getElementById('mh-bar');
    var fill = bar ? bar.firstElementChild : null;
    var splash = document.getElementById('mh-splash');
    var p = 0, target = 0.72, done = false, rafId = 0, submitAt = 0;
    function paint() { if (fill) fill.style.width = (p * 100).toFixed(2) + '%'; }
    function tick() { p += (target - p) * 0.11; paint(); rafId = requestAnimationFrame(tick); }
    function completeBar() { if (done) return; done = true; cancelAnimationFrame(rafId); p = 1; target = 1; paint(); if (bar) { bar.classList.add('mh-done'); setTimeout(function () { bar.classList.add('mh-off'); }, 550); } }
    function hideSplash() { if (!splash) return; splash.classList.add('mh-hide'); setTimeout(function () { if (splash && splash.parentNode) splash.parentNode.removeChild(splash); }, 400); }
    function startForNavigation() { submitAt = Date.now(); if (!done) return; done = false; p = 0.04; target = 0.72; if (bar) bar.classList.remove('mh-off', 'mh-done'); cancelAnimationFrame(rafId); rafId = requestAnimationFrame(tick); }
    if (fill) { paint(); rafId = requestAnimationFrame(tick); }
    if (document.readyState === 'complete') { setTimeout(function () { completeBar(); hideSplash(); }, 120); }
    else {
      window.addEventListener('load', function () { completeBar(); hideSplash(); });
      setTimeout(hideSplash, 2500); setTimeout(completeBar, 8000);
    }
    window.addEventListener('pageshow', function (e) { if (e.persisted) { completeBar(); hideSplash(); } });
    document.addEventListener('click', function (e) {
      if (e.defaultPrevented || e.button !== 0) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      var a = e.target && e.target.closest ? e.target.closest('a') : null;
      if (!a) return;
      var href = a.getAttribute('href') || '';
      if (!href || href.charAt(0) === '#' || a.hasAttribute('download')) return;
      if (a.target && a.target !== '_self') return;
      if (a.origin && a.origin !== location.origin) return;
      if (/^(mailto|tel|javascript|blob|data):/i.test(href)) return;
      startForNavigation();
    }, true);
    document.addEventListener('submit', function () { startForNavigation(); setTimeout(function () { if (!done && submitAt && Date.now() - submitAt > 3500) completeBar(); }, 3600); }, true);
  })();
</script>
