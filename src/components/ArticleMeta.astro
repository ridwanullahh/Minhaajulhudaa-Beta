---
/**
 * ArticleMeta Component
 *
 * Displays engagement metadata for single-post pages:
 * - Reading time calculation
 * - Share buttons (Web Share API + clipboard fallback + social links)
 * - Table of contents (from markdown headings)
 * - Author info
 * - Published/updated dates
 *
 * Usage:
 * <ArticleMeta
 *   title={post.title}
 *   content={post.content}
 *   authorName={post.authorName}
 *   publishedAt={post.publishedAt}
 *   updatedAt={post.updatedAt}
 *   category={post.category}
 *   tags={post.tags}
 * />
 */

import { calculateReadingTime, extractHeadings } from '../lib/markdown';
import { formatDate } from '../lib/utils';

interface Props {
  title: string;
  content?: string;
  authorName?: string;
  authorEmail?: string;
  publishedAt?: string;
  updatedAt?: string;
  category?: string;
  tags?: string[];
  showTOC?: boolean;
}

const {
  title,
  content = '',
  authorName,
  authorEmail,
  publishedAt,
  updatedAt,
  category,
  tags = [],
  showTOC = true,
} = Astro.props;

const readingTime = calculateReadingTime(content);
const headings = showTOC ? extractHeadings(content) : [];
const hasTOC = headings.filter(h => h.level <= 3).length >= 2;
---

<div class="article-meta">
  <!-- Meta Bar -->
  <div class="flex flex-wrap items-center gap-4 mb-6 pb-6" style="border-bottom: 1px solid var(--color-border);">
    {authorName && (
      <div class="flex items-center gap-2">
        <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold" style="background: rgb(5,179,77,0.1); color: var(--color-primary);">
          {authorName.charAt(0)}
        </div>
        <div>
          <div class="text-sm font-semibold">{authorName}</div>
          {authorEmail && <div class="text-xs" style="color: var(--color-muted);">{authorEmail}</div>}
        </div>
      </div>
    )}

    {publishedAt && (
      <div class="flex items-center gap-1.5 text-sm" style="color: var(--color-muted);">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <span>{formatDate(publishedAt, 'long')}</span>
      </div>
    )}

    <div class="flex items-center gap-1.5 text-sm" style="color: var(--color-muted);">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>{readingTime} min read</span>
    </div>

    <!-- Share Buttons -->
    <div class="flex items-center gap-1 ml-auto">
      <span class="text-xs mr-1" style="color: var(--color-muted);">Share:</span>
      <button class="share-btn" data-share="web" data-title={title} aria-label="Share via Web Share API">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
      </button>
      <button class="share-btn" data-share="copy" aria-label="Copy link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      </button>
      <a class="share-btn" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a class="share-btn" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </a>
      <a class="share-btn" href={`https://wa.me/?text=${encodeURIComponent(title + ' ' + Astro.url.href)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.149-.197.297-.767.967-.94 1.165-.173.198-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.359.104 11.94c0 2.105.55 4.161 1.595 5.984L0 24l6.265-1.647a11.95 11.95 0 005.78 1.474h.005c6.582 0 11.94-5.359 11.94-11.94 0-3.192-1.241-6.193-3.495-8.449"/></svg>
      </a>
    </div>
  </div>

  <!-- Category and Tags -->
  {(category || tags.length > 0) && (
    <div class="flex flex-wrap items-center gap-2 mb-6">
      {category && <span class="badge badge-primary">{category}</span>}
      {tags.map((tag) => <span class="badge">#{tag}</span>)}
    </div>
  )}

  <!-- Table of Contents -->
  {hasTOC && (
    <details class="mb-6 rounded-lg overflow-hidden" style="border: 1px solid var(--color-border);">
      <summary class="px-4 py-3 cursor-pointer text-sm font-medium flex items-center gap-2" style="background: var(--color-surface);">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        Table of Contents
      </summary>
      <div class="px-4 py-3">
        <nav class="toc-nav text-sm space-y-1">
          {headings.filter(h => h.level <= 3).map((h) => (
            <a href={`#${h.id}`} class="block hover:text-primary transition-colors" style={`padding-left: ${(h.level - 1) * 1}rem; color: var(--color-muted);`}>
              {h.text}
            </a>
          ))}
        </nav>
      </div>
    </details>
  )}

  {updatedAt && updatedAt !== publishedAt && (
    <div class="text-xs mb-4" style="color: var(--color-muted);">
      <em>Last updated: {formatDate(updatedAt, 'long')}</em>
    </div>
  )}
</div>

<style>
  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    color: var(--color-muted);
    cursor: pointer;
    transition: all 0.15s;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .share-btn:hover {
    background: rgb(5 179 77 / 0.1);
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
  .toc-nav a:hover {
    color: var(--color-primary) !important;
  }
</style>

<script is:inline>
  (function() {
    function initShareButtons() {
      document.querySelectorAll('.share-btn[data-share]').forEach(function(btn) {
        btn.addEventListener('click', async function() {
          var type = btn.dataset.share;
          var url = window.location.href;
          var title = btn.dataset.title || document.title;

          if (type === 'web' && navigator.share) {
            try {
              await navigator.share({ title: title, url: url });
            } catch {}
          } else if (type === 'copy' || (type === 'web' && !navigator.share)) {
            try {
              await navigator.clipboard.writeText(url);
              var original = btn.innerHTML;
              btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>';
              btn.style.color = 'var(--color-primary)';
              setTimeout(function() {
                btn.innerHTML = original;
                btn.style.color = '';
              }, 2000);
            } catch {}
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initShareButtons);
    } else {
      initShareButtons();
    }
  })();
</script>
