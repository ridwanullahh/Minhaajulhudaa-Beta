---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';

const result = await lightbase.query('masjid_audios', {
  filter: { field: 'status', op: 'eq', value: 'active' },
  sort: 'date:desc',
  limit: 50,
});
const audios = result.data || [];
const speakers = [...new Set(audios.map(a => a.speaker).filter(Boolean))];
const categories = [...new Set(audios.map(a => a.category).filter(Boolean))];
---

<PlatformLayout title="Audio Library - Minhaajulhudaa Masjid" platform="masjid">
  <section class="container-app py-12">
    <h1 class="text-3xl md:text-4xl font-extrabold mb-4">Audio Library</h1>
    <p style="color: var(--color-muted);" class="mb-8">Listen to lectures, khutbahs, and Qur'an recitations from our masjid.</p>

    <!-- Filters -->
    <div class="card p-4 mb-6">
      <div class="grid md:grid-cols-3 gap-4">
        <input type="text" id="search-input" placeholder="Search audios..." class="input" />
        <select id="speaker-filter" class="input">
          <option value="">All Speakers</option>
          {speakers.map(s => <option value={s}>{s}</option>)}
        </select>
        <select id="category-filter" class="input">
          <option value="">All Categories</option>
          {categories.map(c => <option value={c}>{c.charAt(0).toUpperCase() + c.slice(1)}</option>)}
        </select>
      </div>
    </div>

    <!-- Audio List -->
    <div id="audio-list" class="space-y-3">
      {audios.map((audio) => (
        <div class="card p-4 flex items-center gap-4 audio-item"
          data-speaker={audio.speaker}
          data-category={audio.category}
          data-title={audio.title.toLowerCase()}
        >
          <button class="play-audio-btn w-12 h-12 rounded-full flex items-center justify-center shrink-0" style="background: var(--color-primary);" data-audio-url={audio.audioUrl} data-audio-title={audio.title}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="white" class="play-icon"><path d="M8 5v14l11-7z"/></svg>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="white" class="pause-icon" style="display:none;"><path d="M6 4h4v16H6zM14 4h4v16h-4z"/></svg>
          </button>
          <div class="flex-1 min-w-0">
            <h3 class="font-semibold text-sm truncate">{audio.title}</h3>
            <p class="text-xs" style="color: var(--color-muted);">{audio.speaker} - {audio.category}</p>
          </div>
          <div class="text-xs text-right" style="color: var(--color-muted);">
            <div>{Math.floor(audio.duration / 60)}:{String(audio.duration % 60).padStart(2, '0')}</div>
            <div>{audio.plays} plays</div>
          </div>
        </div>
      ))}
    </div>

    {audios.length === 0 && (
      <div class="card p-12 text-center">
        <p style="color: var(--color-muted);">No audios available yet.</p>
      </div>
    )}
  </section>

  <!-- Floating Mini Player -->
  <div id="mini-player" class="fixed bottom-16 lg:bottom-4 left-4 right-4 lg:left-auto lg:right-4 lg:w-96 card p-4 hidden" style="z-index: 100;">
    <div class="flex items-center gap-3">
      <button id="mini-play-btn" class="w-10 h-10 rounded-full flex items-center justify-center shrink-0" style="background: var(--color-primary);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="white" id="mini-play-icon"><path d="M8 5v14l11-7z"/></svg>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="white" id="mini-pause-icon" style="display:none;"><path d="M6 4h4v16H6zM14 4h4v16h-4z"/></svg>
      </button>
      <div class="flex-1 min-w-0">
        <div id="mini-title" class="font-semibold text-sm truncate">Not playing</div>
        <div class="h-1 rounded-full mt-1" style="background: var(--color-border);">
          <div id="mini-progress" class="h-full rounded-full" style="width: 0%; background: var(--color-primary);"></div>
        </div>
      </div>
      <button id="mini-close" class="w-8 h-8 rounded-lg flex items-center justify-center" style="color: var(--color-muted);">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
  </div>

  <audio id="audio-element" preload="metadata"></audio>

  <script is:inline>
    const audio = document.getElementById('audio-element');
    const miniPlayer = document.getElementById('mini-player');
    const miniPlayBtn = document.getElementById('mini-play-btn');
    const miniPlayIcon = document.getElementById('mini-play-icon');
    const miniPauseIcon = document.getElementById('mini-pause-icon');
    const miniTitle = document.getElementById('mini-title');
    const miniProgress = document.getElementById('mini-progress');
    const miniClose = document.getElementById('mini-close');

    let currentBtn = null;

    function updateIcons(isPlaying) {
      if (isPlaying) {
        miniPlayIcon.style.display = 'none';
        miniPauseIcon.style.display = 'block';
        if (currentBtn) {
          currentBtn.querySelector('.play-icon').style.display = 'none';
          currentBtn.querySelector('.pause-icon').style.display = 'block';
        }
      } else {
        miniPlayIcon.style.display = 'block';
        miniPauseIcon.style.display = 'none';
        if (currentBtn) {
          currentBtn.querySelector('.play-icon').style.display = 'block';
          currentBtn.querySelector('.pause-icon').style.display = 'none';
        }
      }
    }

    document.querySelectorAll('.play-audio-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const url = btn.dataset.audioUrl;
        const title = btn.dataset.audioTitle;

        if (currentBtn === btn && !audio.paused) {
          audio.pause();
          updateIcons(false);
          return;
        }

        if (currentBtn && currentBtn !== btn) {
          currentBtn.querySelector('.play-icon').style.display = 'block';
          currentBtn.querySelector('.pause-icon').style.display = 'none';
        }

        currentBtn = btn;
        audio.src = url;
        miniTitle.textContent = title;
        miniPlayer.classList.remove('hidden');
        audio.play();
        updateIcons(true);
      });
    });

    miniPlayBtn.addEventListener('click', () => {
      if (audio.paused) {
        audio.play();
        updateIcons(true);
      } else {
        audio.pause();
        updateIcons(false);
      }
    });

    miniClose.addEventListener('click', () => {
      audio.pause();
      audio.src = '';
      miniPlayer.classList.add('hidden');
      updateIcons(false);
      currentBtn = null;
    });

    audio.addEventListener('timeupdate', () => {
      const percent = (audio.currentTime / audio.duration) * 100;
      miniProgress.style.width = percent + '%';
    });

    audio.addEventListener('ended', () => {
      updateIcons(false);
      miniProgress.style.width = '0%';
    });

    // Filters
    const searchInput = document.getElementById('search-input');
    const speakerFilter = document.getElementById('speaker-filter');
    const categoryFilter = document.getElementById('category-filter');

    function filterAudios() {
      const search = searchInput.value.toLowerCase();
      const speaker = speakerFilter.value;
      const category = categoryFilter.value;

      document.querySelectorAll('.audio-item').forEach(item => {
        const matchSearch = !search || item.dataset.title.includes(search);
        const matchSpeaker = !speaker || item.dataset.speaker === speaker;
        const matchCategory = !category || item.dataset.category === category;
        item.style.display = (matchSearch && matchSpeaker && matchCategory) ? '' : 'none';
      });
    }

    searchInput.addEventListener('input', filterAudios);
    speakerFilter.addEventListener('change', filterAudios);
    categoryFilter.addEventListener('change', filterAudios);
  </script>
</PlatformLayout>
