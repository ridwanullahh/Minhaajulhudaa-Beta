---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';
import { sanitizeHtml } from '../../../lib/sanitize';
import { renderMarkdown } from '../../../lib/markdown';

const { slug } = Astro.params;

let audio: any = null;
try {
  audio = await lightbase.findOne('masjid_audios', { field: 'slug', op: 'eq', value: slug });
} catch (err) {
  console.error('[masjid/audios/[slug]] fetch error:', err);
}

if (!audio) {
  Astro.response.status = 404;
  return Astro.redirect('/404');
}

let relatedAudios: any[] = [];
try {
  const result = await lightbase.query('masjid_audios', {
    filter: { and: [
      { field: 'category', op: 'eq', value: audio.category || '' },
      { field: 'slug', op: 'neq', value: audio.slug },
    ]},
    limit: 4,
  });
  relatedAudios = (result.data || []).slice(0, 3);
} catch {}
---

<PlatformLayout title={`${audio.title} - Audios`} platform="masjid">
  <section class="container-app py-8 md:py-12 max-w-4xl">
    <a href="/masjid/audios" class="inline-flex items-center gap-2 text-sm font-medium mb-6" style="color: var(--color-primary);">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Back to Audios
    </a>

    <div class="grid md:grid-cols-3 gap-8 fade-in">
      <div class="md:col-span-2">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          {audio.category && <span class="badge badge-primary">{audio.category}</span>}
          {audio.type && <span class="badge badge-accent capitalize">{audio.type}</span>}
        </div>
        <h1 class="text-2xl md:text-3xl font-extrabold mb-3">{audio.title}</h1>

        {audio.speaker && (
          <div class="flex items-center gap-2 mb-6 text-sm" style="color: var(--color-muted);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span class="font-medium" style="color: var(--color-foreground);">{audio.speaker}</span>
          </div>
        )}

        <!-- Audio Player -->
        {audio.audioUrl && (
          <div class="card p-6 mb-6">
            <audio controls class="w-full" preload="metadata">
              <source src={audio.audioUrl} type="audio/mpeg" />
              Your browser does not support the audio element.
            </audio>
            <div class="flex items-center gap-3 mt-4">
              <a href={audio.audioUrl} download class="btn btn-outline text-sm inline-flex items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Download
              </a>
              <button id="share-btn" class="btn btn-ghost text-sm inline-flex items-center gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                Share
              </button>
            </div>
          </div>
        )}

        <!-- Description -->
        {audio.description && (
          <div class="card p-6 mb-6">
            <h2 class="font-bold mb-3">Description</h2>
            <div class="text-sm leading-relaxed article-content" set:html={renderMarkdown(audio.description || '')} />
          </div>
        )}

        <!-- Transcript (if available) -->
        {audio.transcript && (
          <div class="card p-6">
            <h2 class="font-bold mb-3">Transcript</h2>
            <div class="text-sm leading-relaxed article-content" set:html={renderMarkdown(audio.transcript)} />
            </div>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <div class="md:col-span-1">
        <div class="card p-6 sticky top-20">
          <h3 class="font-bold mb-4">Details</h3>
          <dl class="space-y-3 text-sm">
            {audio.duration && (
              <div class="flex justify-between">
                <dt style="color: var(--color-muted);">Duration</dt>
                <dd class="font-medium">{audio.duration}</dd>
              </div>
            )}
            {audio.category && (
              <div class="flex justify-between">
                <dt style="color: var(--color-muted);">Category</dt>
                <dd class="font-medium capitalize">{audio.category}</dd>
              </div>
            )}
            {audio.type && (
              <div class="flex justify-between">
                <dt style="color: var(--color-muted);">Type</dt>
                <dd class="font-medium capitalize">{audio.type}</dd>
              </div>
            )}
            {audio.publishedAt && (
              <div class="flex justify-between">
                <dt style="color: var(--color-muted);">Published</dt>
                <dd class="font-medium">{new Date(audio.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</dd>
              </div>
            )}
          </dl>
        </div>
      </div>
    </div>

    <!-- Related Audios -->
    {relatedAudios.length > 0 && (
      <div class="mt-12 pt-8" style="border-top: 1px solid var(--color-border);">
        <h2 class="text-xl font-bold mb-6">Related Audios</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {relatedAudios.map((ra: any) => (
            <a href={`/masjid/audios/${ra.slug}`} class="card card-hover p-4 block">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0" style="background: rgb(5,179,77,0.1);">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="font-bold text-sm truncate">{ra.title}</h3>
                  {ra.speaker && <p class="text-xs" style="color: var(--color-muted);">{ra.speaker}</p>}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>

  <script is:inline>
    document.getElementById('share-btn')?.addEventListener('click', async function() {
      const url = window.location.href;
      if (navigator.share) {
        try { await navigator.share({ url }); } catch {}
      } else if (navigator.clipboard) {
        try {
          await navigator.clipboard.writeText(url);
          const btn = document.getElementById('share-btn');
          const original = btn.innerHTML;
          btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Copied!';
          setTimeout(() => { btn.innerHTML = original; }, 2000);
        } catch {}
      }
    });
  </script>
</PlatformLayout>
