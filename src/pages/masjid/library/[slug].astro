---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';
import { renderMarkdown } from '../../../lib/markdown';

const { slug } = Astro.params;

let book: any = null;
try {
  book = await lightbase.findOne('masjid_books', { field: 'slug', op: 'eq', value: slug });
} catch (err) {
  console.error('[masjid/library/[slug].astro] fetch error:', err);
}

if (!book) {
  Astro.response.status = 404;
  return Astro.redirect('/404');
}
---

<PlatformLayout title={`${book.title} - Digital Library`} platform="masjid">
  <div class="container-app py-8 md:py-12">
    <a href="/masjid/library" class="inline-flex items-center gap-2 text-sm font-medium mb-6" style="color: var(--color-primary);">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Back to Library
    </a>

    <div class="grid md:grid-cols-3 gap-8 fade-in">
      <!-- Cover -->
      <div>
        <div class="aspect-[3/4] rounded-xl overflow-hidden card" style="border: none;">
          {book.coverUrl ? (
            <img src={book.coverUrl} alt={book.title} class="w-full h-full object-cover" />
          ) : (
            <div class="w-full h-full flex flex-col items-center justify-center gap-2" style="background: var(--color-border);">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--color-muted); opacity: 0.4;"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            </div>
          )}
        </div>
        {book.pdfUrl && (
          <a href={book.pdfUrl} target="_blank" class="btn btn-primary w-full mt-4">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download PDF
          </a>
        )}
      </div>

      <!-- Details -->
      <div class="md:col-span-2">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          {book.category && <span class="badge badge-primary">{book.category}</span>}
          {book.format && <span class="badge badge-accent">{book.format}</span>}
        </div>
        <h1 class="text-2xl md:text-3xl font-extrabold mb-2">{book.title}</h1>
        {book.author && (
          <p class="text-lg mb-6" style="color: var(--color-muted);">by <span class="font-medium" style="color: var(--color-foreground);">{book.author}</span></p>
        )}

        <div class="card p-6 mb-6">
          <h2 class="font-bold mb-3">Description</h2>
          <div class="text-sm leading-relaxed article-content" set:html={renderMarkdown(book.description || 'No description available.')} />
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {book.pages && (
            <div class="card p-4 text-center">
              <div class="text-2xl font-extrabold" style="color: var(--color-primary);">{book.pages}</div>
              <div class="text-xs" style="color: var(--color-muted);">Pages</div>
            </div>
          )}
          {book.language && (
            <div class="card p-4 text-center">
              <div class="text-lg font-bold" style="color: var(--color-primary);">{book.language}</div>
              <div class="text-xs" style="color: var(--color-muted);">Language</div>
            </div>
          )}
          {book.publisher && (
            <div class="card p-4 text-center">
              <div class="text-sm font-bold" style="color: var(--color-primary);">{book.publisher}</div>
              <div class="text-xs" style="color: var(--color-muted);">Publisher</div>
            </div>
          )}
          {book.year && (
            <div class="card p-4 text-center">
              <div class="text-lg font-bold" style="color: var(--color-primary);">{book.year}</div>
              <div class="text-xs" style="color: var(--color-muted);">Year</div>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</PlatformLayout>
