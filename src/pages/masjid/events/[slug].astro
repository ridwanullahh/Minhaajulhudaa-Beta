---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';
import { renderMarkdown } from '../../../lib/markdown';

const { slug } = Astro.params;

let event: any = null;
try {
  event = await lightbase.findOne('masjid_events', { field: 'slug', op: 'eq', value: slug });
} catch (err) {
  console.error('[masjid/events/[slug].astro] fetch error:', err);
}

if (!event) {
  Astro.response.status = 404;
  return Astro.redirect('/404');
}
---

<PlatformLayout title={`${event.title} - Events`} platform="masjid">
  <div class="container-app py-8 md:py-12">
    <a href="/masjid/events" class="inline-flex items-center gap-2 text-sm font-medium mb-6" style="color: var(--color-primary);">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Back to Events
    </a>

    <div class="grid md:grid-cols-3 gap-8 fade-in">
      <div class="md:col-span-2">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="badge badge-primary">{event.category}</span>
          {event.isRecurring && <span class="badge badge-accent">Recurring</span>}
        </div>
        <h1 class="text-2xl md:text-3xl font-extrabold mb-4">{event.title}</h1>
        <div class="prose max-w-none article-content" set:html={renderMarkdown(event.description || 'No description provided.')} />
      </div>

      <div class="space-y-4">
        <div class="card p-6">
          <h3 class="font-bold mb-4">Event Details</h3>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5" style="color: var(--color-primary);"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <div>
                <div class="text-sm font-medium">{new Date(event.startDate).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}</div>
                <div class="text-sm" style="color: var(--color-muted);">{new Date(event.startDate).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })}</div>
                {event.endDate && <div class="text-xs" style="color: var(--color-muted);">Ends: {new Date(event.endDate).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })}</div>}
              </div>
            </div>
            {event.location && (
              <div class="flex items-start gap-3">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5" style="color: var(--color-primary);"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <div class="text-sm">{event.location}</div>
              </div>
            )}
            {event.speaker && (
              <div class="flex items-start gap-3">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5" style="color: var(--color-primary);"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <div class="text-sm">{event.speaker}</div>
              </div>
            )}
            {event.schedule && (
              <div class="flex items-start gap-3">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5" style="color: var(--color-primary);"><path d="M12 8v4l3 3"/></svg>
                <div class="text-sm">{event.schedule}</div>
              </div>
            )}
          </div>
        </div>

        {event.resources && event.resources.length > 0 && (
          <div class="card p-6">
            <h3 class="font-bold mb-3">Resources</h3>
            <div class="space-y-2">
              {event.resources.map((r: any) => (
                <a href={r.url} target="_blank" class="flex items-center gap-2 text-sm" style="color: var(--color-primary);">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  {r.title || r.url}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</PlatformLayout>