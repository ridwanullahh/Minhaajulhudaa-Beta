---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';

export const prerender = true;

let events: any[] = [];
try {
  const result = await lightbase.query('masjid_events', {
    sort: 'startDate:asc',
    limit: 100,
  });
  events = result.data || [];
} catch {}

const now = new Date().toISOString();
const upcoming = events.filter(e => e.startDate >= now);
const past = events.filter(e => e.startDate < now).reverse();

const categoryColors: Record<string, string> = {
  khutbah: 'badge-primary',
  halaqah: 'badge-accent',
  special: 'badge-accent',
  youth: 'badge-primary',
  educational: 'badge-primary',
  community: 'badge-accent',
};

function getMonthDays(year: number, month: number) {
  const firstDay = new Date(year, month, 1).getDay();
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  return { firstDay, daysInMonth };
}

const today = new Date();
const currentMonth = today.getMonth();
const currentYear = today.getFullYear();
const { firstDay, daysInMonth } = getMonthDays(currentYear, currentMonth);
const monthName = today.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

const eventDates = new Map<string, any[]>();
upcoming.forEach(e => {
  const d = new Date(e.startDate).toDateString();
  if (!eventDates.has(d)) eventDates.set(d, []);
  eventDates.get(d)!.push(e);
});
---

<PlatformLayout title="Events - Minhaajulhudaa Masjid" platform="masjid">
  <!-- Hero -->
  <section class="relative overflow-hidden" style="background: linear-gradient(135deg, rgb(5,179,77,0.08), rgb(242,185,28,0.05));">
    <div class="container-app py-12 md:py-16 text-center fade-in">
      <span class="badge badge-primary mb-4">Events</span>
      <h1 class="text-3xl md:text-5xl font-extrabold mb-4">
        Events <span style="color: var(--color-primary);">Calendar</span>
      </h1>
      <p class="text-lg max-w-2xl mx-auto" style="color: var(--color-muted);">
        Stay updated with our upcoming khutbahs, halaqahs, special programs, and community events.
      </p>
    </div>
  </section>

  <section class="container-app py-8 md:py-12">
    <!-- Mini Calendar -->
    <div class="card p-6 mb-8 fade-in">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-lg">{monthName}</h2>
        <div class="flex gap-2">
          <span class="badge badge-primary">{upcoming.length} upcoming</span>
        </div>
      </div>
      <div class="grid grid-cols-7 gap-1 text-center text-xs">
        {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map(d => (
          <div class="py-2 font-semibold" style="color: var(--color-muted);">{d}</div>
        ))}
        {Array.from({ length: firstDay }).map(() => <div class="py-2"></div>)}
        {Array.from({ length: daysInMonth }).map((_, i) => {
          const dayNum = i + 1;
          const dateStr = new Date(currentYear, currentMonth, dayNum).toDateString();
          const hasEvents = eventDates.has(dateStr);
          const isToday = dayNum === today.getDate();
          return (
            <div class:list={['py-2 rounded-lg text-sm', isToday ? 'font-bold' : '', hasEvents ? 'cursor-pointer' : '']}
              style={isToday ? 'background: var(--color-primary); color: white; border-radius: 0.5rem;' : hasEvents ? 'background: rgb(5,179,77,0.1); color: var(--color-primary); font-weight: 600;' : 'color: var(--color-muted);'}
            >
              {dayNum}
            </div>
          );
        })}
      </div>
    </div>

    <!-- Upcoming Events -->
    {upcoming.length > 0 ? (
      <>
        <h2 class="text-xl font-bold mb-4">Upcoming Events</h2>
        <div class="space-y-4 mb-12">
          {upcoming.map((event) => (
            <a href={event.slug ? `/masjid/events/${event.slug}` : '#'} class="card card-hover p-5 flex items-center gap-4 block">
              <div class="text-center shrink-0 w-14">
                <div class="text-2xl font-extrabold" style="color: var(--color-primary);">{new Date(event.startDate).getDate()}</div>
                <div class="text-xs uppercase" style="color: var(--color-muted);">{new Date(event.startDate).toLocaleDateString('en-US', { month: 'short' })}</div>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <h3 class="font-bold">{event.title}</h3>
                  <span class={categoryColors[event.category] || 'badge'}>{event.category}</span>
                </div>
                <div class="flex flex-wrap items-center gap-3 text-sm" style="color: var(--color-muted);">
                  <span class="flex items-center gap-1">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                    {new Date(event.startDate).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })}
                  </span>
                  {event.location && (
                    <span class="flex items-center gap-1">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                      {event.location}
                    </span>
                  )}
                  {event.speaker && <span>by {event.speaker}</span>}
                </div>
              </div>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-muted);" class="shrink-0"><path d="M9 18l6-6-6-6"/></svg>
            </a>
          ))}
        </div>
      </>
    ) : null}

    <!-- Past Events -->
    {past.length > 0 && (
      <>
        <h2 class="text-xl font-bold mb-4">Past Events</h2>
        <div class="space-y-3">
          {past.slice(0, 10).map((event) => (
            <div class="card p-4 flex items-center gap-4 opacity-70">
              <div class="text-center shrink-0 w-12">
                <div class="text-lg font-bold" style="color: var(--color-muted);">{new Date(event.startDate).getDate()}</div>
                <div class="text-xs" style="color: var(--color-muted);">{new Date(event.startDate).toLocaleDateString('en-US', { month: 'short' })}</div>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-sm truncate">{event.title}</h3>
                <p class="text-xs" style="color: var(--color-muted);">{event.category}</p>
              </div>
            </div>
          ))}
        </div>
      </>
    )}

    {events.length === 0 && (
      <div class="card p-12 text-center fade-in" style="color: var(--color-muted);">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto mb-4 opacity-40"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <p class="font-medium">No events scheduled at this time.</p>
        <p class="text-sm mt-1">Check back soon for upcoming programs.</p>
      </div>
    )}
  </section>
</PlatformLayout>
