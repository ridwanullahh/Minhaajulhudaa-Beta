---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';
import { renderMarkdown } from '../../../lib/markdown';
import ArticleMeta from '../../../components/ArticleMeta.astro';

const { slug } = Astro.params;

let post: any = null;
try {
  post = await lightbase.findOne('masjid_blog_posts', { field: 'slug', op: 'eq', value: slug });
} catch (err) {
  console.error('[masjid/blog/[slug]] fetch error:', err);
}

if (!post) {
  Astro.response.status = 404;
  return Astro.redirect('/404');
}

let relatedPosts: any[] = [];
try {
  const result = await lightbase.query('masjid_blog_posts', {
    filter: { field: 'category', op: 'eq', value: post.category },
    sort: 'publishedAt:desc',
    limit: 4,
  });
  relatedPosts = (result.data || []).filter((p: any) => p.id !== post.id).slice(0, 3);
} catch {}

const renderedContent = renderMarkdown(post.content || '');
---

<PlatformLayout title={`${post.title} - Blog`} description={post.excerpt || post.content?.substring(0, 160)} platform="masjid">
  <article class="container-app py-8 md:py-12 max-w-3xl mx-auto">
    <a href="/masjid/blog" class="inline-flex items-center gap-2 text-sm font-medium mb-6" style="color: var(--color-primary);">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Back to Blog
    </a>

    <h1 class="text-2xl md:text-4xl font-extrabold mb-4 leading-tight">{post.title}</h1>

    <ArticleMeta
      title={post.title}
      content={post.content}
      authorName={post.authorName}
      authorEmail={post.authorEmail}
      publishedAt={post.publishedAt}
      category={post.category}
      tags={post.tags}
    />

    {post.featuredImage && (
      <div class="rounded-xl overflow-hidden mb-8">
        <img src={post.featuredImage} alt={post.title} class="w-full object-cover" />
      </div>
    )}

    <div class="prose max-w-none article-content" set:html={renderedContent} />
  </article>

  {relatedPosts.length > 0 && (
    <section class="container-app py-12" style="border-top: 1px solid var(--color-border);">
      <h2 class="text-xl font-bold mb-6">Related Posts</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedPosts.map((rp: any) => (
          <a href={`/masjid/blog/${rp.slug}`} class="card card-hover p-5 block">
            <h3 class="font-bold text-sm mb-2 line-clamp-2">{rp.title}</h3>
            <p class="text-xs line-clamp-2" style="color: var(--color-muted);">{rp.excerpt || rp.content?.substring(0, 100)}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <style is:global>
    .article-content h1 { font-size: 2rem; font-weight: 700; margin: 1.5rem 0 1rem; }
    .article-content h2 { font-size: 1.5rem; font-weight: 700; margin: 1.5rem 0 0.75rem; }
    .article-content h3 { font-size: 1.25rem; font-weight: 600; margin: 1.25rem 0 0.5rem; }
    .article-content p { margin: 0.75rem 0; line-height: 1.8; color: var(--color-muted); }
    .article-content ul, .article-content ol { margin: 0.75rem 0; padding-left: 1.5rem; }
    .article-content ul { list-style: disc; }
    .article-content ol { list-style: decimal; }
    .article-content li { margin: 0.375rem 0; color: var(--color-muted); }
    .article-content blockquote { border-left: 3px solid var(--color-primary); padding-left: 1rem; margin: 1rem 0; color: var(--color-muted); font-style: italic; }
    .article-content code { background: var(--color-surface); padding: 0.125rem 0.375rem; border-radius: 3px; font-size: 0.875em; }
    .article-content pre { background: var(--color-surface); padding: 0.75rem; border-radius: 6px; overflow-x: auto; margin: 0.75rem 0; }
    .article-content pre code { background: none; padding: 0; }
    .article-content table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
    .article-content th, .article-content td { border: 1px solid var(--color-border); padding: 0.5rem; text-align: left; }
    .article-content th { background: var(--color-surface); font-weight: 600; }
    .article-content hr { border: none; border-top: 1px solid var(--color-border); margin: 1.5rem 0; }
    .article-content img { max-width: 100%; height: auto; border-radius: 6px; }
    .article-content a { color: var(--color-primary); text-decoration: underline; }
  </style>
</PlatformLayout>
