---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import { lightbase } from '../../lib/lightbase';

export const prerender = true;

let programs: any[] = [];
try {
  const result = await lightbase.query('masjid_events', {
    filter: { field: 'category', op: 'in', value: ['halaqah', 'educational', 'special', 'youth'] },
    sort: 'startDate:asc',
    limit: 100,
  });
  programs = result.data || [];
} catch {}

const categories = ['halaqah', 'educational', 'special', 'youth'];
const categoryLabels: Record<string, string> = {
  halaqah: 'Weekly Halaqah',
  educational: 'Educational Classes',
  special: 'Special Programs',
  youth: 'Youth Programs',
};

const categoryIcons: Record<string, string> = {
  halaqah: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>',
  educational: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>',
  special: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>',
  youth: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>',
};
---

<PlatformLayout title="Programs & Activities - Minhaajulhudaa Masjid" platform="masjid">
  <!-- Hero -->
  <section class="relative overflow-hidden" style="background: linear-gradient(135deg, rgb(5,179,77,0.08), rgb(242,185,28,0.05));">
    <div class="container-app py-12 md:py-16 text-center fade-in">
      <span class="badge badge-primary mb-4">Activities</span>
      <h1 class="text-3xl md:text-5xl font-extrabold mb-4">
        Programs & <span style="color: var(--color-primary);">Activities</span>
      </h1>
      <p class="text-lg max-w-2xl mx-auto" style="color: var(--color-muted);">
        Explore our weekly halaqahs, educational classes, special programs, and youth activities designed to nurture your faith and knowledge.
      </p>
    </div>
  </section>

  <!-- Programs by Category -->
  <section class="container-app py-8 md:py-12">
    {categories.map((cat) => {
      const items = programs.filter(p => p.category === cat);
      return (
        <div class="mb-12 fade-in">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgb(5,179,77,0.1); color: var(--color-primary);">
              <Fragment set:html={categoryIcons[cat]} />
            </div>
            <h2 class="text-xl md:text-2xl font-bold">{categoryLabels[cat]}</h2>
          </div>
          {items.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {items.map((program) => (
                <div class="card card-hover p-6">
                  <div class="flex items-start justify-between mb-3">
                    <span class="badge badge-accent">{program.subCategory || cat}</span>
                    {program.isRecurring && (
                      <span class="text-xs px-2 py-1 rounded" style="background: rgb(5,179,77,0.1); color: var(--color-primary);">Recurring</span>
                    )}
                  </div>
                  <h3 class="font-bold text-lg mb-2">{program.title}</h3>
                  <p class="text-sm mb-4 line-clamp-3" style="color: var(--color-muted);">{program.description}</p>
                  <div class="space-y-2 text-sm" style="color: var(--color-muted);">
                    {program.schedule && (
                      <div class="flex items-center gap-2">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <span>{program.schedule}</span>
                      </div>
                    )}
                    {program.speaker && (
                      <div class="flex items-center gap-2">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        <span>{program.speaker}</span>
                      </div>
                    )}
                    {program.location && (
                      <div class="flex items-center gap-2">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        <span>{program.location}</span>
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="card p-8 text-center" style="color: var(--color-muted);">
              <p class="text-sm">No {categoryLabels[cat].toLowerCase()} available at this time.</p>
            </div>
          )}
        </div>
      );
    })}
  </section>
</PlatformLayout>
