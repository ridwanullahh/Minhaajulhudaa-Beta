---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
---

<PlatformLayout title="Shopping Cart - Minhaajulhudaa School" platform="school">
  <section class="container-app py-12">
    <a href="/school/shop" class="text-sm font-medium mb-6 inline-flex items-center gap-1" style="color: var(--color-primary);">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Back to Shop
    </a>

    <h1 class="text-3xl font-extrabold mb-8">Shopping Cart</h1>

    <div id="cart-container" class="grid lg:grid-cols-3 gap-8">
      <!-- Cart Items -->
      <div class="lg:col-span-2">
        <div id="cart-items" class="space-y-4"></div>
        <div id="cart-empty" class="card p-12 text-center hidden">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto mb-4" style="color: var(--color-muted);"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          <h3 class="font-bold text-lg mb-2">Your cart is empty</h3>
          <p class="text-sm mb-4" style="color: var(--color-muted);">Browse our school shop to find books, uniforms, and supplies.</p>
          <a href="/school/shop" class="btn btn-primary inline-block">Browse Shop</a>
        </div>
      </div>

      <!-- Order Summary -->
      <div>
        <div class="card p-6 sticky top-24">
          <h3 class="font-bold text-lg mb-4">Order Summary</h3>
          <div class="space-y-3 text-sm mb-4">
            <div class="flex justify-between"><span style="color: var(--color-muted);">Subtotal</span><span id="cart-subtotal" class="font-medium">&#8358;0</span></div>
            <div class="flex justify-between"><span style="color: var(--color-muted);">Delivery</span><span id="cart-delivery" class="font-medium">&#8358;0</span></div>
          </div>
          <div class="flex justify-between text-lg font-bold pt-4 mb-6" style="border-top: 1px solid var(--color-border);">
            <span>Total</span><span id="cart-total" style="color: var(--color-primary);">&#8358;0</span>
          </div>
          <a href="/school/shop/checkout" id="checkout-btn" class="btn btn-primary w-full block text-center">Proceed to Checkout</a>
          <button id="clear-cart-btn" class="w-full mt-3 text-sm text-center py-2" style="color: var(--color-muted);">Clear Cart</button>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const CART_KEY = 'school_shop_cart';
    const DELIVERY_FEE = 1500;

    function getCart() {
      try { return JSON.parse(localStorage.getItem(CART_KEY) || '[]'); } catch { return []; }
    }
    function saveCart(cart) { localStorage.setItem(CART_KEY, JSON.stringify(cart)); }

    function renderCart() {
      const cart = getCart();
      const itemsEl = document.getElementById('cart-items');
      const emptyEl = document.getElementById('cart-empty');
      const subtotalEl = document.getElementById('cart-subtotal');
      const totalEl = document.getElementById('cart-total');
      const deliveryEl = document.getElementById('cart-delivery');
      const checkoutBtn = document.getElementById('checkout-btn');

      if (cart.length === 0) {
        itemsEl.innerHTML = '';
        emptyEl.classList.remove('hidden');
        checkoutBtn.style.opacity = '0.5';
        checkoutBtn.style.pointerEvents = 'none';
        subtotalEl.textContent = '\u20A60';
        totalEl.textContent = '\u20A60';
        deliveryEl.textContent = '\u20A60';
        return;
      }

      emptyEl.classList.add('hidden');
      checkoutBtn.style.opacity = '1';
      checkoutBtn.style.pointerEvents = 'auto';

      let subtotal = 0;
      itemsEl.innerHTML = cart.map((item, i) => {
        const lineTotal = item.price * item.quantity;
        subtotal += lineTotal;
        return `
          <div class="card p-4 flex gap-4 items-center">
            <div class="w-20 h-20 rounded-lg overflow-hidden flex-shrink-0" style="background: var(--color-surface);">
              ${item.imageUrl ? `<img src="${item.imageUrl}" alt="${item.title}" class="w-full h-full object-cover" />` : '<div class="w-full h-full flex items-center justify-center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--color-muted);"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg></div>'}
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-sm truncate">${item.title}</h3>
              <p class="text-sm mt-1" style="color: var(--color-primary);">\u20A6${item.price.toLocaleString()}</p>
              <div class="flex items-center gap-3 mt-2">
                <button onclick="updateQty(${i}, -1)" class="w-8 h-8 rounded-lg flex items-center justify-center" style="border: 1px solid var(--color-border);">-</button>
                <span class="font-medium text-sm w-6 text-center">${item.quantity}</span>
                <button onclick="updateQty(${i}, 1)" class="w-8 h-8 rounded-lg flex items-center justify-center" style="border: 1px solid var(--color-border);">+</button>
              </div>
            </div>
            <div class="text-right flex-shrink-0">
              <div class="font-bold">\u20A6${lineTotal.toLocaleString()}</div>
              <button onclick="removeItem(${i})" class="text-xs mt-2" style="color: #DC2626;">Remove</button>
            </div>
          </div>`;
      }).join('');

      const delivery = subtotal > 10000 ? 0 : DELIVERY_FEE;
      subtotalEl.textContent = '\u20A6' + subtotal.toLocaleString();
      deliveryEl.textContent = delivery === 0 ? 'Free' : '\u20A6' + delivery.toLocaleString();
      totalEl.textContent = '\u20A6' + (subtotal + delivery).toLocaleString();
    }

    window.updateQty = function(index, delta) {
      const cart = getCart();
      cart[index].quantity = Math.max(1, cart[index].quantity + delta);
      saveCart(cart);
      renderCart();
    };

    window.removeItem = function(index) {
      const cart = getCart();
      cart.splice(index, 1);
      saveCart(cart);
      renderCart();
    };

    document.getElementById('clear-cart-btn')?.addEventListener('click', () => {
      localStorage.removeItem(CART_KEY);
      renderCart();
    });

    renderCart();
  </script>
</PlatformLayout>
