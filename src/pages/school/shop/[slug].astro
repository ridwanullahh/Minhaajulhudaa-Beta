---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';
import { formatCurrency } from '../../../lib/utils';

const { slug } = Astro.params;

let product: any = null;
try {
  product = await lightbase.findOne('school_products', { field: 'slug', op: 'eq', value: slug });
} catch (err) {
  console.error('[school/shop/[slug].astro] fetch error:', err);
}

if (!product) {
  Astro.response.status = 404;
  return Astro.redirect('/404');
}

const inStock = product.stockQuantity === undefined || product.stockQuantity > 0;
---

<PlatformLayout title={`${product.title} - School Shop`} platform="school">
  <section class="container-app py-12">
    <a href="/school/shop" class="inline-flex items-center gap-2 text-sm mb-6" style="color: var(--color-muted);">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Back to Shop
    </a>

    <div class="grid lg:grid-cols-2 gap-8">
      <div class="aspect-square rounded-xl overflow-hidden bg-[rgb(5,179,77,0.05)]">
        {product.imageUrl ? (
          <img src={product.imageUrl} alt={product.title} class="w-full h-full object-cover" />
        ) : (
          <div class="w-full h-full flex items-center justify-center">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--color-primary);"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          </div>
        )}
      </div>

      <div>
        {product.category && <span class="badge badge-primary mb-3">{product.category.replace(/-/g, ' ')}</span>}
        <h1 class="text-3xl font-extrabold mb-4">{product.title}</h1>

        <div class="text-3xl font-extrabold mb-6" style="color: var(--color-primary);">
          {product.price ? formatCurrency(product.price) : 'Free'}
        </div>

        {product.description && (
          <div class="mb-6" style="color: var(--color-muted);">
            <div set:html={product.description} />
          </div>
        )}

        <dl class="space-y-3 text-sm mb-6">
          {product.sku && (
            <div class="flex justify-between"><dt style="color: var(--color-muted);">SKU</dt><dd class="font-medium">{product.sku}</dd></div>
          )}
          {product.stockQuantity !== undefined && (
            <div class="flex justify-between"><dt style="color: var(--color-muted);">Availability</dt><dd class="font-medium">{inStock ? `${product.stockQuantity} in stock` : 'Out of stock'}</dd></div>
          )}
        </dl>

        <button id="add-to-cart-btn" class="btn btn-primary w-full mb-3" disabled={!inStock} style={!inStock ? 'opacity: 0.5; cursor: not-allowed;' : ''}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          {inStock ? 'Add to Cart' : 'Out of Stock'}
        </button>
        <div id="cart-toast" class="hidden fixed bottom-20 left-1/2 -translate-x-1/2 z-50 px-4 py-2 rounded-lg text-sm font-medium" style="background: var(--color-primary); color: #fff;">Added to cart!</div>
        <p class="text-xs text-center" style="color: var(--color-muted);">Free pickup available at the school office.</p>
      </div>
    </div>
  </section>

  <script define:vars={{ product }}>
    const productData = { id: product.id, title: product.title, price: product.price || 0, imageUrl: product.imageUrl || '', slug: product.slug };
    const CART_KEY = 'school_shop_cart';

    function getCart() {
      try { return JSON.parse(localStorage.getItem(CART_KEY) || '[]'); } catch { return []; }
    }
    function saveCart(cart) { localStorage.setItem(CART_KEY, JSON.stringify(cart)); }

    document.getElementById('add-to-cart-btn')?.addEventListener('click', () => {
      const cart = getCart();
      const existing = cart.find(i => i.id === productData.id);
      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push({ ...productData, quantity: 1 });
      }
      saveCart(cart);
      const toast = document.getElementById('cart-toast');
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 2000);
    });
  </script>
</PlatformLayout>
