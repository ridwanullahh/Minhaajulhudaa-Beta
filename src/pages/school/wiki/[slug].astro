---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';

const { slug } = Astro.params;

let article: any = null;
try {
  article = await lightbase.findOne('school_wiki_articles', { field: 'slug', op: 'eq', value: slug });
} catch (err) {
  console.error('[school/wiki/[slug].astro] fetch error:', err);
}

if (!article) {
  Astro.response.status = 404;
  return Astro.redirect('/404');
}

let related: any[] = [];
try {
  const relatedResult = await lightbase.query('school_wiki_articles', {
    filter: { field: 'category', op: 'eq', value: article.category || '' },
    sort: 'title:asc',
    limit: 10,
  });
  related = (relatedResult.data || []).filter(function(a: any) { return a.slug !== article.slug; }).slice(0, 5);
} catch (err) {
  console.error('[school/wiki/[slug]] related query error:', err);
}
---

<PlatformLayout title={`${article.title} - Wiki - Minhaajulhudaa School`} platform="school">
  <section class="container-app py-12 max-w-4xl">
    <a href="/school/wiki" class="text-sm font-medium mb-6 inline-flex items-center gap-1" style="color: var(--color-primary);">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      All Articles
    </a>

    <article>
      <div class="flex flex-wrap gap-2 mb-4">
        {article.category && <span class="badge badge-primary">{article.category.replace(/-/g, ' ')}</span>}
        {article.tags && Array.isArray(article.tags) && article.tags.map((tag: string) => (
          <span class="badge" style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-muted);">{tag}</span>
        ))}
        {article.updatedAt && (
          <span class="text-xs" style="color: var(--color-muted);">Updated {new Date(article.updatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        )}
      </div>

      <h1 class="text-3xl md:text-4xl font-extrabold mb-6">{article.title}</h1>

      {article.excerpt && (
        <p class="text-lg mb-8" style="color: var(--color-muted); border-left: 3px solid var(--color-primary); padding-left: 1rem;">{article.excerpt}</p>
      )}

      <div class="prose max-w-none" style="color: var(--color-text);">
        {article.content ? (
          <div set:html={article.content} />
        ) : (
          <p style="color: var(--color-muted);">Article content coming soon, in shaa ALLAH.</p>
        )}
      </div>

      {article.author && (
        <div class="mt-8 pt-6 flex items-center gap-3" style="border-top: 1px solid var(--color-border);">
          <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold" style="background: rgb(5,179,77,0.1); color: var(--color-primary);">
            {article.author.split(' ').map(function(n: string) { return n[0]; }).join('').substring(0, 2)}
          </div>
          <div>
            <div class="text-sm font-medium">{article.author}</div>
            <div class="text-xs" style="color: var(--color-muted);">Contributor</div>
          </div>
        </div>
      )}
    </article>

    {related.length > 0 && (
      <div class="mt-12 pt-8" style="border-top: 1px solid var(--color-border);">
        <h2 class="text-xl font-bold mb-6">Related Articles</h2>
        <div class="grid md:grid-cols-2 gap-4">
          {related.map(function(r: any) {
            return (
              <a href={`/school/wiki/${r.slug}`} class="card card-hover p-5 block">
                <h3 class="font-bold text-sm mb-1">{r.title}</h3>
                {r.excerpt && <p class="text-xs line-clamp-2" style="color: var(--color-muted);">{r.excerpt.substring(0, 120)}</p>}
              </a>
            );
          })}
        </div>
      </div>
    )}
  </section>
</PlatformLayout>
