---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';

const result = await lightbase.query('school_wiki_articles', {
  sort: 'title:asc',
  limit: 100,
});
const articles = result.data || [];
const categories = [...new Set(articles.map((a: any) => a.category).filter(Boolean))];

const articlesByCategory = new Map<string, any[]>();
articles.forEach((article: any) => {
  const cat = article.category || 'Uncategorized';
  if (!articlesByCategory.has(cat)) articlesByCategory.set(cat, []);
  articlesByCategory.get(cat)!.push(article);
});
---

<PlatformLayout title="Wiki / Knowledgebase - Minhaajulhudaa School" platform="school">
  <section class="container-app py-12">
    <h1 class="text-3xl md:text-4xl font-extrabold mb-4">Knowledgebase</h1>
    <p style="color: var(--color-muted);" class="mb-8">Browse articles, guides, and resources for students, parents, and staff.</p>

    {categories.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        <button class="badge badge-primary" data-filter="all">All</button>
        {categories.map((cat: string) => (
          <button class="badge" style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-muted);" data-filter={cat}>{cat.replace(/-/g, ' ')}</button>
        ))}
      </div>
    )}

    {articles.length > 0 ? (
      <div id="wiki-list" class="space-y-6">
        {[...articlesByCategory.entries()].map(([cat, catArticles]) => (
          <div class="wiki-section" data-category={cat}>
            <h2 class="text-xl font-bold mb-3 flex items-center gap-2">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              {cat.replace(/-/g, ' ')}
            </h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
              {catArticles.map((article: any) => (
                <a href={`#${article.slug}`} class="card card-hover p-5 block">
                  <h3 class="font-bold text-sm mb-1">{article.title}</h3>
                  {article.excerpt && <p class="text-xs" style="color: var(--color-muted);">{article.excerpt.substring(0, 100)}</p>}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="card p-12 text-center">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto mb-4" style="color: var(--color-muted);"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        <p style="color: var(--color-muted);">No wiki articles available yet.</p>
      </div>
    )}
  </section>

  <script>
    document.querySelectorAll('[data-filter]').forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        document.querySelectorAll('.wiki-section').forEach(section => {
          if (filter === 'all' || section.dataset.category === filter) {
            (section as HTMLElement).style.display = '';
          } else {
            (section as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  </script>
</PlatformLayout>
