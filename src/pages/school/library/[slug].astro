---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';

export async function getStaticPaths() {
  try {
    const result = await lightbase.query('school_library_books', { limit: 100 });
    const books = (result.data || []).filter((b: any) => b.slug);
    return books.map((b: any) => ({ params: { slug: b.slug }, props: { book: b } }));
  } catch {
    return [];
  }
}

const { book } = Astro.props;

if (!book) {
  return Astro.redirect('/school/library');
}
---

<PlatformLayout title={`${book.title} - E-Library`} platform="school">
  <section class="container-app py-12">
    <a href="/school/library" class="inline-flex items-center gap-2 text-sm mb-6" style="color: var(--color-muted);">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Back to Library
    </a>

    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-1">
        <div class="aspect-[3/4] rounded-xl overflow-hidden bg-[rgb(5,179,77,0.05)]">
          {book.coverImageUrl ? (
            <img src={book.coverImageUrl} alt={book.title} class="w-full h-full object-cover" />
          ) : (
            <div class="w-full h-full flex items-center justify-center">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--color-primary);"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </div>
          )}
        </div>
      </div>

      <div class="lg:col-span-2">
        {book.category && <span class="badge badge-accent mb-3">{book.category.replace(/-/g, ' ')}</span>}
        <h1 class="text-3xl font-extrabold mb-2">{book.title}</h1>
        {book.author && <p class="text-lg mb-6" style="color: var(--color-muted);">by {book.author}</p>}

        {book.description && (
          <div class="mb-8" set:html={book.description} />
        )}

        <dl class="space-y-3 text-sm mb-8">
          {book.isbn && <div class="flex justify-between"><dt style="color: var(--color-muted);">ISBN</dt><dd class="font-medium">{book.isbn}</dd></div>}
          {book.pages && <div class="flex justify-between"><dt style="color: var(--color-muted);">Pages</dt><dd class="font-medium">{book.pages}</dd></div>}
          {book.language && <div class="flex justify-between"><dt style="color: var(--color-muted);">Language</dt><dd class="font-medium">{book.language}</dd></div>}
          {book.publisher && <div class="flex justify-between"><dt style="color: var(--color-muted);">Publisher</dt><dd class="font-medium">{book.publisher}</dd></div>}
        </dl>

        {book.fileUrl && (
          <a href={book.fileUrl} target="_blank" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            Read / Download
          </a>
        )}
      </div>
    </div>
  </section>
</PlatformLayout>
