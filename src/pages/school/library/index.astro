---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';

const result = await lightbase.query('school_library_books', {
  sort: 'title:asc',
  limit: 50,
});
const books = result.data || [];
const categories = [...new Set(books.map((b: any) => b.category).filter(Boolean))];
---
export const prerender = true;

<PlatformLayout title="E-Library - Minhaajulhudaa School" platform="school">
  <section class="container-app py-12">
    <h1 class="text-3xl md:text-4xl font-extrabold mb-4">E-Library</h1>
    <p style="color: var(--color-muted);" class="mb-8">Access our digital library of Islamic studies, academics, and reference materials.</p>

    {categories.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        <button class="badge badge-primary" data-filter="all">All</button>
        {categories.map((cat: string) => (
          <button class="badge" style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-muted);" data-filter={cat}>{cat.replace(/-/g, ' ')}</button>
        ))}
      </div>
    )}

    {books.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="books-grid">
        {books.map((book: any) => (
          <div class="card card-hover overflow-hidden book-card" data-category={book.category}>
            <div class="aspect-[3/4] bg-[rgb(5,179,77,0.05)] relative">
              {book.coverImageUrl ? (
                <img src={book.coverImageUrl} alt={book.title} class="w-full h-full object-cover" loading="lazy" />
              ) : (
                <div class="w-full h-full flex items-center justify-center p-6">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--color-primary);"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                </div>
              )}
              {book.fileUrl && (
                <div class="absolute top-2 right-2"><span class="badge badge-primary">Digital</span></div>
              )}
            </div>
            <div class="p-5">
              <h2 class="font-bold mb-1 line-clamp-1">{book.title}</h2>
              {book.author && <p class="text-sm mb-2" style="color: var(--color-muted);">by {book.author}</p>}
              {book.category && <span class="badge badge-accent mb-3">{book.category.replace(/-/g, ' ')}</span>}
              <a href={`/school/library/${book.slug}`} class="btn btn-outline w-full">View Details</a>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="card p-12 text-center">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto mb-4" style="color: var(--color-muted);"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        <p style="color: var(--color-muted);">No books available in the library yet.</p>
      </div>
    )}
  </section>

  <script>
    document.querySelectorAll('[data-filter]').forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        document.querySelectorAll('.book-card').forEach(card => {
          if (filter === 'all' || card.dataset.category === filter) {
            (card as HTMLElement).style.display = '';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  </script>
</PlatformLayout>
