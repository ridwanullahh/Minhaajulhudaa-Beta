---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import { lightbase } from '../../lib/lightbase';

const page = await lightbase.findOne('school_pages', { field: 'slug', op: 'eq', value: 'about' });
const [staffResult, testimonialsResult] = await Promise.all([
  lightbase.query('school_staff', { filter: { field: 'status', op: 'eq', value: 'active' }, limit: 8 }),
  lightbase.query('school_testimonials', { filter: { field: 'status', op: 'eq', value: 'approved' }, limit: 3 }),
]);

const staff = staffResult.data || [];
const testimonials = testimonialsResult.data || [];

const values = [
  { title: 'Excellence', desc: 'Striving for the highest standards in academics and character.' },
  { title: 'Faith', desc: 'Rooting every action in Islamic values and the love of Allah.' },
  { title: 'Compassion', desc: 'Nurturing empathy and care for all of Allah\'s creation.' },
  { title: 'Innovation', desc: 'Embracing modern learning while honoring tradition.' },
];
---

<PlatformLayout title="About - Minhaajulhudaa School" platform="school">
  <section class="container-app py-12">
    <div class="max-w-4xl">
      <span class="badge badge-accent mb-4">About Us</span>
      <h1 class="text-3xl md:text-5xl font-extrabold mb-6">About Minhaajulhudaa School</h1>
      <p class="text-lg mb-8" style="color: var(--color-muted);">
        Nurturing minds with knowledge and faith - combining academic excellence with authentic Islamic values.
      </p>
    </div>
  </section>

  {page && page.content && page.content.map((block) => {
    if (block.type === 'text') {
      return <section class="container-app pb-8"><p class="text-base leading-relaxed max-w-4xl" style="color: var(--color-muted);">{block.body}</p></section>;
    }
    return null;
  })}

  <!-- Values -->
  <section class="container-app py-16">
    <h2 class="text-2xl md:text-3xl font-bold text-center mb-12">Our Core Values</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {values.map((value) => (
        <div class="card p-6 text-center">
          <h3 class="font-bold mb-2" style="color: var(--color-primary);">{value.title}</h3>
          <p class="text-sm" style="color: var(--color-muted);">{value.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Staff -->
  {staff.length > 0 && (
    <section class="container-app py-16">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-12">Our Staff</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {staff.map((member) => (
          <div class="card p-6 text-center">
            <div class="w-20 h-20 rounded-full mx-auto mb-3 flex items-center justify-center text-2xl font-bold" style="background: rgb(5,179,77,0.1); color: var(--color-primary);">
              {member.firstName.charAt(0)}{member.lastName.charAt(0)}
            </div>
            <h3 class="font-semibold text-sm">{member.firstName} {member.lastName}</h3>
            <p class="text-xs mb-1" style="color: var(--color-muted);">{member.role.replace('-', ' ')}</p>
            {member.subjects && member.subjects.length > 0 && (
              <p class="text-xs" style="color: var(--color-muted);">{member.subjects.slice(0, 2).join(', ')}</p>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Testimonials -->
  {testimonials.length > 0 && (
    <section class="container-app py-16">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-12">What Parents Say</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {testimonials.map((t) => (
          <div class="card p-6">
            <div class="flex gap-1 mb-4">
              {Array.from({ length: t.rating }).map(() => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="color: var(--color-accent);">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>
            <p class="text-sm mb-4" style="color: var(--color-muted);">"{t.content}"</p>
            <div>
              <div class="font-semibold text-sm">{t.authorName}</div>
              <div class="text-xs" style="color: var(--color-muted);">{t.authorRole}</div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="container-app py-16">
    <div class="card p-8 text-center" style="background: linear-gradient(135deg, rgb(5,179,77,0.1), rgb(242,185,28,0.1));">
      <h2 class="text-2xl font-bold mb-4">Join Our Family</h2>
      <p class="mb-6" style="color: var(--color-muted);">Admissions for 2026/2027 are now open.</p>
      <a href="/school/admission" class="btn btn-primary">Apply Now</a>
    </div>
  </section>
</PlatformLayout>
