---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import { lightbase } from '../../lib/lightbase';

// Fetch real data from Lightbase
const [blogResult, programsResult, classesResult, testimonialsResult, eventsResult] = await Promise.all([
  lightbase.query('school_blog_posts', { filter: { field: 'status', op: 'eq', value: 'published' }, sort: 'publishedAt:desc', limit: 3 }),
  lightbase.query('school_programs', { filter: { field: 'status', op: 'eq', value: 'open' }, limit: 4 }),
  lightbase.query('school_classes', { filter: { field: 'active', op: 'eq', value: true }, limit: 4 }),
  lightbase.query('school_testimonials', { filter: { field: 'status', op: 'eq', value: 'approved' }, limit: 3 }),
  lightbase.query('school_events', { sort: 'startDate:asc', limit: 3 }),
]);

const blogPosts = blogResult.data || [];
const programs = programsResult.data || [];
const classes = classesResult.data || [];
const testimonials = testimonialsResult.data || [];
const events = eventsResult.data || [];

const stats = [
  { label: 'Students', value: '500+' },
  { label: 'Staff', value: '40+' },
  { label: 'Graduates', value: '1,200+' },
  { label: 'Awards', value: '25+' },
];

const values = [
  { title: 'Excellence', description: 'Striving for the highest standards in academics and character.' },
  { title: 'Faith', description: 'Rooting every action in Islamic values and the love of Allah.' },
  { title: 'Compassion', description: 'Nurturing empathy and care for all of Allah\'s creation.' },
  { title: 'Innovation', description: 'Embracing modern learning while honoring tradition.' },
];
---
export const prerender = true;

<PlatformLayout title="Minhaajulhudaa School - Islamic Education Excellence" platform="school">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="container-app py-12 md:py-20">
      <div class="max-w-3xl fade-in">
        <span class="badge badge-accent mb-4">Bismillah - Islamic Education Excellence</span>
        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-6">
          Nurturing Minds with <span style="color: var(--color-primary);">Knowledge</span> and <span style="color: var(--color-accent);">Faith</span>
        </h1>
        <p class="text-lg md:text-xl mb-8" style="color: var(--color-muted);">
          Minhaajulhudaa School combines academic excellence with authentic Islamic values, preparing students to be knowledgeable, God-conscious leaders of tomorrow.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/school/admission" class="btn btn-primary">
            Apply for Admission
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/school/programs" class="btn btn-ghost">Explore Programs</a>
        </div>
      </div>
    </div>
    <!-- Decorative pattern -->
    <div class="absolute top-0 right-0 w-1/3 h-full opacity-5 pointer-events-none hidden md:block">
      <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
        <pattern id="islamic-pattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M20 0 L40 20 L20 40 L0 20 Z" fill="none" stroke="currentColor" stroke-width="1"/>
          <circle cx="20" cy="20" r="8" fill="none" stroke="currentColor" stroke-width="1"/>
        </pattern>
        <rect width="200" height="200" fill="url(#islamic-pattern)" style="color: var(--color-primary);"/>
      </svg>
    </div>
  </section>

  <!-- Stats -->
  <section class="container-app -mt-8 relative z-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {stats.map((stat) => (
        <div class="card p-6 text-center">
          <div class="text-3xl md:text-4xl font-extrabold mb-1" style="color: var(--color-primary);">{stat.value}</div>
          <div class="text-sm" style="color: var(--color-muted);">{stat.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="container-app py-16">
    <div class="grid md:grid-cols-2 gap-8">
      <div class="card p-8">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4" style="background: rgb(5,179,77,0.1);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);">
            <circle cx="12" cy="12" r="10"/>
            <circle cx="12" cy="12" r="6"/>
            <circle cx="12" cy="12" r="2"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold mb-3">Our Mission</h3>
        <p style="color: var(--color-muted);">To provide quality education that integrates academic excellence with authentic Islamic values, developing students who are intellectually capable, spiritually grounded, and socially responsible.</p>
      </div>
      <div class="card p-8">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4" style="background: rgb(242,185,28,0.15);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-accent);">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold mb-3">Our Vision</h3>
        <p style="color: var(--color-muted);">To be a leading Islamic educational institution that nurtures a generation of knowledgeable, God-conscious leaders who positively impact their communities and the world.</p>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="container-app py-8">
    <h2 class="text-2xl md:text-3xl font-bold text-center mb-12">Our Core Values</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {values.map((value) => (
        <div class="card card-hover p-6 text-center">
          <h3 class="font-bold mb-2" style="color: var(--color-primary);">{value.title}</h3>
          <p class="text-sm" style="color: var(--color-muted);">{value.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Programs -->
  {programs.length > 0 && (
    <section class="container-app py-16">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl md:text-3xl font-bold">Our Programs</h2>
        <a href="/school/programs" class="text-sm font-medium" style="color: var(--color-primary);">View All</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {programs.map((program) => (
          <div class="card card-hover overflow-hidden">
            <div class="aspect-[16/9] bg-[rgb(5,179,77,0.1)] flex items-center justify-center">
              {program.imageUrl ? (
                <img src={program.imageUrl} alt={program.title} class="w-full h-full object-cover" loading="lazy" />
              ) : (
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--color-primary);">
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                  <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                </svg>
              )}
            </div>
            <div class="p-6">
              <span class="badge badge-primary mb-3">{program.category.replace('-', ' ')}</span>
              <h3 class="text-lg font-bold mb-2">{program.title}</h3>
              <p class="text-sm mb-4" style="color: var(--color-muted);">{program.shortDescription || program.description.substring(0, 120)}...</p>
              <div class="flex items-center justify-between">
                <span class="text-sm" style="color: var(--color-muted);">{program.duration}</span>
                <a href={`/school/programs/${program.slug}`} class="text-sm font-medium" style="color: var(--color-primary);">Learn More</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Classes -->
  {classes.length > 0 && (
    <section class="container-app py-16">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl md:text-3xl font-bold">Available Classes</h2>
        <a href="/school/classes" class="text-sm font-medium" style="color: var(--color-primary);">View All</a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {classes.map((cls) => (
          <div class="card card-hover p-6">
            <div class="text-2xl font-extrabold mb-1" style="color: var(--color-primary);">{cls.name}</div>
            <div class="text-xs mb-3" style="color: var(--color-muted);">Level: {cls.level.replace('-', ' ')}</div>
            <div class="text-sm mb-2">Teacher: <span class="font-medium">{cls.teacherName || 'TBD'}</span></div>
            <div class="text-xs" style="color: var(--color-muted);">{cls.currentEnrollment}/{cls.capacity} enrolled</div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Latest News -->
  {blogPosts.length > 0 && (
    <section class="container-app py-16">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl md:text-3xl font-bold">Latest News</h2>
        <a href="/school/news" class="text-sm font-medium" style="color: var(--color-primary);">View All</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {blogPosts.map((post) => (
          <article class="card card-hover overflow-hidden">
            <div class="aspect-[16/9] bg-[rgb(5,179,77,0.1)]">
              {post.featuredImageUrl && <img src={post.featuredImageUrl} alt={post.title} class="w-full h-full object-cover" loading="lazy" />}
            </div>
            <div class="p-6">
              <span class="badge badge-accent mb-3">{post.category}</span>
              <h3 class="font-bold mb-2 line-clamp-2">{post.title}</h3>
              <p class="text-sm mb-4 line-clamp-2" style="color: var(--color-muted);">{post.excerpt}</p>
              <a href={`/school/news/${post.slug}`} class="text-sm font-medium" style="color: var(--color-primary);">Read More</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Testimonials -->
  {testimonials.length > 0 && (
    <section class="container-app py-16">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-12">What Parents Say</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {testimonials.map((t) => (
          <div class="card p-6">
            <div class="flex gap-1 mb-4">
              {Array.from({ length: t.rating }).map(() => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="color: var(--color-accent);">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>
            <p class="text-sm mb-4" style="color: var(--color-muted);">"{t.content}"</p>
            <div>
              <div class="font-semibold text-sm">{t.authorName}</div>
              <div class="text-xs" style="color: var(--color-muted);">{t.authorRole}</div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="container-app py-16">
    <div class="card p-8 md:p-12 text-center" style="background: linear-gradient(135deg, rgb(5,179,77,0.1), rgb(242,185,28,0.1));">
      <h2 class="text-2xl md:text-4xl font-bold mb-4">Ready to Join Our Family?</h2>
      <p class="mb-8 max-w-2xl mx-auto" style="color: var(--color-muted);">Give your child the gift of quality education rooted in Islamic values. Admissions for the 2026/2027 academic year are now open.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/school/admission" class="btn btn-primary">Apply Now</a>
        <a href="/school/contact" class="btn btn-ghost">Contact Us</a>
      </div>
    </div>
  </section>
</PlatformLayout>
