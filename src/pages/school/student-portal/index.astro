---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
---

<PlatformLayout title="Student Portal - Minhaajulhudaa School" platform="school">
  <section class="container-app py-12">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-extrabold">Student Portal</h1>
        <p style="color: var(--color-muted);" class="mt-1">Access your academic records, courses, and assignments.</p>
      </div>
    </div>

    <!-- Student Lookup -->
    <div class="card p-6 max-w-xl mb-8" id="lookup-section">
      <h3 class="font-bold mb-4">Look Up Your Records</h3>
      <form id="student-lookup" class="flex gap-3">
        <input id="portal-student-id" type="text" class="input flex-1" placeholder="Enter your Student ID (e.g. MHS-2024-001)" required />
        <button type="submit" class="btn btn-primary whitespace-nowrap">Look Up</button>
      </form>
    </div>

    <!-- Student Dashboard (hidden until lookup) -->
    <div id="portal-dashboard" class="hidden">
      <div class="card p-6 mb-6" id="student-info"></div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8" id="student-stats"></div>

      <div class="flex gap-1 mb-6 border-b overflow-x-auto" style="border-color: var(--color-border);">
        <button class="portal-tab px-4 py-2.5 text-sm font-medium border-b-2 whitespace-nowrap" data-tab="results" style="border-color: var(--color-primary); color: var(--color-primary);">Results</button>
        <button class="portal-tab px-4 py-2.5 text-sm font-medium border-b-2 whitespace-nowrap" data-tab="assignments" style="border-color: transparent; color: var(--color-muted);">Assignments</button>
        <button class="portal-tab px-4 py-2.5 text-sm font-medium border-b-2 whitespace-nowrap" data-tab="courses" style="border-color: transparent; color: var(--color-muted);">My Courses</button>
        <button class="portal-tab px-4 py-2.5 text-sm font-medium border-b-2 whitespace-nowrap" data-tab="payments" style="border-color: transparent; color: var(--color-muted);">Payments</button>
      </div>

      <div id="tab-results" class="portal-panel"><div class="card p-8 text-center text-sm" style="color: var(--color-muted);">Loading results...</div></div>
      <div id="tab-assignments" class="portal-panel hidden"><div class="card p-8 text-center text-sm" style="color: var(--color-muted);">Loading assignments...</div></div>
      <div id="tab-courses" class="portal-panel hidden"><div class="card p-8 text-center text-sm" style="color: var(--color-muted);">Loading courses...</div></div>
      <div id="tab-payments" class="portal-panel hidden"><div class="card p-8 text-center text-sm" style="color: var(--color-muted);">Loading payments...</div></div>
    </div>
  </section>

  <script is:inline>
    let currentStudentId = '';

    document.getElementById('student-lookup')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      currentStudentId = document.getElementById('portal-student-id').value.trim();
      if (!currentStudentId) return;
      try {
        const res = await fetch('/api/school/portal?studentId=' + encodeURIComponent(currentStudentId));
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);
        document.getElementById('lookup-section').classList.add('hidden');
        document.getElementById('portal-dashboard').classList.remove('hidden');
        renderStudentInfo(data.student);
        renderStats(data);
        renderResults(data.results);
        renderAssignments(data.assignments);
        renderCourses(data.courses);
        renderPayments(data.payments);
      } catch (err) {
        showToast('Error: ' + err.message, 'error');
      }
    });

    function renderStudentInfo(student) {
      if (!student) return;
      const el = document.getElementById('student-info');
      const initials = (student.name || student.studentId || '?').split(' ').map(n => n[0]).join('').substring(0,2);
      el.innerHTML = '<div class="flex items-center gap-4"><div class="w-16 h-16 rounded-full flex items-center justify-center text-xl font-bold" style="background: rgb(5,179,77,0.1); color: var(--color-primary);">' + initials + '</div><div><h2 class="text-xl font-bold">' + (student.name || 'Student') + '</h2><p class="text-sm" style="color: var(--color-muted);">' + (student.studentId || '') + ' | ' + (student.className || '') + ' | ' + (student.section || '') + '</p></div></div>';
    }

    function renderStats(data) {
      const el = document.getElementById('student-stats');
      const pendingAssignments = (data.assignments || []).filter(a => a.status !== 'submitted').length;
      const totalPaid = (data.payments || []).reduce((s, p) => s + (p.amount || 0), 0);
      const stats = [
        { label: 'Courses', value: (data.courses || []).length, icon: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>' },
        { label: 'Results', value: (data.results || []).length, icon: '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>' },
        { label: 'Pending', value: pendingAssignments, icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>' },
        { label: 'Paid', value: '\u20A6' + totalPaid.toLocaleString(), icon: '<rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>' },
      ];
      el.innerHTML = stats.map(s => '<div class="card p-4 text-center"><div class="flex justify-center mb-2"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);">' + s.icon + '</svg></div><div class="text-lg font-bold">' + s.value + '</div><div class="text-xs" style="color: var(--color-muted);">' + s.label + '</div></div>').join('');
    }

    function renderResults(results) {
      const el = document.getElementById('tab-results');
      if (!results || results.length === 0) { el.innerHTML = '<div class="card p-8 text-center text-sm" style="color: var(--color-muted);">No results available yet.</div>'; return; }
      el.innerHTML = '<div class="card overflow-hidden"><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="text-left" style="background: var(--color-background); color: var(--color-muted);"><th class="p-4 font-medium">Exam</th><th class="p-4 font-medium hidden md:table-cell">Subject</th><th class="p-4 font-medium text-right">Score</th><th class="p-4 font-medium text-right">Grade</th></tr></thead><tbody>' + results.map(r => '<tr style="border-top: 1px solid var(--color-border);"><td class="p-4 font-medium">' + (r.examTitle || '-') + '</td><td class="p-4 hidden md:table-cell" style="color: var(--color-muted);">' + (r.subject || '-') + '</td><td class="p-4 text-right font-medium">' + (r.score ?? '-') + '/' + (r.totalMarks || '-') + '</td><td class="p-4 text-right"><span class="badge badge-accent">' + (r.grade || '-') + '</span></td></tr>').join('') + '</tbody></table></div></div>';
    }

    function renderAssignments(assignments) {
      const el = document.getElementById('tab-assignments');
      if (!assignments || assignments.length === 0) { el.innerHTML = '<div class="card p-8 text-center text-sm" style="color: var(--color-muted);">No assignments available.</div>'; return; }
      el.innerHTML = '<div class="space-y-4">' + assignments.map(a => {
        const isOverdue = a.dueDate && new Date(a.dueDate) < new Date() && a.status !== 'submitted';
        return '<div class="card p-5 flex justify-between items-start gap-4"><div class="flex-1"><h3 class="font-bold text-sm">' + a.title + '</h3><p class="text-xs mt-1" style="color: var(--color-muted);">' + (a.courseTitle || '') + (a.dueDate ? ' | Due: ' + new Date(a.dueDate).toLocaleDateString() : '') + '</p></div><span class="badge ' + (isOverdue ? 'badge-accent' : 'badge-primary') + '">' + (a.status || 'pending') + '</span></div>';
      }).join('') + '</div>';
    }

    function renderCourses(courses) {
      const el = document.getElementById('tab-courses');
      if (!courses || courses.length === 0) { el.innerHTML = '<div class="card p-8 text-center text-sm" style="color: var(--color-muted);">No courses enrolled.</div>'; return; }
      el.innerHTML = '<div class="grid md:grid-cols-2 gap-4">' + courses.map(c => '<a href="/school/courses/' + c.slug + '" class="card card-hover p-5 block"><h3 class="font-bold text-sm">' + c.title + '</h3>' + (c.description ? '<p class="text-xs mt-1 line-clamp-2" style="color: var(--color-muted);">' + c.description.substring(0, 100) + '</p>' : '') + '</a>').join('') + '</div>';
    }

    function renderPayments(payments) {
      const el = document.getElementById('tab-payments');
      if (!payments || payments.length === 0) { el.innerHTML = '<div class="card p-8 text-center text-sm" style="color: var(--color-muted);">No payment records.</div>'; return; }
      el.innerHTML = '<div class="space-y-3">' + payments.map(p => '<div class="card p-4 flex justify-between items-center"><div><div class="font-medium text-sm">' + (p.reference || 'Payment') + '</div><div class="text-xs" style="color: var(--color-muted);">' + (p.feeType || '') + ' | ' + new Date(p.createdAt).toLocaleDateString() + '</div></div><div class="text-right"><div class="font-bold" style="color: var(--color-primary);">\u20A6' + (p.amount || 0).toLocaleString() + '</div><span class="badge badge-primary">' + (p.status || '-') + '</span></div></div>').join('') + '</div>';
    }

    document.querySelectorAll('.portal-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.portal-tab').forEach(t => { t.style.borderColor = 'transparent'; t.style.color = 'var(--color-muted)'; });
        tab.style.borderColor = 'var(--color-primary)'; tab.style.color = 'var(--color-primary)';
        document.querySelectorAll('.portal-panel').forEach(p => p.classList.add('hidden'));
        document.getElementById('tab-' + tab.dataset.tab)?.classList.remove('hidden');
      });
    });
  </script>
</PlatformLayout>
