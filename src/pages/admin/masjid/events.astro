---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';
import { formatDate } from '../../../lib/utils';

const eventsResult = await lightbase.query('masjid_events', { sort: 'startDate:desc', limit: 100 });
const events = eventsResult.data || [];
---

<AdminLayout title="Events" platform="masjid" section="events">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 fade-in">
    <div>
      <h2 class="text-xl font-bold">Events Management</h2>
      <p class="text-sm" style="color: var(--color-muted);">{events.length} events total</p>
    </div>
    <button id="btn-add-event" class="btn btn-primary text-xs">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Event
    </button>
  </div>

  <div class="card overflow-hidden fade-in">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr style="background: var(--color-background); color: var(--color-muted);">
            <th class="text-left p-3 font-medium">Title</th>
            <th class="text-left p-3 font-medium hidden sm:table-cell">Category</th>
            <th class="text-left p-3 font-medium hidden md:table-cell">Date</th>
            <th class="text-left p-3 font-medium hidden lg:table-cell">Speaker</th>
            <th class="text-right p-3 font-medium">Actions</th>
          </tr>
        </thead>
        <tbody>
          {events.map((event: any) => (
            <tr style="border-top: 1px solid var(--color-border);">
              <td class="p-3 font-medium">{event.title}</td>
              <td class="p-3 hidden sm:table-cell"><span class="badge badge-primary">{event.category}</span></td>
              <td class="p-3 hidden md:table-cell" style="color: var(--color-muted);">{event.startDate ? formatDate(event.startDate, 'date') : '-'}</td>
              <td class="p-3 hidden lg:table-cell" style="color: var(--color-muted);">{event.speaker || '-'}</td>
              <td class="p-3 text-right">
                <div class="flex items-center justify-end gap-1">
                  <button class="btn-edit-event w-8 h-8 rounded-lg flex items-center justify-center hover:bg-[rgb(5,179,77,0.1)]" data-id={event.id} title="Edit">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </button>
                  <button class="btn-delete-event w-8 h-8 rounded-lg flex items-center justify-center hover:bg-[rgb(220,38,38,0.1)]" data-id={event.id} title="Delete">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #DC2626;"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {events.length === 0 && <p class="text-sm p-6 text-center" style="color: var(--color-muted);">No events yet.</p>}
    </div>
  </div>

  <!-- Event Modal -->
  <div id="modal-event" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/40" id="modal-event-bg"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
      <div class="card p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto relative" style="background: var(--color-surface);">
        <div class="flex items-center justify-between mb-6">
          <h3 class="font-bold text-lg" id="modal-event-title">New Event</h3>
          <button id="modal-event-close" class="w-8 h-8 rounded-lg flex items-center justify-center hover:bg-[rgb(220,38,38,0.1)]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <form id="event-form" class="space-y-4">
          <input type="hidden" name="id" id="event-id" />
          <div>
            <label class="block text-sm font-medium mb-1">Title</label>
            <input type="text" name="title" class="input" required placeholder="Event title" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-medium mb-1">Category</label>
              <select name="category" class="input">
                <option value="khutbah">Khutbah</option>
                <option value="halaqah">Halaqah</option>
                <option value="educational">Educational</option>
                <option value="special">Special</option>
                <option value="youth">Youth</option>
                <option value="community">Community</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Speaker</label>
              <input type="text" name="speaker" class="input" placeholder="Speaker name" />
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-medium mb-1">Start Date</label>
              <input type="datetime-local" name="startDate" class="input" required />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">End Date</label>
              <input type="datetime-local" name="endDate" class="input" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Location</label>
            <input type="text" name="location" class="input" placeholder="Location" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Description</label>
            <textarea name="description" class="input" rows="4" placeholder="Event description"></textarea>
          </div>
          <div class="flex items-center gap-2">
            <input type="checkbox" name="isRecurring" id="isRecurring" class="w-4 h-4" />
            <label for="isRecurring" class="text-sm">Recurring event</label>
          </div>
          <div class="flex justify-end gap-2 pt-2">
            <button type="button" id="modal-event-cancel" class="btn btn-ghost">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Event</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    const modal = document.getElementById('modal-event');
    const openBtn = document.getElementById('btn-add-event');
    const closeBtn = document.getElementById('modal-event-close');
    const cancelBtn = document.getElementById('modal-event-cancel');
    const bg = document.getElementById('modal-event-bg');
    const form = document.getElementById('event-form');
    const titleEl = document.getElementById('modal-event-title');
    const idEl = document.getElementById('event-id');
    let editMode = false;

    const open = () => { modal.classList.remove('hidden'); editMode = false; titleEl.textContent = 'New Event'; form.reset(); idEl.value = ''; };
    const close = () => modal.classList.add('hidden');

    openBtn?.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    cancelBtn?.addEventListener('click', close);
    bg?.addEventListener('click', close);

    document.querySelectorAll('.btn-edit-event').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        try {
          const res = await fetch('/api/admin/masjid/events?id=' + id);
          const data = await res.json();
          editMode = true; titleEl.textContent = 'Edit Event'; idEl.value = id;
          form.title.value = data.title || '';
          form.category.value = data.category || 'khutbah';
          form.speaker.value = data.speaker || '';
          form.startDate.value = data.startDate ? data.startDate.slice(0,16) : '';
          form.endDate.value = data.endDate ? data.endDate.slice(0,16) : '';
          form.location.value = data.location || '';
          form.description.value = data.description || '';
          form.isRecurring.checked = !!data.isRecurring;
          modal.classList.remove('hidden');
        } catch(e) { showToast('Failed to load event', 'error'); }
      });
    });

    document.querySelectorAll('.btn-delete-event').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('Delete this event?')) return;
        try {
          await fetch('/api/admin/masjid/events?id=' + btn.dataset.id, { method: 'DELETE' });
          window.location.reload();
        } catch(e) { showToast('Failed to delete', 'error'); }
      });
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const data = Object.fromEntries(fd);
      data.isRecurring = !!data.isRecurring;
      try {
        const method = editMode ? 'PATCH' : 'POST';
        const url = editMode ? '/api/admin/masjid/events?id=' + data.id : '/api/admin/masjid/events';
        const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        const json = await res.json();
        if (json.success) { window.location.reload(); } else { showToast(json.error || 'Failed', 'error'); }
      } catch (err) { showToast('Request failed', 'error'); }
    });
  </script>
</AdminLayout>
