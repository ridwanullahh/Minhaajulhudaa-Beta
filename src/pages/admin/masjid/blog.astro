---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';
import { formatDate } from '../../../lib/utils';

const postsResult = await lightbase.query('masjid_blog_posts', { sort: 'publishedAt:desc', limit: 100 });
const posts = postsResult.data || [];
---

<AdminLayout title="Blog" platform="masjid" section="blog">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 fade-in">
    <div>
      <h2 class="text-xl font-bold">Blog Management</h2>
      <p class="text-sm" style="color: var(--color-muted);">{posts.length} posts total</p>
    </div>
    <button id="btn-add-post" class="btn btn-primary text-xs">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Post
    </button>
  </div>

  <div class="card overflow-hidden fade-in">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr style="background: var(--color-background); color: var(--color-muted);">
            <th class="text-left p-3 font-medium">Title</th>
            <th class="text-left p-3 font-medium hidden sm:table-cell">Category</th>
            <th class="text-left p-3 font-medium hidden md:table-cell">Author</th>
            <th class="text-left p-3 font-medium hidden lg:table-cell">Published</th>
            <th class="text-right p-3 font-medium">Status</th>
            <th class="text-right p-3 font-medium">Actions</th>
          </tr>
        </thead>
        <tbody>
          {posts.map((post: any) => (
            <tr style="border-top: 1px solid var(--color-border);">
              <td class="p-3 font-medium">{post.title}</td>
              <td class="p-3 hidden sm:table-cell"><span class="badge badge-primary">{post.category || '-'}</span></td>
              <td class="p-3 hidden md:table-cell" style="color: var(--color-muted);">{post.authorName || '-'}</td>
              <td class="p-3 hidden lg:table-cell" style="color: var(--color-muted);">{post.publishedAt ? formatDate(post.publishedAt, 'date') : '-'}</td>
              <td class="p-3 text-right"><span class={post.status === 'published' ? 'badge badge-primary' : 'badge badge-accent'}>{post.status || 'draft'}</span></td>
              <td class="p-3 text-right">
                <div class="flex items-center justify-end gap-1">
                  <button class="btn-edit-post w-8 h-8 rounded-lg flex items-center justify-center hover:bg-[rgb(5,179,77,0.1)]" data-id={post.id} title="Edit">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </button>
                  <button class="btn-delete-post w-8 h-8 rounded-lg flex items-center justify-center hover:bg-[rgb(220,38,38,0.1)]" data-id={post.id} title="Delete">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #DC2626;"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {posts.length === 0 && <p class="text-sm p-6 text-center" style="color: var(--color-muted);">No blog posts yet.</p>}
    </div>
  </div>

  <!-- Blog Post Modal -->
  <div id="modal-post" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/40" id="modal-post-bg"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
      <div class="card p-6 w-full max-w-2xl max-h-[90vh] overflow-y-auto relative" style="background: var(--color-surface);">
        <div class="flex items-center justify-between mb-6">
          <h3 class="font-bold text-lg" id="modal-post-title">New Post</h3>
          <button id="modal-post-close" class="w-8 h-8 rounded-lg flex items-center justify-center hover:bg-[rgb(220,38,38,0.1)]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <form id="post-form" class="space-y-4">
          <input type="hidden" name="id" id="post-id" />
          <div>
            <label class="block text-sm font-medium mb-1">Title</label>
            <input type="text" name="title" class="input" required placeholder="Post title" />
          </div>
          <div class="grid grid-cols-3 gap-3">
            <div>
              <label class="block text-sm font-medium mb-1">Category</label>
              <input type="text" name="category" class="input" placeholder="e.g. Fiqh" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Author Name</label>
              <input type="text" name="authorName" class="input" placeholder="Author name" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Status</label>
              <select name="status" class="input">
                <option value="draft">Draft</option>
                <option value="published">Published</option>
              </select>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Featured Image URL</label>
            <input type="url" name="featuredImage" class="input" placeholder="https://..." />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Excerpt</label>
            <textarea name="excerpt" class="input" rows="2" placeholder="Brief summary"></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Content</label>
            <textarea name="content" class="input" rows="8" placeholder="Full article content..." style="font-family: monospace;"></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Tags (comma separated)</label>
            <input type="text" name="tags" class="input" placeholder="islam, fiqh, prayer" />
          </div>
          <div class="flex justify-end gap-2 pt-2">
            <button type="button" id="modal-post-cancel" class="btn btn-ghost">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Post</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    const modal = document.getElementById('modal-post');
    const openBtn = document.getElementById('btn-add-post');
    const closeBtn = document.getElementById('modal-post-close');
    const cancelBtn = document.getElementById('modal-post-cancel');
    const bg = document.getElementById('modal-post-bg');
    const form = document.getElementById('post-form');
    const titleEl = document.getElementById('modal-post-title');
    const idEl = document.getElementById('post-id');
    let editMode = false;

    const open = () => { modal.classList.remove('hidden'); editMode = false; titleEl.textContent = 'New Post'; form.reset(); idEl.value = ''; };
    const close = () => modal.classList.add('hidden');

    openBtn?.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    cancelBtn?.addEventListener('click', close);
    bg?.addEventListener('click', close);

    document.querySelectorAll('.btn-edit-post').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        try {
          const res = await fetch('/api/admin/masjid/blog?id=' + id);
          const data = await res.json();
          editMode = true; titleEl.textContent = 'Edit Post'; idEl.value = id;
          form.title.value = data.title || '';
          form.category.value = data.category || '';
          form.authorName.value = data.authorName || '';
          form.status.value = data.status || 'draft';
          form.featuredImage.value = data.featuredImage || '';
          form.excerpt.value = data.excerpt || '';
          form.content.value = data.content || '';
          form.tags.value = (data.tags || []).join(', ');
          modal.classList.remove('hidden');
        } catch(e) { showToast('Failed to load post', 'error'); }
      });
    });

    document.querySelectorAll('.btn-delete-post').forEach(btn => {
      btn.addEventListener('click', async () => {
        showConfirm('Delete this post?', async function() {        try {
            await fetch('/api/admin/masjid/blog?id=' + btn.dataset.id, { method: 'DELETE' });
            window.location.reload();
          } catch(e) { showToast('Failed to delete', 'error'); }
        });
      });
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const data = Object.fromEntries(fd);
      if (typeof data.tags === 'string') data.tags = data.tags.split(',').map(t => t.trim()).filter(Boolean);
      try {
        const method = editMode ? 'PATCH' : 'POST';
        const url = editMode ? '/api/admin/masjid/blog?id=' + data.id : '/api/admin/masjid/blog';
        const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        const json = await res.json();
        if (json.success) { window.location.reload(); } else { showToast(json.error || 'Failed', 'error'); }
      } catch (err) { showToast('Request failed', 'error'); }
    });
  </script>
</AdminLayout>