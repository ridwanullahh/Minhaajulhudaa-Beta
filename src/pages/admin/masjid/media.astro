---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';
import { formatDate } from '../../../lib/utils';

const galleryResult = await lightbase.query('masjid_gallery', { sort: 'createdAt:desc', limit: 100 });
const gallery = galleryResult.data || [];

const albums = [...new Set(gallery.map(g => g.album).filter(Boolean))];
---

<AdminLayout title="Media" platform="masjid" section="media">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 fade-in">
    <div>
      <h2 class="text-xl font-bold">Gallery Management</h2>
      <p class="text-sm" style="color: var(--color-muted);">{gallery.length} items across {albums.length} albums</p>
    </div>
    <button id="btn-add-media" class="btn btn-primary text-xs">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Add Media
    </button>
  </div>

  <!-- Album Tabs -->
  {albums.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-6 fade-in">
      <span class="badge badge-primary cursor-pointer" data-album="">All</span>
      {albums.map(a => <span class="badge cursor-pointer" data-album={a}>{a}</span>)}
    </div>
  )}

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 fade-in">
    {gallery.map((item: any) => (
      <div class="card overflow-hidden group relative">
        <div class="aspect-square relative">
          {item.type === 'video' && item.videoUrl ? (
            <div class="w-full h-full flex items-center justify-center" style="background: var(--color-brand-dark);">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" opacity="0.7"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
            </div>
          ) : item.imageUrl ? (
            <img src={item.imageUrl} alt={item.title || ''} class="w-full h-full object-cover" loading="lazy" />
          ) : (
            <div class="w-full h-full flex items-center justify-center" style="background: var(--color-border);">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--color-muted); opacity: 0.4;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </div>
          )}
          <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
            <button class="btn-delete-media w-8 h-8 rounded-lg flex items-center justify-center" data-id={item.id} style="background: rgb(220,38,38,0.9);">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            </button>
          </div>
        </div>
        <div class="p-2">
          <p class="text-xs font-medium truncate">{item.title || 'Untitled'}</p>
          {item.album && <p class="text-xs" style="color: var(--color-muted);">{item.album}</p>}
        </div>
      </div>
    ))}
  </div>
  {gallery.length === 0 && (
    <div class="card p-12 text-center" style="color: var(--color-muted);">
      <p>No gallery items yet.</p>
    </div>
  )}

  <!-- Media Modal -->
  <div id="modal-media" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/40" id="modal-media-bg"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
      <div class="card p-6 w-full max-w-lg relative" style="background: var(--color-surface);">
        <div class="flex items-center justify-between mb-6">
          <h3 class="font-bold text-lg">Add Media</h3>
          <button id="modal-media-close" class="w-8 h-8 rounded-lg flex items-center justify-center hover:bg-[rgb(220,38,38,0.1)]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <form id="media-form" class="space-y-4">
          <div>
            <label class="block text-sm font-medium mb-1">Title</label>
            <input type="text" name="title" class="input" placeholder="Media title" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-medium mb-1">Type</label>
              <select name="type" class="input">
                <option value="photo">Photo</option>
                <option value="video">Video</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Album</label>
              <input type="text" name="album" class="input" placeholder="Album name" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Image URL (for photos)</label>
            <input type="url" name="imageUrl" class="input" placeholder="https://..." />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Video URL (for videos)</label>
            <input type="url" name="videoUrl" class="input" placeholder="https://..." />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Event ID (optional link)</label>
            <input type="text" name="eventId" class="input" placeholder="Link to event" />
          </div>
          <div class="flex justify-end gap-2 pt-2">
            <button type="button" id="modal-media-cancel" class="btn btn-ghost">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Media</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    const modal = document.getElementById('modal-media');
    const openBtn = document.getElementById('btn-add-media');
    const closeBtn = document.getElementById('modal-media-close');
    const cancelBtn = document.getElementById('modal-media-cancel');
    const bg = document.getElementById('modal-media-bg');
    const form = document.getElementById('media-form');

    const open = () => modal.classList.remove('hidden');
    const close = () => modal.classList.add('hidden');

    openBtn?.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    cancelBtn?.addEventListener('click', close);
    bg?.addEventListener('click', close);

    document.querySelectorAll('.btn-delete-media').forEach(btn => {
      btn.addEventListener('click', async () => {
        showConfirm('Delete this media?', async function() {        try {
            await fetch('/api/admin/masjid/content?collection=masjid_gallery&id=' + btn.dataset.id, { method: 'DELETE' });
            window.location.reload();
          } catch(e) { showToast('Failed', 'error'); }
        });
      });
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const data = Object.fromEntries(fd);
      try {
        const res = await fetch('/api/admin/masjid/content', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-collection': 'masjid_gallery' },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (json.success) { window.location.reload(); } else { showToast(json.error || 'Failed', 'error'); }
      } catch (err) { showToast('Request failed', 'error'); }
    });
  </script>
</AdminLayout>
