---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';

let settings: any = null;
try {
  settings = await lightbase.findOne('masjid_settings', {});
} catch {}
---

<AdminLayout title="Settings" platform="masjid" section="settings">
  <div class="mb-6 fade-in">
    <h2 class="text-xl font-bold">Masjid Settings</h2>
    <p class="text-sm" style="color: var(--color-muted);">Configure general platform settings</p>
  </div>

  <div class="grid lg:grid-cols-2 gap-6">
    <div class="card p-6 fade-in">
      <h3 class="font-bold mb-4">General Information</h3>
      <form id="settings-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1">Masjid Name</label>
          <input type="text" name="masjidName" class="input" value={settings?.masjidName || ''} placeholder="Minhaajulhudaa Masjid" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Address</label>
          <input type="text" name="address" class="input" value={settings?.address || ''} placeholder="Full address" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium mb-1">Phone</label>
            <input type="tel" name="phone" class="input" value={settings?.phone || ''} placeholder="+234..." />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Email</label>
            <input type="email" name="email" class="input" value={settings?.email || ''} placeholder="info@masjid.com" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Jumu'ah Time</label>
          <input type="text" name="jumuahTime" class="input" value={settings?.jumuahTime || ''} placeholder="1:00 PM" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Live Stream URL</label>
          <input type="url" name="liveStreamUrl" class="input" value={settings?.liveStreamUrl || ''} placeholder="https://youtube.com/..." />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">About / Description</label>
          <textarea name="description" class="input" rows="4" placeholder="Masjid description">{settings?.description || ''}</textarea>
        </div>
        <div class="pt-2">
          <button type="submit" class="btn btn-primary">Save Settings</button>
        </div>
      </form>
    </div>

    <div class="space-y-6">
      <div class="card p-6 fade-in">
        <h3 class="font-bold mb-4">Social Media Links</h3>
        <form id="social-form" class="space-y-3">
          <div>
            <label class="block text-xs font-medium mb-1">Facebook</label>
            <input type="url" name="facebook" class="input" value={settings?.facebook || ''} placeholder="https://facebook.com/..." />
          </div>
          <div>
            <label class="block text-xs font-medium mb-1">Twitter / X</label>
            <input type="url" name="twitter" class="input" value={settings?.twitter || ''} placeholder="https://x.com/..." />
          </div>
          <div>
            <label class="block text-xs font-medium mb-1">Instagram</label>
            <input type="url" name="instagram" class="input" value={settings?.instagram || ''} placeholder="https://instagram.com/..." />
          </div>
          <div>
            <label class="block text-xs font-medium mb-1">YouTube</label>
            <input type="url" name="youtube" class="input" value={settings?.youtube || ''} placeholder="https://youtube.com/..." />
          </div>
          <div class="pt-2">
            <button type="submit" class="btn btn-primary text-xs">Save Social Links</button>
          </div>
        </form>
      </div>

      <div class="card p-6 fade-in">
        <h3 class="font-bold mb-4">Danger Zone</h3>
        <p class="text-sm mb-4" style="color: var(--color-muted);">These actions are irreversible.</p>
        <div class="space-y-2">
          <button class="btn btn-ghost text-xs w-full" style="color: #DC2626; border-color: #DC2626;" onclick="if(confirm('Clear all announcements?')){fetch('/api/admin/masjid/content?collection=masjid_announcements', {method:'DELETE',headers:{'x-collection':'masjid_announcements'}}).then(()=>location.reload())}">Clear All Announcements</button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    document.getElementById('settings-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target);
      const data = Object.fromEntries(fd);
      try {
        const res = await fetch('/api/admin/masjid/content', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'x-collection': 'masjid_settings' },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (json.success) { alert('Saved'); window.location.reload(); } else { alert(json.error || 'Failed'); }
      } catch (err) { alert('Request failed'); }
    });

    document.getElementById('social-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target);
      const data = Object.fromEntries(fd);
      try {
        const existing = await fetch('/api/admin/masjid/content?collection=masjid_settings');
        const existingData = await existing.json();
        const res = await fetch('/api/admin/masjid/content', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'x-collection': 'masjid_settings' },
          body: JSON.stringify({ ...existingData, ...data }),
        });
        const json = await res.json();
        if (json.success) { alert('Saved'); window.location.reload(); } else { alert(json.error || 'Failed'); }
      } catch (err) { alert('Request failed'); }
    });
  </script>
</AdminLayout>