---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';

const booksResult = await lightbase.query('masjid_books', { sort: 'title:asc', limit: 100 });
const books = booksResult.data || [];
---

<AdminLayout title="Bookstore" platform="masjid" section="bookstore">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 fade-in">
    <div>
      <h2 class="text-xl font-bold">Bookstore Management</h2>
      <p class="text-sm" style="color: var(--color-muted);">{books.length} books</p>
    </div>
    <button id="btn-add-book" class="btn btn-primary text-xs">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Add Book
    </button>
  </div>

  <div class="card overflow-hidden fade-in">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr style="background: var(--color-background); color: var(--color-muted);">
            <th class="text-left p-3 font-medium">Title</th>
            <th class="text-left p-3 font-medium hidden sm:table-cell">Author</th>
            <th class="text-left p-3 font-medium hidden md:table-cell">Type</th>
            <th class="text-right p-3 font-medium hidden md:table-cell">Price</th>
            <th class="text-right p-3 font-medium hidden lg:table-cell">Stock</th>
            <th class="text-left p-3 font-medium hidden lg:table-cell">Status</th>
            <th class="text-right p-3 font-medium">Actions</th>
          </tr>
        </thead>
        <tbody>
          {books.map((book: any) => (
            <tr style="border-top: 1px solid var(--color-border);">
              <td class="p-3 font-medium">{book.title}</td>
              <td class="p-3 hidden sm:table-cell" style="color: var(--color-muted);">{book.author || '-'}</td>
              <td class="p-3 hidden md:table-cell">
                <span class="badge badge-primary">{book.type || '-'}</span>
              </td>
              <td class="p-3 text-right hidden md:table-cell" style="color: var(--color-muted);">{book.price != null ? '$' + Number(book.price).toFixed(2) : '-'}</td>
              <td class="p-3 text-right hidden lg:table-cell" style="color: var(--color-muted);">{book.stockQuantity != null ? book.stockQuantity : '-'}</td>
              <td class="p-3 hidden lg:table-cell">
                {book.status === 'active' ? (
                  <span class="badge" style="background: rgba(5,179,77,0.15); color: #05B34D;">Active</span>
                ) : book.status === 'draft' ? (
                  <span class="badge" style="background: rgba(220,38,38,0.15); color: #DC2626;">Draft</span>
                ) : (
                  <span class="badge" style="background: rgba(234,179,8,0.15); color: #D97706;">{book.status}</span>
                )}
              </td>
              <td class="p-3 text-right">
                <div class="flex items-center justify-end gap-1">
                  <button class="btn-edit-book w-8 h-8 rounded-lg flex items-center justify-center hover:bg-[rgb(5,179,77,0.1)]" data-id={book.id} title="Edit">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </button>
                  <button class="btn-delete-book w-8 h-8 rounded-lg flex items-center justify-center hover:bg-[rgb(220,38,38,0.1)]" data-id={book.id} title="Delete">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #DC2626;"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {books.length === 0 && <p class="text-sm p-6 text-center" style="color: var(--color-muted);">No books yet.</p>}
    </div>
  </div>

  <!-- Book Modal -->
  <div id="modal-book" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/40" id="modal-book-bg"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
      <div class="card p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto relative" style="background: var(--color-surface);">
        <div class="flex items-center justify-between mb-6">
          <h3 class="font-bold text-lg" id="modal-book-title">Add Book</h3>
          <button id="modal-book-close" class="w-8 h-8 rounded-lg flex items-center justify-center hover:bg-[rgb(220,38,38,0.1)]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <form id="book-form" class="space-y-4">
          <input type="hidden" name="id" id="book-id" />
          <div>
            <label class="block text-sm font-medium mb-1">Title</label>
            <input type="text" name="title" class="input" required placeholder="Book title" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-medium mb-1">Author</label>
              <input type="text" name="author" class="input" placeholder="Author name" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">ISBN</label>
              <input type="text" name="isbn" class="input" placeholder="978-..." />
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-medium mb-1">Type</label>
              <select name="type" class="input">
                <option value="digital">Digital</option>
                <option value="physical">Physical</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Category</label>
              <input type="text" name="category" class="input" placeholder="e.g. Fiqh, Aqeedah" />
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-medium mb-1">Price ($)</label>
              <input type="number" name="price" class="input" step="0.01" min="0" placeholder="0.00" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Stock Quantity</label>
              <input type="number" name="stockQuantity" class="input" min="0" placeholder="0" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Cover URL</label>
            <input type="url" name="coverUrl" class="input" placeholder="https://..." />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Download URL</label>
            <input type="url" name="downloadUrl" class="input" placeholder="https://... (for digital books)" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Description</label>
            <textarea name="description" class="input" rows="3" placeholder="Brief description"></textarea>
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Status</label>
            <select name="status" class="input">
              <option value="active">Active</option>
              <option value="draft">Draft</option>
              <option value="out_of_stock">Out of Stock</option>
            </select>
          </div>
          <div class="flex justify-end gap-2 pt-2">
            <button type="button" id="modal-book-cancel" class="btn btn-ghost">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Book</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    const modal = document.getElementById('modal-book');
    const openBtn = document.getElementById('btn-add-book');
    const closeBtn = document.getElementById('modal-book-close');
    const cancelBtn = document.getElementById('modal-book-cancel');
    const bg = document.getElementById('modal-book-bg');
    const form = document.getElementById('book-form');
    const titleEl = document.getElementById('modal-book-title');
    const idEl = document.getElementById('book-id');
    let editMode = false;

    const open = () => { modal.classList.remove('hidden'); editMode = false; titleEl.textContent = 'Add Book'; form.reset(); idEl.value = ''; };
    const close = () => modal.classList.add('hidden');

    openBtn?.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    cancelBtn?.addEventListener('click', close);
    bg?.addEventListener('click', close);

    document.querySelectorAll('.btn-edit-book').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        try {
          const res = await fetch('/api/admin/masjid/bookstore?id=' + id);
          const data = await res.json();
          editMode = true; titleEl.textContent = 'Edit Book'; idEl.value = id;
          form.title.value = data.title || '';
          form.author.value = data.author || '';
          form.isbn.value = data.isbn || '';
          form.type.value = data.type || 'digital';
          form.category.value = data.category || '';
          form.price.value = data.price || '';
          form.stockQuantity.value = data.stockQuantity || '';
          form.coverUrl.value = data.coverUrl || '';
          form.downloadUrl.value = data.downloadUrl || '';
          form.description.value = data.description || '';
          form.status.value = data.status || 'active';
          modal.classList.remove('hidden');
        } catch(e) { alert('Failed to load book'); }
      });
    });

    document.querySelectorAll('.btn-delete-book').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('Delete this book?')) return;
        try {
          await fetch('/api/admin/masjid/bookstore?id=' + btn.dataset.id, { method: 'DELETE' });
          window.location.reload();
        } catch(e) { alert('Failed to delete'); }
      });
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const data = Object.fromEntries(fd);
      if (data.price) data.price = parseFloat(data.price);
      if (data.stockQuantity) data.stockQuantity = parseInt(data.stockQuantity);
      try {
        const method = editMode ? 'PATCH' : 'POST';
        const url = editMode ? '/api/admin/masjid/bookstore?id=' + data.id : '/api/admin/masjid/bookstore';
        const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        const json = await res.json();
        if (json.success) { window.location.reload(); } else { alert(json.error || 'Failed'); }
      } catch (err) { alert('Request failed'); }
    });
  </script>
</AdminLayout>
