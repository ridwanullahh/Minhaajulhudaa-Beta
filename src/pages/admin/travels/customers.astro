---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';
import { formatCurrency } from '../../../lib/utils';

const customersResult = await lightbase.query('travels_customers', {
  sort: '_created_at:desc',
  limit: 100,
}).catch(() => ({ data: [] }));

const customers = customersResult.data || [];
---

<AdminLayout title="Customers" platform="travels" section="customers">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h2 class="font-bold text-lg">Customers</h2>
      <p class="text-sm" style="color: var(--color-muted);">Customer profiles with booking history</p>
    </div>
    <button id="btn-new-customer" class="btn btn-primary">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      Add Customer
    </button>
  </div>

  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr style="color: var(--color-muted); border-bottom: 1px solid var(--color-border);">
          <th class="text-left p-4 font-medium">Customer</th>
          <th class="text-left p-4 font-medium hidden md:table-cell">Phone</th>
          <th class="text-left p-4 font-medium hidden lg:table-cell">Nationality</th>
          <th class="text-right p-4 font-medium hidden sm:table-cell">Bookings</th>
          <th class="text-right p-4 font-medium hidden md:table-cell">Total Spent</th>
          <th class="text-right p-4 font-medium">Actions</th>
        </tr></thead>
        <tbody>
          {customers.length > 0 ? customers.map((c: any) => (
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td class="p-4">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold shrink-0" style="background: rgb(5,179,77,0.1); color: var(--color-primary);">
                    {(c.name || 'U').charAt(0).toUpperCase()}
                  </div>
                  <div>
                    <div class="font-medium">{c.name || '-'}</div>
                    <div class="text-xs" style="color: var(--color-muted);">{c.email || '-'}</div>
                  </div>
                </div>
              </td>
              <td class="p-4 hidden md:table-cell" style="color: var(--color-muted);">{c.phone || '-'}</td>
              <td class="p-4 hidden lg:table-cell" style="color: var(--color-muted);">{c.nationality || '-'}</td>
              <td class="p-4 text-right hidden sm:table-cell font-medium">{c.totalBookings || 0}</td>
              <td class="p-4 text-right hidden md:table-cell font-medium">{c.totalSpent ? formatCurrency(c.totalSpent) : '-'}</td>
              <td class="p-4 text-right">
                <button class="btn btn-ghost text-xs px-2 py-1 btn-edit" data-id={c.id} title="Edit">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </button>
              </td>
            </tr>
          )) : (
            <tr><td colspan="6" class="p-12 text-center" style="color: var(--color-muted);">No customers found.</td></tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add/Edit Customer Modal -->
  <div id="modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40" id="modal-overlay"></div>
    <div class="relative w-full max-w-lg rounded-2xl p-6" style="background: var(--color-surface);">
      <div class="flex items-center justify-between mb-6">
        <h3 id="modal-title" class="font-bold text-lg">Add Customer</h3>
        <button id="modal-close" class="w-8 h-8 rounded-lg flex items-center justify-center hover:bg-[rgb(220,38,38,0.1)]">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <form id="modal-form" class="space-y-4">
        <input type="hidden" id="form-id" />
        <div><label class="text-sm font-medium block mb-1">Name</label><input id="form-name" class="input" required /></div>
        <div><label class="text-sm font-medium block mb-1">Email</label><input id="form-email" type="email" class="input" required /></div>
        <div><label class="text-sm font-medium block mb-1">Phone</label><input id="form-phone" class="input" /></div>
        <div><label class="text-sm font-medium block mb-1">Nationality</label><input id="form-nationality" class="input" /></div>
        <div><label class="text-sm font-medium block mb-1">Notes</label><textarea id="form-notes" class="input" rows="3"></textarea></div>
        <div class="flex justify-end gap-3 pt-2">
          <button type="button" id="modal-cancel" class="btn btn-ghost">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Customer</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    (function() {
      const modal = document.getElementById('modal');
      const form = document.getElementById('modal-form') as HTMLFormElement;
      const title = document.getElementById('modal-title');
      const fields = ['name','email','phone','nationality','notes'];

      document.getElementById('btn-new-customer')!.addEventListener('click', () => {
        title!.textContent = 'Add Customer';
        fields.forEach(f => { (document.getElementById('form-' + f) as HTMLInputElement).value = ''; });
        (document.getElementById('form-id') as HTMLInputElement).value = '';
        modal!.classList.remove('hidden');
      });

      document.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.id;
          title!.textContent = 'Edit Customer';
          fetch('/api/admin/travels/customers?id=' + id).then(r => r.json()).then(data => {
            const c = data.document || data;
            fields.forEach(f => { (document.getElementById('form-' + f) as HTMLInputElement).value = c[f] || ''; });
            (document.getElementById('form-id') as HTMLInputElement).value = c.id || '';
            modal!.classList.remove('hidden');
          }).catch(() => {});
        });
      });

      document.getElementById('modal-close')!.addEventListener('click', () => modal!.classList.add('hidden'));
      document.getElementById('modal-overlay')!.addEventListener('click', () => modal!.classList.add('hidden'));
      document.getElementById('modal-cancel')!.addEventListener('click', () => modal!.classList.add('hidden'));

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const id = (document.getElementById('form-id') as HTMLInputElement).value;
        const body: any = {};
        fields.forEach(f => { body[f] = (document.getElementById('form-' + f) as HTMLInputElement).value; });
        const ep = id ? '/api/admin/travels/customers?id=' + id : '/api/admin/travels/customers';
        const method = id ? 'PATCH' : 'POST';
        fetch(ep, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(() => location.reload()).catch(() => {});
      });
    })();
  </script>
</AdminLayout>
