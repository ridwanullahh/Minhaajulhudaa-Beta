---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';

const galleryResult = await lightbase.query('travels_gallery', { sort: '_created_at:desc', limit: 100 }).catch(() => ({ data: [] }));
const allMedia = galleryResult.data || [];

const categories = [...new Set(allMedia.map((m: any) => m.category).filter(Boolean))];
---

<AdminLayout title="Media" platform="travels" section="media">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h2 class="font-bold text-lg">Gallery</h2>
      <p class="text-sm" style="color: var(--color-muted);">Manage destination photos, tour photos, and customer photos</p>
    </div>
    <button id="btn-new-media" class="btn btn-primary">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      Add Media
    </button>
  </div>

  {categories.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-6">
      <a href="/admin/travels/media" class:list={['btn text-xs', 'btn-primary']}>All</a>
      {categories.map((cat: string) => (
        <a href={`/admin/travels/media?category=${cat}`} class="btn btn-ghost text-xs">{cat}</a>
      ))}
    </div>
  )}

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
    {allMedia.length > 0 ? allMedia.map((m: any) => (
      <div class="card overflow-hidden group relative">
        <div class="aspect-square relative">
          {m.imageUrl ? <img src={m.imageUrl} alt={m.title || ''} class="w-full h-full object-cover" loading="lazy" /> : (
            <div class="w-full h-full flex items-center justify-center" style="background: var(--color-border);">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--color-muted);"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </div>
          )}
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
            <button class="btn-delete btn text-xs px-2 py-1" data-id={m.id} style="color: white; background: rgb(220,38,38,0.8);" title="Delete">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            </button>
          </div>
        </div>
        <div class="p-3">
          <div class="font-medium text-sm truncate">{m.title || 'Untitled'}</div>
          <div class="text-xs" style="color: var(--color-muted);">{m.category || 'Uncategorized'}</div>
        </div>
      </div>
    )) : (
      <div class="col-span-full card p-12 text-center" style="color: var(--color-muted);">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto mb-4"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        <h3 class="font-bold text-lg mb-2">No Media</h3>
        <p class="text-sm">Add your first gallery item.</p>
      </div>
    )}
  </div>

  <!-- Add Media Modal -->
  <div id="modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40" id="modal-overlay"></div>
    <div class="relative w-full max-w-lg rounded-2xl p-6" style="background: var(--color-surface);">
      <div class="flex items-center justify-between mb-6">
        <h3 class="font-bold text-lg">Add Media</h3>
        <button id="modal-close" class="w-8 h-8 rounded-lg flex items-center justify-center hover:bg-[rgb(220,38,38,0.1)]">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <form id="modal-form" class="space-y-4">
        <div><label class="text-sm font-medium block mb-1">Title</label><input id="form-title" class="input" required /></div>
        <div><label class="text-sm font-medium block mb-1">Image URL</label><input id="form-imageUrl" class="input" required /></div>
        <div><label class="text-sm font-medium block mb-1">Category</label>
          <select id="form-category" class="input">
            <option value="destination">Destination</option>
            <option value="tour">Tour</option>
            <option value="customer">Customer</option>
            <option value="hotel">Hotel</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div><label class="text-sm font-medium block mb-1">Alt Text</label><input id="form-alt" class="input" /></div>
        <div class="flex justify-end gap-3 pt-2">
          <button type="button" id="modal-cancel" class="btn btn-ghost">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const modal = document.getElementById('modal');
    document.getElementById('btn-new-media')!.addEventListener('click', () => modal!.classList.remove('hidden'));
    document.getElementById('modal-close')!.addEventListener('click', () => modal!.classList.add('hidden'));
    document.getElementById('modal-overlay')!.addEventListener('click', () => modal!.classList.add('hidden'));
    document.getElementById('modal-cancel')!.addEventListener('click', () => modal!.classList.add('hidden'));

    document.querySelectorAll('.btn-delete').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id;
        showConfirm('Delete this media item?', function() {
          fetch('/api/admin/travels/content?collection=travels_gallery&id=' + id, { method: 'DELETE' }).then(() => location.reload()).catch(() => {});
        });
      });
    });

    document.getElementById('modal-form')!.addEventListener('submit', (e) => {
      e.preventDefault();
      const body = {
        title: (document.getElementById('form-title') as HTMLInputElement).value,
        imageUrl: (document.getElementById('form-imageUrl') as HTMLInputElement).value,
        category: (document.getElementById('form-category') as HTMLSelectElement).value,
        alt: (document.getElementById('form-alt') as HTMLInputElement).value,
      };
      fetch('/api/admin/travels/content?collection=travels_gallery', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      }).then(() => location.reload()).catch(() => {});
    });
  </script>
</AdminLayout>
