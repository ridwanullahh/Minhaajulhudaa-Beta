---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';

const pages = await lightbase.query('travels_pages', { sort: '_created_at:desc', limit: 100 }).catch(() => ({ data: [] }));
const allPages = pages.data || [];
---

<AdminLayout title="Content" platform="travels" section="content">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h2 class="font-bold text-lg">Content & Pages</h2>
      <p class="text-sm" style="color: var(--color-muted);">Manage static pages and content blocks</p>
    </div>
    <button id="btn-new-page" class="btn btn-primary">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      New Page
    </button>
  </div>

  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr style="color: var(--color-muted); border-bottom: 1px solid var(--color-border);">
          <th class="text-left p-4 font-medium">Page</th>
          <th class="text-left p-4 font-medium hidden md:table-cell">Slug</th>
          <th class="text-left p-4 font-medium hidden lg:table-cell">Type</th>
          <th class="text-center p-4 font-medium">Status</th>
          <th class="text-right p-4 font-medium">Actions</th>
        </tr></thead>
        <tbody>
          {allPages.length > 0 ? allPages.map((p: any) => (
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td class="p-4 font-medium">{p.title || '-'}</td>
              <td class="p-4 hidden md:table-cell" style="color: var(--color-muted);">{p.slug || '-'}</td>
              <td class="p-4 hidden lg:table-cell" style="color: var(--color-muted);">{p.pageType || 'page'}</td>
              <td class="p-4 text-center"><span class={p.status === 'published' ? 'badge badge-primary' : 'badge'}>{p.status || 'draft'}</span></td>
              <td class="p-4 text-right">
                <div class="flex justify-end gap-1">
                  <button class="btn btn-ghost text-xs px-2 py-1 btn-edit" data-id={p.id} title="Edit">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </button>
                  <button class="btn btn-ghost text-xs px-2 py-1 btn-delete" data-id={p.id} title="Delete" style="color: var(--color-error);">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  </button>
                </div>
              </td>
            </tr>
          )) : (
            <tr><td colspan="5" class="p-12 text-center" style="color: var(--color-muted);">No pages found.</td></tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal -->
  <div id="modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40" id="modal-overlay"></div>
    <div class="relative w-full max-w-2xl max-h-[90vh] overflow-y-auto rounded-2xl p-6" style="background: var(--color-surface);">
      <div class="flex items-center justify-between mb-6">
        <h3 id="modal-title" class="font-bold text-lg">New Page</h3>
        <button id="modal-close" class="w-8 h-8 rounded-lg flex items-center justify-center hover:bg-[rgb(220,38,38,0.1)]">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <form id="modal-form" class="space-y-4">
        <input type="hidden" id="form-id" />
        <div><label class="text-sm font-medium block mb-1">Title</label><input id="form-title" class="input" required /></div>
        <div><label class="text-sm font-medium block mb-1">Slug</label><input id="form-slug" class="input" /></div>
        <div><label class="text-sm font-medium block mb-1">Page Type</label>
          <select id="form-pageType" class="input">
            <option value="page">Page</option>
            <option value="section">Section</option>
          </select>
        </div>
        <div><label class="text-sm font-medium block mb-1">Status</label>
          <select id="form-status" class="input">
            <option value="draft">Draft</option>
            <option value="published">Published</option>
          </select>
        </div>
        <div><label class="text-sm font-medium block mb-1">Content (HTML)</label><textarea id="form-content" class="input" rows="8"></textarea></div>
        <div class="flex justify-end gap-3 pt-2">
          <button type="button" id="modal-cancel" class="btn btn-ghost">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Page</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    (function() {
      const fields = ['title','slug','pageType','status','content'];
      const modal = document.getElementById('modal');
      const form = document.getElementById('modal-form') as HTMLFormElement;
      const title = document.getElementById('modal-title');

      function openModal(isEdit: boolean, data?: any) {
        title!.textContent = isEdit ? 'Edit Page' : 'New Page';
        fields.forEach(f => { (document.getElementById('form-' + f) as HTMLInputElement).value = data?.[f] || ''; });
        (document.getElementById('form-id') as HTMLInputElement).value = data?.id || '';
        modal!.classList.remove('hidden');
      }

      document.getElementById('btn-new-page')!.addEventListener('click', () => openModal(false));
      document.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.id;
          fetch('/api/admin/travels/content?id=' + id).then(r => r.json()).then(data => openModal(true, data.document || data)).catch(() => {});
        });
      });

      document.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = (btn as HTMLElement).dataset.id;
          showConfirm('Delete this page?', function() {
            fetch('/api/admin/travels/content?id=' + id, { method: 'DELETE' }).then(() => location.reload()).catch(() => {});
          });
        });
      });

      document.getElementById('modal-close')!.addEventListener('click', () => modal!.classList.add('hidden'));
      document.getElementById('modal-overlay')!.addEventListener('click', () => modal!.classList.add('hidden'));
      document.getElementById('modal-cancel')!.addEventListener('click', () => modal!.classList.add('hidden'));

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const id = (document.getElementById('form-id') as HTMLInputElement).value;
        const body: any = {};
        fields.forEach(f => { body[f] = (document.getElementById('form-' + f) as HTMLInputElement).value; });
        const ep = id ? '/api/admin/travels/content?id=' + id : '/api/admin/travels/content';
        const method = id ? 'PATCH' : 'POST';
        fetch(ep, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(() => location.reload()).catch(() => {});
      });
    })();
  </script>
</AdminLayout>
