---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';

const [examSchedules, examResults] = await Promise.all([
  lightbase.query('school_exam_schedules', { sort: 'examDate:desc', limit: 50 }),
  lightbase.query('school_exam_results', { sort: 'createdAt:desc', limit: 50 }),
]);
const schedules = examSchedules.data || [];
const results = examResults.data || [];
---

<AdminLayout title="Exam Management" platform="school" section="exams">
  <div class="mb-6 fade-in">
    <h2 class="text-lg font-bold">Exam System</h2>
    <p class="text-sm" style="color: var(--color-muted);">Manage exam schedules, results, and analytics.</p>
  </div>

  <div class="flex gap-1 mb-6 border-b" style="border-color: var(--color-border);">
    <button class="exam-tab px-4 py-2.5 text-sm font-medium border-b-2" data-tab="schedules" style="border-color: var(--color-primary); color: var(--color-primary);">Schedules ({schedules.length})</button>
    <button class="exam-tab px-4 py-2.5 text-sm font-medium border-b-2" data-tab="results" style="border-color: transparent; color: var(--color-muted);">Results ({results.length})</button>
  </div>

  <!-- Schedules Tab -->
  <div id="tab-schedules" class="exam-panel">
    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left" style="background: var(--color-background); color: var(--color-muted);">
            <th class="p-4 font-medium">Title</th>
            <th class="p-4 font-medium hidden md:table-cell">Class</th>
            <th class="p-4 font-medium hidden sm:table-cell">Subject</th>
            <th class="p-4 font-medium hidden lg:table-cell">Date</th>
            <th class="p-4 font-medium text-right">Status</th>
          </tr></thead>
          <tbody>
            {schedules.map((s: any) => (
              <tr style="border-top: 1px solid var(--color-border);">
                <td class="p-4 font-medium">{s.title}</td>
                <td class="p-4 hidden md:table-cell" style="color: var(--color-muted);">{s.className || '-'}</td>
                <td class="p-4 hidden sm:table-cell" style="color: var(--color-muted);">{s.subject || '-'}</td>
                <td class="p-4 hidden lg:table-cell" style="color: var(--color-muted);">{s.examDate ? new Date(s.examDate).toLocaleDateString() : '-'}</td>
                <td class="p-4 text-right"><span class="badge badge-primary">{s.status || 'scheduled'}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {schedules.length === 0 && <div class="p-8 text-center text-sm" style="color: var(--color-muted);">No exam schedules yet.</div>}
    </div>
  </div>

  <!-- Results Tab -->
  <div id="tab-results" class="exam-panel hidden">
    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left" style="background: var(--color-background); color: var(--color-muted);">
            <th class="p-4 font-medium">Student</th>
            <th class="p-4 font-medium hidden md:table-cell">Exam</th>
            <th class="p-4 font-medium hidden sm:table-cell">Subject</th>
            <th class="p-4 font-medium text-right">Score</th>
            <th class="p-4 font-medium text-right">Grade</th>
          </tr></thead>
          <tbody>
            {results.map((r: any) => (
              <tr style="border-top: 1px solid var(--color-border);">
                <td class="p-4 font-medium">{r.studentName || '-'}</td>
                <td class="p-4 hidden md:table-cell" style="color: var(--color-muted);">{r.examTitle || '-'}</td>
                <td class="p-4 hidden sm:table-cell" style="color: var(--color-muted);">{r.subject || '-'}</td>
                <td class="p-4 text-right font-medium">{r.score ?? '-'}</td>
                <td class="p-4 text-right"><span class="badge badge-accent">{r.grade || '-'}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {results.length === 0 && <div class="p-8 text-center text-sm" style="color: var(--color-muted);">No exam results yet.</div>}
    </div>
  </div>

  <script>
    document.querySelectorAll('.exam-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.exam-tab').forEach(t => { t.style.borderColor = 'transparent'; t.style.color = 'var(--color-muted)'; });
        tab.style.borderColor = 'var(--color-primary)'; tab.style.color = 'var(--color-primary)';
        document.querySelectorAll('.exam-panel').forEach(p => p.classList.add('hidden'));
        document.getElementById('tab-' + tab.dataset.tab)?.classList.remove('hidden');
      });
    });
  </script>
</AdminLayout>