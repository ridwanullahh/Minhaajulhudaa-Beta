---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';
import { formatCurrency } from '../../../lib/utils';

const [productsResult, ordersResult] = await Promise.all([
  lightbase.query('school_products', { sort: 'title:asc', limit: 100 }),
  lightbase.query('school_orders', { sort: 'createdAt:desc', limit: 50 }),
]);
const products = productsResult.data || [];
const orders = ordersResult.data || [];
---

<AdminLayout title="Shop Management" platform="school" section="shop">
  <div class="flex items-center justify-between mb-6 fade-in">
    <div>
      <h2 class="text-lg font-bold">Shop</h2>
      <p class="text-sm" style="color: var(--color-muted);">{products.length} products, {orders.length} orders</p>
    </div>
  </div>

  <div class="flex gap-1 mb-6 border-b" style="border-color: var(--color-border);">
    <button class="shop-tab px-4 py-2.5 text-sm font-medium border-b-2" data-tab="products" style="border-color: var(--color-primary); color: var(--color-primary);">Products</button>
    <button class="shop-tab px-4 py-2.5 text-sm font-medium border-b-2" data-tab="orders" style="border-color: transparent; color: var(--color-muted);">Orders</button>
  </div>

  <div id="tab-products" class="shop-panel">
    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left" style="background: var(--color-background); color: var(--color-muted);">
            <th class="p-4 font-medium">Product</th>
            <th class="p-4 font-medium hidden md:table-cell">Category</th>
            <th class="p-4 font-medium hidden sm:table-cell">Price</th>
            <th class="p-4 font-medium hidden lg:table-cell">Stock</th>
            <th class="p-4 font-medium text-right">Status</th>
          </tr></thead>
          <tbody>
            {products.map((p: any) => (
              <tr style="border-top: 1px solid var(--color-border);">
                <td class="p-4 font-medium">{p.title}</td>
                <td class="p-4 hidden md:table-cell"><span class="badge badge-accent">{p.category || '-'}</span></td>
                <td class="p-4 hidden sm:table-cell font-medium">{p.price ? formatCurrency(p.price) : '-'}</td>
                <td class="p-4 hidden lg:table-cell" style="color: var(--color-muted);">{p.stockQuantity ?? '-'}</td>
                <td class="p-4 text-right"><span class={p.status === 'active' ? 'badge badge-primary' : 'badge'}>{p.status || '-'}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {products.length === 0 && <div class="p-8 text-center text-sm" style="color: var(--color-muted);">No products yet.</div>}
    </div>
  </div>

  <div id="tab-orders" class="shop-panel hidden">
    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="text-left" style="background: var(--color-background); color: var(--color-muted);">
            <th class="p-4 font-medium">Order #</th>
            <th class="p-4 font-medium hidden md:table-cell">Customer</th>
            <th class="p-4 font-medium hidden sm:table-cell">Items</th>
            <th class="p-4 font-medium text-right">Total</th>
            <th class="p-4 font-medium text-right">Status</th>
          </tr></thead>
          <tbody>
            {orders.map((o: any) => (
              <tr style="border-top: 1px solid var(--color-border);">
                <td class="p-4 font-medium">{o.orderNumber || o.id}</td>
                <td class="p-4 hidden md:table-cell" style="color: var(--color-muted);">{o.customerName || '-'}</td>
                <td class="p-4 hidden sm:table-cell" style="color: var(--color-muted);">{o.itemCount || '-'}</td>
                <td class="p-4 text-right font-medium">{o.total ? formatCurrency(o.total) : '-'}</td>
                <td class="p-4 text-right"><span class={o.status === 'completed' ? 'badge badge-primary' : 'badge'}>{o.status || '-'}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {orders.length === 0 && <div class="p-8 text-center text-sm" style="color: var(--color-muted);">No orders yet.</div>}
    </div>
  </div>

  <script>
    document.querySelectorAll('.shop-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.shop-tab').forEach(t => { t.style.borderColor = 'transparent'; t.style.color = 'var(--color-muted)'; });
        tab.style.borderColor = 'var(--color-primary)'; tab.style.color = 'var(--color-primary)';
        document.querySelectorAll('.shop-panel').forEach(p => p.classList.add('hidden'));
        document.getElementById('tab-' + tab.dataset.tab)?.classList.remove('hidden');
      });
    });
  </script>
</AdminLayout>
