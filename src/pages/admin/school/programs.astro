---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';

const result = await lightbase.query('school_programs', {
  sort: 'title:asc',
  limit: 100,
});
const programs = result.data || [];
---

<AdminLayout title="Program Management" platform="school" section="programs">
  <div class="flex items-center justify-between mb-6 fade-in">
    <div>
      <h2 class="text-lg font-bold">Programs</h2>
      <p class="text-sm" style="color: var(--color-muted);">{programs.length} total programs</p>
    </div>
    <button id="toggle-form-btn" class="btn btn-primary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      Add Program
    </button>
  </div>

  <!-- Create Form -->
  <div id="create-form" class="hidden card p-6 mb-6">
    <h3 class="font-bold mb-4">Add New Program</h3>
    <form id="program-form" class="space-y-4">
      <div class="grid md:grid-cols-2 gap-4">
        <div><label class="block text-sm font-medium mb-1" for="p-title">Title</label><input id="p-title" name="title" class="input" required /></div>
        <div><label class="block text-sm font-medium mb-1" for="p-slug">Slug</label><input id="p-slug" name="slug" class="input" /></div>
      </div>
      <div class="grid md:grid-cols-3 gap-4">
        <div><label class="block text-sm font-medium mb-1" for="p-category">Category</label>
          <select id="p-category" name="category" class="input"><option value="academic">Academic</option><option value="islamic">Islamic</option><option value="extracurricular">Extracurricular</option></select></div>
        <div><label class="block text-sm font-medium mb-1" for="p-duration">Duration</label><input id="p-duration" name="duration" class="input" /></div>
        <div><label class="block text-sm font-medium mb-1" for="p-status">Status</label>
          <select id="p-status" name="status" class="input"><option value="open">Open</option><option value="closed">Closed</option></select></div>
      </div>
      <div><label class="block text-sm font-medium mb-1" for="p-short-desc">Short Description</label><textarea id="p-short-desc" name="shortDescription" class="input" rows="2"></textarea></div>
      <div><label class="block text-sm font-medium mb-1" for="p-desc">Full Description</label><textarea id="p-desc" name="description" class="input" rows="5"></textarea></div>
      <div class="flex gap-3">
        <button type="submit" class="btn btn-primary">Add Program</button>
        <button type="button" id="cancel-form-btn" class="btn btn-ghost">Cancel</button>
      </div>
    </form>
  </div>

  <!-- Programs Table -->
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr class="text-left" style="background: var(--color-background); color: var(--color-muted);">
          <th class="p-4 font-medium">Title</th>
          <th class="p-4 font-medium hidden md:table-cell">Category</th>
          <th class="p-4 font-medium hidden sm:table-cell">Duration</th>
          <th class="p-4 font-medium hidden lg:table-cell">Status</th>
          <th class="p-4 font-medium text-right">Actions</th>
        </tr></thead>
        <tbody>
          {programs.map((p: any) => (
            <tr style="border-top: 1px solid var(--color-border);">
              <td class="p-4 font-medium">{p.title}</td>
              <td class="p-4 hidden md:table-cell"><span class="badge badge-primary">{p.category ? p.category.replace(/-/g, ' ') : '-'}</span></td>
              <td class="p-4 hidden sm:table-cell" style="color: var(--color-muted);">{p.duration || '-'}</td>
              <td class="p-4 hidden lg:table-cell"><span class={p.status === 'open' ? 'badge badge-primary' : 'badge'}>{p.status || '-'}</span></td>
              <td class="p-4 text-right">
                <button class="text-xs font-medium mr-3" style="color: var(--color-primary);" data-edit-program={p.id}>Edit</button>
                <button class="text-xs font-medium" style="color: #DC2626;" data-delete-program={p.id}>Delete</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {programs.length === 0 && <div class="p-8 text-center text-sm" style="color: var(--color-muted);">No programs created yet.</div>}
  </div>

  <script>
    const toggleBtn = document.getElementById('toggle-form-btn');
    const cancelBtn = document.getElementById('cancel-form-btn');
    const createForm = document.getElementById('create-form');
    toggleBtn?.addEventListener('click', () => createForm?.classList.toggle('hidden'));
    cancelBtn?.addEventListener('click', () => createForm?.classList.add('hidden'));

    const titleInput = document.getElementById('p-title') as HTMLInputElement;
    const slugInput = document.getElementById('p-slug') as HTMLInputElement;
    titleInput?.addEventListener('input', () => {
      slugInput.value = titleInput.value.toLowerCase().trim().replace(/[^\w\s-]/g, '').replace(/[\s_]+/g, '-').replace(/^-+|-+$/g, '');
    });

    document.getElementById('program-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const body: Record<string, any> = {};
      fd.forEach((v, k) => { body[k] = v; });
      try {
        const res = await fetch('/api/admin/school/content', { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-collection': 'school_programs' }, body: JSON.stringify(body) });
        if (res.ok) window.location.reload(); else { const err = await res.json(); showToast(err.error || 'Failed', 'error'); }
      } catch { showToast('Network error', 'error'); }
    });
  </script>
</AdminLayout>
