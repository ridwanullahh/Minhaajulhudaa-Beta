---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';

const result = await lightbase.query('school_programs', { sort: 'title', limit: 100 });
const allItems = result.data || [];
---

<AdminLayout title="Program Management" platform="school" section="programs">
  <div class="mb-6 fade-in">
    <h2 class="text-lg font-bold">Programs</h2>
    <p class="text-sm" style="color: var(--color-muted);">{allItems.length} total</p>
  </div>
  <div class="grid lg:grid-cols-2 gap-6">
    <div>
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-bold text-sm">All Programs</h3>
        <button id="new-btn" class="btn btn-primary text-sm">New</button>
      </div>
      <div class="card overflow-hidden">
        <div class="max-h-[600px] overflow-y-auto">
          <table class="w-full text-sm">
            <thead class="sticky top-0" style="background: var(--color-background);">
              <tr class="text-left" style="color: var(--color-muted);">
                <th class="p-3 font-medium">Title</th>
                <th class="p-3 font-medium text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              {allItems.map((item) => (
                <tr data-item={JSON.stringify(item)} style="border-top: 1px solid var(--color-border);">
                  <td class="p-3 font-medium">{item.title}</td>
                  <td class="p-3 text-right">
                    <div class="flex items-center justify-end gap-1">
                      <button class="edit-btn p-1.5 rounded-lg hover:bg-[rgb(5,179,77,0.1)]" title="Edit"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
                      <button class="del-btn p-1.5 rounded-lg hover:bg-[rgb(220,38,38,0.1)]" data-id={item.id} data-title={item.title} title="Delete"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #DC2626;"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {allItems.length === 0 && <div class="p-8 text-center text-sm" style="color: var(--color-muted);">No items yet.</div>}
      </div>
    </div>
    <div id="edit-panel" class="card p-6">
      <h3 id="form-title" class="font-bold mb-4">Create New Program</h3>
      <form id="cms-form" class="space-y-4">
        <input type="hidden" id="f-id" />
        <div><label class="block text-sm font-medium mb-1">Title</label><input id="f-title" class="input" required /></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-sm font-medium mb-1">Slug</label><input id="f-slug" class="input" /></div>
          <div><label class="block text-sm font-medium mb-1">Category</label><input id="f-category" class="input" /></div>
        </div>
        <div><label class="block text-sm font-medium mb-1">Description</label><textarea id="f-description" class="input" rows="4"></textarea></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-sm font-medium mb-1">Duration</label><input id="f-duration" class="input" /></div>
          <div><label class="block text-sm font-medium mb-1">Status</label><select id="f-status" class="input"><option value="open">Open</option><option value="closed">Closed</option></select></div>
        </div>
        <div class="flex gap-2 pt-2"><button type="submit" id="save-btn" class="btn btn-primary flex-1">Save</button><button type="button" id="cancel-btn" class="btn btn-ghost">Clear</button></div>
      </form>
    </div>
  </div>
  <script is:inline>
    (function() {
      var form = document.getElementById('cms-form');
      var editPanel = document.getElementById('edit-panel');
      var formTitle = document.getElementById('form-title');
      var saveBtn = document.getElementById('save-btn');
      document.getElementById('new-btn').addEventListener('click', function() {
        form.reset(); document.getElementById('f-id').value = '';
        formTitle.textContent = 'Create New Program'; saveBtn.textContent = 'Create';
        editPanel.scrollIntoView({ behavior: 'smooth' });
      });
      document.querySelectorAll('.edit-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var data = JSON.parse(btn.closest('tr').dataset.item);
          document.getElementById('f-id').value = data.id || '';
          document.getElementById('f-title').value = data.title || '';
          document.getElementById('f-slug').value = data.slug || '';
          document.getElementById('f-category').value = data.category || '';
          document.getElementById('f-description').value = data.description || '';
          document.getElementById('f-duration').value = data.duration || '';
          document.getElementById('f-status').value = data.status || 'open';
          formTitle.textContent = 'Edit: ' + data.title; saveBtn.textContent = 'Update';
          editPanel.scrollIntoView({ behavior: 'smooth' });
        });
      });
      document.querySelectorAll('.del-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var id = btn.dataset.id; var title = btn.dataset.title;
          if (window.showConfirm) {
            showConfirm('Delete "' + title + '"?', function() {
              fetch('/api/admin/school/programs?id=' + id, { method: 'DELETE' })
                .then(function(r) { return r.json(); })
                .then(function(d) { if (d.success || d.deleted) { showToast('Deleted!', 'success'); btn.closest('tr').remove(); } else { showToast('Failed', 'error'); } });
            }, 'Delete');
          }
        });
      });
      form.addEventListener('submit', async function(e) {
        e.preventDefault(); saveBtn.textContent = 'Saving...'; saveBtn.disabled = true;
        var body = {
          title: document.getElementById('f-title').value,
          slug: document.getElementById('f-slug').value,
          category: document.getElementById('f-category').value,
          description: document.getElementById('f-description').value,
          duration: document.getElementById('f-duration').value,
          status: document.getElementById('f-status').value,
        };
        var id = document.getElementById('f-id').value;
        var method = id ? 'PATCH' : 'POST';
        var url = '/api/admin/school/programs' + (id ? '?id=' + id : '');
        try {
          var res = await fetch(url, { method: method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
          var data = await res.json();
          if (res.ok) { showToast(id ? 'Updated!' : 'Created!', 'success'); setTimeout(function(){location.reload();}, 1000); }
          else { showToast(data.error || 'Failed', 'error'); }
        } catch { showToast('Network error', 'error'); }
        saveBtn.textContent = id ? 'Update' : 'Create'; saveBtn.disabled = false;
      });
      document.getElementById('cancel-btn').addEventListener('click', function() {
        form.reset(); document.getElementById('f-id').value = '';
        formTitle.textContent = 'Create New Program'; saveBtn.textContent = 'Create';
      });
    })();
  </script>
</AdminLayout>
