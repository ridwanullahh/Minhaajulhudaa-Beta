---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';

const result = await lightbase.query('school_classes', {
  sort: 'name:asc',
  limit: 100,
});
const classes = result.data || [];
---

<AdminLayout title="Class Management" platform="school" section="classes">
  <div class="flex items-center justify-between mb-6 fade-in">
    <div>
      <h2 class="text-lg font-bold">Classes</h2>
      <p class="text-sm" style="color: var(--color-muted);">{classes.length} total classes</p>
    </div>
    <button id="toggle-form-btn" class="btn btn-primary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      Add Class
    </button>
  </div>

  <!-- Create Form -->
  <div id="create-form" class="hidden card p-6 mb-6">
    <h3 class="font-bold mb-4">Add New Class</h3>
    <form id="class-form" class="space-y-4">
      <div class="grid md:grid-cols-2 gap-4">
        <div><label class="block text-sm font-medium mb-1" for="c-name">Class Name</label><input id="c-name" name="name" class="input" required /></div>
        <div><label class="block text-sm font-medium mb-1" for="c-slug">Slug</label><input id="c-slug" name="slug" class="input" /></div>
      </div>
      <div class="grid md:grid-cols-3 gap-4">
        <div><label class="block text-sm font-medium mb-1" for="c-level">Level</label>
          <select id="c-level" name="level" class="input"><option value="primary">Primary</option><option value="secondary">Secondary</option><option value="senior">Senior</option></select></div>
        <div><label class="block text-sm font-medium mb-1" for="c-teacher">Teacher</label><input id="c-teacher" name="teacherName" class="input" /></div>
        <div><label class="block text-sm font-medium mb-1" for="c-capacity">Capacity</label><input id="c-capacity" name="capacity" class="input" type="number" /></div>
      </div>
      <div class="grid md:grid-cols-2 gap-4">
        <div><label class="block text-sm font-medium mb-1" for="c-schedule">Schedule</label><input id="c-schedule" name="schedule" class="input" placeholder="e.g. Mon-Fri 8:00-10:00" /></div>
        <div><label class="block text-sm font-medium mb-1" for="c-room">Room</label><input id="c-room" name="room" class="input" /></div>
      </div>
      <div><label class="block text-sm font-medium mb-1" for="c-desc">Description</label><textarea id="c-desc" name="description" class="input" rows="3"></textarea></div>
      <div class="flex gap-3">
        <button type="submit" class="btn btn-primary">Add Class</button>
        <button type="button" id="cancel-form-btn" class="btn btn-ghost">Cancel</button>
      </div>
    </form>
  </div>

  <!-- Classes Table -->
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr class="text-left" style="background: var(--color-background); color: var(--color-muted);">
          <th class="p-4 font-medium">Name</th>
          <th class="p-4 font-medium hidden md:table-cell">Level</th>
          <th class="p-4 font-medium hidden sm:table-cell">Teacher</th>
          <th class="p-4 font-medium hidden lg:table-cell">Schedule</th>
          <th class="p-4 font-medium hidden lg:table-cell">Enrollment</th>
          <th class="p-4 font-medium text-right">Actions</th>
        </tr></thead>
        <tbody>
          {classes.map((c: any) => (
            <tr style="border-top: 1px solid var(--color-border);">
              <td class="p-4 font-medium">{c.name}</td>
              <td class="p-4 hidden md:table-cell"><span class="badge badge-accent">{c.level || '-'}</span></td>
              <td class="p-4 hidden sm:table-cell" style="color: var(--color-muted);">{c.teacherName || '-'}</td>
              <td class="p-4 hidden lg:table-cell" style="color: var(--color-muted);">{c.schedule || '-'}</td>
              <td class="p-4 hidden lg:table-cell" style="color: var(--color-muted);">{c.currentEnrollment || 0}/{c.capacity || '-'}</td>
              <td class="p-4 text-right">
                <button class="text-xs font-medium mr-3" style="color: var(--color-primary);" data-edit-class={c.id}>Edit</button>
                <button class="text-xs font-medium" style="color: #DC2626;" data-delete-class={c.id}>Delete</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {classes.length === 0 && <div class="p-8 text-center text-sm" style="color: var(--color-muted);">No classes created yet.</div>}
  </div>

  <script>
    const toggleBtn = document.getElementById('toggle-form-btn');
    const cancelBtn = document.getElementById('cancel-form-btn');
    const createForm = document.getElementById('create-form');
    toggleBtn?.addEventListener('click', () => createForm?.classList.toggle('hidden'));
    cancelBtn?.addEventListener('click', () => createForm?.classList.add('hidden'));

    // Auto-slug
    const nameInput = document.getElementById('c-name') as HTMLInputElement;
    const slugInput = document.getElementById('c-slug') as HTMLInputElement;
    nameInput?.addEventListener('input', () => {
      slugInput.value = nameInput.value.toLowerCase().trim().replace(/[^\w\s-]/g, '').replace(/[\s_]+/g, '-').replace(/^-+|-+$/g, '');
    });

    document.getElementById('class-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const body: Record<string, any> = {};
      fd.forEach((v, k) => { body[k] = v; });
      body.capacity = parseInt(body.capacity) || 30;
      body.currentEnrollment = 0;
      body.active = true;
      try {
        const res = await fetch('/api/admin/school/content', { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-collection': 'school_classes' }, body: JSON.stringify(body) });
        if (res.ok) window.location.reload(); else { const err = await res.json(); alert(err.error || 'Failed'); }
      } catch { alert('Network error'); }
    });
  </script>
</AdminLayout>
