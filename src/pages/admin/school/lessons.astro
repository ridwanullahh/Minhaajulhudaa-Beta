---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';
import RichTextEditor from '../../../components/RichTextEditor.astro';

const [lessonsResult, coursesResult] = await Promise.all([
  lightbase.query('school_lessons', { sort: 'order:asc,title:asc', limit: 200 }),
  lightbase.query('school_courses', { sort: 'title:asc', limit: 100 }),
]);
const lessons = lessonsResult.data || [];
const courses = coursesResult.data || [];
const courseMap = new Map<string, string>((courses as any[]).map((c: any) => [c.id, c.title]));
---

<AdminLayout title="LMS Lesson Management" platform="school" section="lessons">
  <div class="flex items-center justify-between mb-6 fade-in">
    <div>
      <h2 class="text-lg font-bold">Lessons</h2>
      <p class="text-sm" style="color: var(--color-muted);">{lessons.length} lessons across {courses.length} courses</p>
    </div>
    <button id="toggle-form-btn" class="btn btn-primary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      Add Lesson
    </button>
  </div>

  <!-- Create Form -->
  <div id="create-form" class="hidden card p-6 mb-6">
    <h3 class="font-bold mb-4">Add New Lesson</h3>
    <form id="lesson-form" class="space-y-4">
      <div class="grid md:grid-cols-2 gap-4">
        <div><label class="block text-sm font-medium mb-1" for="cr-title">Title</label><input id="cr-title" name="title" class="input" required /></div>
        <div><label class="block text-sm font-medium mb-1" for="cr-courseId">Course</label>
          <select id="cr-courseId" name="courseId" class="input" required>
            <option value="">Select Course</option>
            {courses.map((c: any) => <option value={c.id}>{c.title}</option>)}
          </select>
        </div>
      </div>
      <div class="grid md:grid-cols-3 gap-4">
        <div><label class="block text-sm font-medium mb-1" for="cr-lessonType">Type</label>
          <select id="cr-lessonType" name="lessonType" class="input">
            <option value="video">Video</option>
            <option value="text">Text</option>
            <option value="document">Document</option>
          </select>
        </div>
        <div><label class="block text-sm font-medium mb-1" for="cr-duration">Duration (mins)</label><input id="cr-duration" name="duration" class="input" type="number" min="0" value="0" /></div>
        <div><label class="block text-sm font-medium mb-1" for="cr-order">Order</label><input id="cr-order" name="order" class="input" type="number" min="0" value="0" /></div>
      </div>
      <div><label class="block text-sm font-medium mb-1" for="cr-videoUrl">Video URL</label><input id="cr-videoUrl" name="videoUrl" class="input" placeholder="https://..." /></div>
      <div><label class="block text-sm font-medium mb-1" for="cr-content">Content</label><RichTextEditor id="cr-content" name="content" label="" rows={8} placeholder="Lesson content in Markdown..." /></div>
      <div class="flex items-center gap-2">
        <input id="cr-isPublished" name="isPublished" type="checkbox" class="w-4 h-4" />
        <label for="cr-isPublished" class="text-sm font-medium">Published</label>
      </div>
      <div class="flex gap-3">
        <button type="submit" class="btn btn-primary">Create Lesson</button>
        <button type="button" id="cancel-form-btn" class="btn btn-ghost">Cancel</button>
      </div>
    </form>
  </div>

  <!-- Edit Modal -->
  <div id="edit-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center" style="background: rgba(0,0,0,0.5);">
    <div class="card p-6 w-full max-w-2xl mx-4 max-h-[90vh] overflow-y-auto">
      <h3 class="font-bold mb-4">Edit Lesson</h3>
      <form id="edit-form" class="space-y-4">
        <input type="hidden" id="ed-id" name="id" />
        <div class="grid md:grid-cols-2 gap-4">
          <div><label class="block text-sm font-medium mb-1" for="ed-title">Title</label><input id="ed-title" name="title" class="input" required /></div>
          <div><label class="block text-sm font-medium mb-1" for="ed-courseId">Course</label>
            <select id="ed-courseId" name="courseId" class="input" required>
              <option value="">Select Course</option>
              {courses.map((c: any) => <option value={c.id}>{c.title}</option>)}
            </select>
          </div>
        </div>
        <div class="grid md:grid-cols-3 gap-4">
          <div><label class="block text-sm font-medium mb-1" for="ed-lessonType">Type</label>
            <select id="ed-lessonType" name="lessonType" class="input">
              <option value="video">Video</option>
              <option value="text">Text</option>
              <option value="document">Document</option>
            </select>
          </div>
          <div><label class="block text-sm font-medium mb-1" for="ed-duration">Duration (mins)</label><input id="ed-duration" name="duration" class="input" type="number" min="0" /></div>
          <div><label class="block text-sm font-medium mb-1" for="ed-order">Order</label><input id="ed-order" name="order" class="input" type="number" min="0" /></div>
        </div>
        <div><label class="block text-sm font-medium mb-1" for="ed-videoUrl">Video URL</label><input id="ed-videoUrl" name="videoUrl" class="input" placeholder="https://..." /></div>
        <div><label class="block text-sm font-medium mb-1" for="ed-content">Content</label><RichTextEditor id="ed-content" name="content" label="" rows={8} placeholder="Lesson content in Markdown..." /></div>
        <div class="flex items-center gap-2">
          <input id="ed-isPublished" name="isPublished" type="checkbox" class="w-4 h-4" />
          <label for="ed-isPublished" class="text-sm font-medium">Published</label>
        </div>
        <div class="flex gap-3">
          <button type="submit" class="btn btn-primary">Update Lesson</button>
          <button type="button" id="cancel-edit-btn" class="btn btn-ghost">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Lessons Table -->
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr class="text-left" style="background: var(--color-background); color: var(--color-muted);">
          <th class="p-4 font-medium">Title</th>
          <th class="p-4 font-medium hidden md:table-cell">Course</th>
          <th class="p-4 font-medium hidden sm:table-cell">Type</th>
          <th class="p-4 font-medium hidden lg:table-cell">Duration</th>
          <th class="p-4 font-medium hidden lg:table-cell">Order</th>
          <th class="p-4 font-medium text-right">Published</th>
          <th class="p-4 font-medium text-right">Actions</th>
        </tr></thead>
        <tbody>
          {lessons.map((l: any) => (
            <tr style="border-top: 1px solid var(--color-border);">
              <td class="p-4 font-medium">{l.title}</td>
              <td class="p-4 hidden md:table-cell"><span class="badge badge-accent">{courseMap.get(l.courseId) || '-'}</span></td>
              <td class="p-4 hidden sm:table-cell" style="color: var(--color-muted);">{l.lessonType || '-'}</td>
              <td class="p-4 hidden lg:table-cell" style="color: var(--color-muted);">{l.duration ? l.duration + ' min' : '-'}</td>
              <td class="p-4 hidden lg:table-cell" style="color: var(--color-muted);">{l.order ?? '-'}</td>
              <td class="p-4 text-right"><span class={l.isPublished ? 'badge badge-primary' : 'badge badge-accent'}>{l.isPublished ? 'Yes' : 'No'}</span></td>
              <td class="p-4 text-right">
                <button class="text-xs font-medium mr-3" style="color: var(--color-primary);" data-edit-lesson={l.id}>Edit</button>
                <button class="text-xs font-medium" style="color: #DC2626;" data-delete-lesson={l.id}>Delete</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {lessons.length === 0 && <div class="p-8 text-center text-sm" style="color: var(--color-muted);">No lessons created yet.</div>}
  </div>

  <script define:vars={{ lessons }}>
    const toggleBtn = document.getElementById('toggle-form-btn');
    const cancelBtn = document.getElementById('cancel-form-btn');
    const createForm = document.getElementById('create-form');
    toggleBtn?.addEventListener('click', () => createForm?.classList.toggle('hidden'));
    cancelBtn?.addEventListener('click', () => createForm?.classList.add('hidden'));

    document.getElementById('lesson-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const body: Record<string, any> = {};
      fd.forEach((v, k) => {
        if (k === 'isPublished') { body[k] = (v as string) === 'on'; return; }
        if (k === 'duration' || k === 'order') { body[k] = parseFloat(v as string) || 0; return; }
        body[k] = v;
      });
      try {
        const res = await fetch('/api/admin/school/lessons', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        if (res.ok) window.location.reload(); else { const err = await res.json(); showToast(err.error || 'Failed', 'error'); }
      } catch { showToast('Network error', 'error'); }
    });

    document.querySelectorAll('[data-delete-lesson]').forEach(btn => {
      btn.addEventListener('click', async () => {
        showConfirm('Delete this lesson?', async function() {        const id = btn.getAttribute('data-delete-lesson');
          try {
            const res = await fetch(`/api/admin/school/lessons?id=${id}`, { method: 'DELETE' });
            if (res.ok) window.location.reload(); else showToast('Failed', 'error');
          } catch { showToast('Network error', 'error'); }
        });
      });
    });

    const editModal = document.getElementById('edit-modal');
    const cancelEditBtn = document.getElementById('cancel-edit-btn');
    cancelEditBtn?.addEventListener('click', () => editModal?.classList.add('hidden'));
    editModal?.addEventListener('click', (e) => { if (e.target === editModal) editModal.classList.add('hidden'); });

    document.querySelectorAll('[data-edit-lesson]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-edit-lesson');
        const item = lessons.find((l: any) => l.id === id);
        if (!item) return;
        (document.getElementById('ed-id') as HTMLInputElement).value = item.id;
        (document.getElementById('ed-title') as HTMLInputElement).value = item.title || '';
        (document.getElementById('ed-courseId') as HTMLSelectElement).value = item.courseId || '';
        (document.getElementById('ed-lessonType') as HTMLSelectElement).value = item.lessonType || 'video';
        (document.getElementById('ed-duration') as HTMLInputElement).value = item.duration || 0;
        (document.getElementById('ed-order') as HTMLInputElement).value = item.order || 0;
        (document.getElementById('ed-videoUrl') as HTMLInputElement).value = item.videoUrl || '';
        (document.getElementById('ed-content') as HTMLTextAreaElement).value = item.content || '';
        (document.getElementById('ed-isPublished') as HTMLInputElement).checked = !!item.isPublished;
        editModal?.classList.remove('hidden');
      });
    });

    document.getElementById('edit-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const body: Record<string, any> = {};
      fd.forEach((v, k) => {
        if (k === 'isPublished') { body[k] = (v as string) === 'on'; return; }
        if (k === 'duration' || k === 'order') { body[k] = parseFloat(v as string) || 0; return; }
        if (k === 'id') return;
        body[k] = v;
      });
      const id = (document.getElementById('ed-id') as HTMLInputElement).value;
      try {
        const res = await fetch(`/api/admin/school/lessons?id=${id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        if (res.ok) window.location.reload(); else { const err = await res.json(); showToast(err.error || 'Failed', 'error'); }
      } catch { showToast('Network error', 'error'); }
    });
  </script>
</AdminLayout>
