---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';

let submissions: any[] = [];
try {
  const result = await lightbase.query('contact_submissions', { sort: '_created_at:desc', limit: 50 });
  submissions = result.data || [];
} catch (err) {
  console.error('[admin/contacts-messages] fetch error:', err);
}
---

<AdminLayout title="Contact Messages" platform="school" section="content">
  <div class="fade-in">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-lg font-bold">Contact Messages</h2>
        <p class="text-sm" style="color: var(--color-muted);">{submissions.length} messages received</p>
      </div>
      <button id="refresh-btn" class="btn btn-outline text-sm">Refresh</button>
    </div>

    <div id="messages-list" class="space-y-3">
      {submissions.length === 0 ? (
        <div class="card p-8 text-center">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto mb-4" style="color: var(--color-muted);">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          <p style="color: var(--color-muted);">No messages yet.</p>
        </div>
      ) : (
        submissions.map((msg: any) => (
          <div class="card p-5" data-id={msg.id}>
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="font-bold text-sm">{msg.name}</span>
                  {msg.status === 'new' && <span class="badge badge-accent text-xs">New</span>}
                  {msg.status === 'read' && <span class="badge text-xs">Read</span>}
                  {msg.status === 'replied' && <span class="badge badge-primary text-xs">Replied</span>}
                </div>
                <div class="text-xs" style="color: var(--color-muted);">
                  <span>{msg.email}</span>
                  {msg.phone && <span> | {msg.phone}</span>}
                  <span> | {new Date(msg.createdAt || msg._created_at).toLocaleString()}</span>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <button class="reply-btn btn btn-ghost text-xs" data-id={msg.id} data-email={msg.email} data-name={msg.name} data-subject={msg.subject} style="padding: 4px 8px; color: var(--color-primary);">Reply</button>
                <button class="mark-read-btn btn btn-ghost text-xs" data-id={msg.id} data-action="read" style="padding: 4px 8px;">Mark Read</button>
                <button class="delete-msg-btn btn btn-ghost text-xs" data-id={msg.id} data-action="delete" style="padding: 4px 8px; color: #DC2626;">Delete</button>
              </div>
            </div>
            <div class="mb-2">
              <span class="text-xs font-semibold" style="color: var(--color-primary);">Subject:</span>
              <span class="text-sm ml-1">{msg.subject}</span>
            </div>
            <p class="text-sm" style="color: var(--color-muted);">{msg.message}</p>
            {msg.platform && <div class="mt-2 text-xs" style="color: var(--color-muted);">Platform: {msg.platform}</div>}
          </div>
        ))
      )}
    </div>
  </div>

  <!-- Reply Modal -->
  <div id="reply-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4" style="background: rgb(0 0 0 / 0.5);">
    <div class="w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden" style="background: #FFFFFF; border: 1px solid var(--color-border);">
      <div class="p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-bold text-base" style="color: #181F25;">Reply to Message</h3>
          <button id="reply-close" class="w-8 h-8 rounded-lg flex items-center justify-center hover:bg-[rgb(0,0,0,0.05)]"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
        </div>
        <div id="reply-info" class="mb-4 p-3 rounded-lg text-sm" style="background: var(--color-background);">
          <div><strong>To:</strong> <span id="reply-to"></span></div>
          <div><strong>Subject:</strong> <span id="reply-subject"></span></div>
        </div>
        <form id="reply-form" class="space-y-3">
          <input type="hidden" id="reply-msg-id" />
          <input type="hidden" id="reply-email" />
          <div>
            <label class="block text-sm font-medium mb-1">Reply Message</label>
            <textarea id="reply-message" class="input" rows="6" required placeholder="Type your reply..."></textarea>
          </div>
          <div class="flex gap-2">
            <button type="submit" id="reply-send-btn" class="btn btn-primary flex-1">Send Reply</button>
            <button type="button" id="reply-cancel-btn" class="btn btn-ghost">Cancel</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div id="toast" class="hidden fixed bottom-6 right-6 px-4 py-3 rounded-lg text-sm font-medium text-white z-50" style="background: var(--color-primary);"></div>

  <script is:inline>
    function showToast(msg, type) {
      var toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.style.background = type === 'error' ? '#DC2626' : 'var(--color-primary)';
      toast.classList.remove('hidden');
      setTimeout(function() { toast.classList.add('hidden'); }, 3000);
    }

    document.querySelectorAll('.mark-read-btn').forEach(function(btn) {
      btn.addEventListener('click', async function() {
        var id = btn.getAttribute('data-id');
        try {
          var res = await fetch('/api/admin/settings/contact?action=mark_read&id=' + id, { method: 'POST' });
          if (res.ok) { showToast('Marked as read'); setTimeout(function() { location.reload(); }, 1000); }
        } catch { showToast('Error', 'error'); }
      });
    });

    document.querySelectorAll('.delete-msg-btn').forEach(function(btn) {
      btn.addEventListener('click', async function() {
        if (!confirm('Delete this message?')) return;
        var id = btn.getAttribute('data-id');
        try {
          var res = await fetch('/api/admin/settings/contact?action=delete&id=' + id, { method: 'DELETE' });
          if (res.ok) { showToast('Deleted'); btn.closest('.card').remove(); }
        } catch { showToast('Error', 'error'); }
      });
    });

    document.getElementById('refresh-btn')?.addEventListener('click', function() { location.reload(); });

    // Reply feature
    var replyModal = document.getElementById('reply-modal');
    document.querySelectorAll('.reply-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var email = btn.dataset.email;
        var name = btn.dataset.name;
        var subject = btn.dataset.subject;
        var id = btn.dataset.id;
        document.getElementById('reply-msg-id').value = id;
        document.getElementById('reply-email').value = email;
        document.getElementById('reply-to').textContent = name + ' <' + email + '>';
        document.getElementById('reply-subject').textContent = 'Re: ' + subject;
        document.getElementById('reply-message').value = '';
        replyModal.classList.remove('hidden');
      });
    });

    document.getElementById('reply-close')?.addEventListener('click', function() { replyModal.classList.add('hidden'); });
    document.getElementById('reply-cancel-btn')?.addEventListener('click', function() { replyModal.classList.add('hidden'); });

    document.getElementById('reply-form')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      var sendBtn = document.getElementById('reply-send-btn');
      sendBtn.textContent = 'Sending...'; sendBtn.disabled = true;
      var id = document.getElementById('reply-msg-id').value;
      var email = document.getElementById('reply-email').value;
      var message = document.getElementById('reply-message').value;
      try {
        var res = await fetch('/api/admin/settings/contact?action=reply', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: id, email: email, message: message })
        });
        var data = await res.json();
        if (res.ok) {
          showToast('Reply sent successfully!', 'success');
          replyModal.classList.add('hidden');
          // Update status to replied
          var card = document.querySelector('[data-id="' + id + '"]');
          if (card) {
            var badge = card.querySelector('.badge');
            if (badge) { badge.textContent = 'Replied'; badge.className = 'badge badge-primary text-xs'; }
          }
        } else {
          showToast(data.error || 'Failed to send reply', 'error');
        }
      } catch(err) {
        showToast('Network error', 'error');
      }
      sendBtn.textContent = 'Send Reply'; sendBtn.disabled = false;
    });
  </script>
</AdminLayout>
