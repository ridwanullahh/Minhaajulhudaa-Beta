---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';

let submissions: any[] = [];
try {
  const result = await lightbase.query('contact_submissions', { sort: '_created_at:desc', limit: 50 });
  submissions = result.data || [];
} catch (err) {
  console.error('[admin/contacts-messages] fetch error:', err);
}
---

<AdminLayout title="Contact Messages" platform="school" section="content">
  <div class="fade-in">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-lg font-bold">Contact Messages</h2>
        <p class="text-sm" style="color: var(--color-muted);">{submissions.length} messages received</p>
      </div>
      <button id="refresh-btn" class="btn btn-outline text-sm">Refresh</button>
    </div>

    <div id="messages-list" class="space-y-3">
      {submissions.length === 0 ? (
        <div class="card p-8 text-center">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto mb-4" style="color: var(--color-muted);">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          <p style="color: var(--color-muted);">No messages yet.</p>
        </div>
      ) : (
        submissions.map((msg: any) => (
          <div class="card p-5" data-id={msg.id}>
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="font-bold text-sm">{msg.name}</span>
                  {msg.status === 'new' && <span class="badge badge-accent text-xs">New</span>}
                  {msg.status === 'read' && <span class="badge text-xs">Read</span>}
                  {msg.status === 'replied' && <span class="badge badge-primary text-xs">Replied</span>}
                </div>
                <div class="text-xs" style="color: var(--color-muted);">
                  <span>{msg.email}</span>
                  {msg.phone && <span> | {msg.phone}</span>}
                  <span> | {new Date(msg.createdAt || msg._created_at).toLocaleString()}</span>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <button class="mark-read-btn btn btn-ghost text-xs" data-id={msg.id} data-action="read" style="padding: 4px 8px;">Mark Read</button>
                <button class="delete-msg-btn btn btn-ghost text-xs" data-id={msg.id} data-action="delete" style="padding: 4px 8px; color: #DC2626;">Delete</button>
              </div>
            </div>
            <div class="mb-2">
              <span class="text-xs font-semibold" style="color: var(--color-primary);">Subject:</span>
              <span class="text-sm ml-1">{msg.subject}</span>
            </div>
            <p class="text-sm" style="color: var(--color-muted);">{msg.message}</p>
            {msg.platform && <div class="mt-2 text-xs" style="color: var(--color-muted);">Platform: {msg.platform}</div>}
          </div>
        ))
      )}
    </div>
  </div>

  <div id="toast" class="hidden fixed bottom-6 right-6 px-4 py-3 rounded-lg text-sm font-medium text-white z-50" style="background: var(--color-primary);"></div>

  <script is:inline>
    function showToast(msg, type) {
      var toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.style.background = type === 'error' ? '#DC2626' : 'var(--color-primary)';
      toast.classList.remove('hidden');
      setTimeout(function() { toast.classList.add('hidden'); }, 3000);
    }

    document.querySelectorAll('.mark-read-btn').forEach(function(btn) {
      btn.addEventListener('click', async function() {
        var id = btn.getAttribute('data-id');
        try {
          var res = await fetch('/api/admin/settings/contact?action=mark_read&id=' + id, { method: 'POST' });
          if (res.ok) { showToast('Marked as read'); setTimeout(function() { location.reload(); }, 1000); }
        } catch { showToast('Error', 'error'); }
      });
    });

    document.querySelectorAll('.delete-msg-btn').forEach(function(btn) {
      btn.addEventListener('click', async function() {
        if (!confirm('Delete this message?')) return;
        var id = btn.getAttribute('data-id');
        try {
          var res = await fetch('/api/admin/settings/contact?action=delete&id=' + id, { method: 'DELETE' });
          if (res.ok) { showToast('Deleted'); btn.closest('.card').remove(); }
        } catch { showToast('Error', 'error'); }
      });
    });

    document.getElementById('refresh-btn')?.addEventListener('click', function() { location.reload(); });
  </script>
</AdminLayout>
