---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';
import { generateCSRFToken } from '../../../lib/utils';
import { slugify } from '../../../lib/utils';

const posts = await lightbase.query('school_blog_posts', { sort: 'publishedAt:desc', limit: 100 });
const allPosts = posts.data || [];
const csrfToken = generateCSRFToken();
---

<AdminLayout title="Blog Management" platform="school" section="blog">
  <div class="mb-6 fade-in">
    <h2 class="text-lg font-bold">Blog Posts</h2>
    <p class="text-sm" style="color: var(--color-muted);">{allPosts.length} total posts</p>
  </div>

  <!-- Two-column layout: Listing (left) + Edit Form (right) -->
  <div class="grid lg:grid-cols-2 gap-6">
    <!-- LEFT: Listing -->
    <div>
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-bold text-sm">All Posts</h3>
        <button id="new-btn" class="btn btn-primary text-sm">New Post</button>
      </div>
      <div class="card overflow-hidden">
        <div class="overflow-x-auto max-h-[600px] overflow-y-auto">
          <table class="w-full text-sm">
            <thead class="sticky top-0" style="background: var(--color-background);">
              <tr class="text-left" style="color: var(--color-muted);">
                <th class="p-3 font-medium">Title</th>
                <th class="p-3 font-medium hidden sm:table-cell">Status</th>
                <th class="p-3 font-medium text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              {allPosts.map((post) => (
                <tr class="cms-row" data-post={JSON.stringify(post)} style="border-top: 1px solid var(--color-border);">
                  <td class="p-3 font-medium">{post.title}</td>
                  <td class="p-3 hidden sm:table-cell"><span class={post.status === 'published' ? 'badge badge-primary' : 'badge badge-accent'}>{post.status}</span></td>
                  <td class="p-3 text-right">
                    <div class="flex items-center justify-end gap-1">
                      <button class="edit-btn p-1.5 rounded-lg hover:bg-[rgb(5,179,77,0.1)]" data-id={post.id} title="Edit" aria-label="Edit">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                      </button>
                      <button class="del-btn p-1.5 rounded-lg hover:bg-[rgb(220,38,38,0.1)]" data-id={post.id} data-title={post.title} title="Delete" aria-label="Delete">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #DC2626;"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {allPosts.length === 0 && <div class="p-8 text-center text-sm" style="color: var(--color-muted);">No posts yet.</div>}
      </div>
    </div>

    <!-- RIGHT: Edit/Create Form -->
    <div id="edit-panel" class="card p-6">
      <h3 id="form-title" class="font-bold mb-4">Create New Post</h3>
      <form id="cms-form" class="space-y-4">
        <input type="hidden" id="f-id" name="id" />
        <div>
          <label class="block text-sm font-medium mb-1">Title</label>
          <input id="f-title" name="title" class="input" required placeholder="Post title" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium mb-1">Slug</label>
            <input id="f-slug" name="slug" class="input" placeholder="auto-generated" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Category</label>
            <input id="f-category" name="category" class="input" placeholder="e.g. announcements" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Excerpt</label>
          <textarea id="f-excerpt" name="excerpt" class="input" rows="2" placeholder="Brief summary"></textarea>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Content (Markdown)</label>
          <textarea id="f-content" name="content" class="input" rows="8" placeholder="Write post content in Markdown..."></textarea>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium mb-1">Author</label>
            <input id="f-author" name="authorName" class="input" placeholder="Author name" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Status</label>
            <select id="f-status" name="status" class="input">
              <option value="draft">Draft</option>
              <option value="published">Published</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Featured Image URL</label>
          <input id="f-image" name="featuredImageUrl" class="input" placeholder="/images/patterns/..." />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Tags (comma-separated)</label>
          <input id="f-tags" name="tags" class="input" placeholder="tag1, tag2" />
        </div>
        <div class="flex gap-2 pt-2">
          <button type="submit" id="save-btn" class="btn btn-primary flex-1">Save Post</button>
          <button type="button" id="cancel-btn" class="btn btn-ghost">Clear</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    (function() {
      var form = document.getElementById('cms-form');
      var editPanel = document.getElementById('edit-panel');
      var formTitle = document.getElementById('form-title');
      var saveBtn = document.getElementById('save-btn');

      // New button
      document.getElementById('new-btn').addEventListener('click', function() {
        form.reset();
        document.getElementById('f-id').value = '';
        formTitle.textContent = 'Create New Post';
        saveBtn.textContent = 'Create Post';
        editPanel.scrollIntoView({ behavior: 'smooth' });
      });

      // Auto-slug
      document.getElementById('f-title').addEventListener('input', function() {
        if (!document.getElementById('f-slug').value) {
          document.getElementById('f-slug').value = this.value.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-');
        }
      });

      // Edit buttons
      document.querySelectorAll('.edit-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var row = btn.closest('tr');
          var postData = JSON.parse(row.dataset.post);
          document.getElementById('f-id').value = postData.id || '';
          document.getElementById('f-title').value = postData.title || '';
          document.getElementById('f-slug').value = postData.slug || '';
          document.getElementById('f-category').value = postData.category || '';
          document.getElementById('f-excerpt').value = postData.excerpt || '';
          document.getElementById('f-content').value = postData.content || '';
          document.getElementById('f-author').value = postData.authorName || '';
          document.getElementById('f-status').value = postData.status || 'draft';
          document.getElementById('f-image').value = postData.featuredImageUrl || '';
          document.getElementById('f-tags').value = (postData.tags || []).join(', ');
          formTitle.textContent = 'Edit: ' + postData.title;
          saveBtn.textContent = 'Update Post';
          editPanel.scrollIntoView({ behavior: 'smooth' });
        });
      });

      // Delete buttons
      document.querySelectorAll('.del-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var id = btn.dataset.id;
          var title = btn.dataset.title;
          if (window.showConfirm) {
            showConfirm('Delete "' + title + '"? This cannot be undone.', function() {
              fetch('/api/admin/school/blog?id=' + id, { method: 'DELETE' })
                .then(function(r) { return r.json(); })
                .then(function(d) {
                  if (d.success || d.deleted) {
                    if (window.showToast) showToast('Post deleted!', 'success');
                    btn.closest('tr').remove();
                  } else {
                    if (window.showToast) showToast('Delete failed', 'error');
                  }
                })
                .catch(function() { if (window.showToast) showToast('Network error', 'error'); });
            }, 'Delete Post');
          } else {
            if (confirm('Delete "' + title + '"?')) {
              fetch('/api/admin/school/blog?id=' + id, { method: 'DELETE' })
                .then(function(r) { return r.json(); })
                .then(function(d) {
                  if (d.success || d.deleted) { btn.closest('tr').remove(); }
                });
            }
          }
        });
      });

      // Form submit
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        saveBtn.textContent = 'Saving...';
        saveBtn.disabled = true;

        var tagsStr = document.getElementById('f-tags').value;
        var tags = tagsStr ? tagsStr.split(',').map(function(t) { return t.trim(); }).filter(Boolean) : [];

        var body = {
          title: document.getElementById('f-title').value,
          slug: document.getElementById('f-slug').value || document.getElementById('f-title').value.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-'),
          category: document.getElementById('f-category').value,
          excerpt: document.getElementById('f-excerpt').value,
          content: document.getElementById('f-content').value,
          authorName: document.getElementById('f-author').value,
          status: document.getElementById('f-status').value,
          featuredImageUrl: document.getElementById('f-image').value,
          tags: tags,
        };

        var id = document.getElementById('f-id').value;
        var method = id ? 'PATCH' : 'POST';
        var url = '/api/admin/school/blog' + (id ? '?id=' + id : '');

        try {
          var res = await fetch(url, { method: method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
          var data = await res.json();
          if (res.ok) {
            if (window.showToast) showToast(id ? 'Post updated!' : 'Post created!', 'success');
            setTimeout(function() { location.reload(); }, 1000);
          } else {
            if (window.showToast) showToast(data.error || 'Failed to save', 'error');
          }
        } catch(err) {
          if (window.showToast) showToast('Network error', 'error');
        }
        saveBtn.textContent = id ? 'Update Post' : 'Create Post';
        saveBtn.disabled = false;
      });

      // Cancel/Clear button
      document.getElementById('cancel-btn').addEventListener('click', function() {
        form.reset();
        document.getElementById('f-id').value = '';
        formTitle.textContent = 'Create New Post';
        saveBtn.textContent = 'Create Post';
      });
    })();
  </script>
</AdminLayout>
