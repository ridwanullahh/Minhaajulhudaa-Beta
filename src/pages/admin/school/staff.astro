---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';

const result = await lightbase.query('school_staff', {
  sort: 'lastName:asc',
  limit: 100,
});
const staff = result.data || [];
---

<AdminLayout title="Staff Management" platform="school" section="staff">
  <div class="flex items-center justify-between mb-6 fade-in">
    <div>
      <h2 class="text-lg font-bold">Staff</h2>
      <p class="text-sm" style="color: var(--color-muted);">{staff.length} total staff members</p>
    </div>
    <button id="toggle-form-btn" class="btn btn-primary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      Add Staff
    </button>
  </div>

  <!-- Create Form -->
  <div id="create-form" class="hidden card p-6 mb-6">
    <h3 class="font-bold mb-4">Add New Staff Member</h3>
    <form id="staff-form" class="space-y-4">
      <div class="grid md:grid-cols-3 gap-4">
        <div><label class="block text-sm font-medium mb-1" for="st-first">First Name</label><input id="st-first" name="firstName" class="input" required /></div>
        <div><label class="block text-sm font-medium mb-1" for="st-last">Last Name</label><input id="st-last" name="lastName" class="input" required /></div>
        <div><label class="block text-sm font-medium mb-1" for="st-role">Role</label><input id="st-role" name="role" class="input" placeholder="e.g. Teacher, Admin" /></div>
      </div>
      <div class="grid md:grid-cols-3 gap-4">
        <div><label class="block text-sm font-medium mb-1" for="st-subject">Subject</label><input id="st-subject" name="subject" class="input" /></div>
        <div><label class="block text-sm font-medium mb-1" for="st-email">Email</label><input id="st-email" name="email" class="input" type="email" /></div>
        <div><label class="block text-sm font-medium mb-1" for="st-phone">Phone</label><input id="st-phone" name="phone" class="input" /></div>
      </div>
      <div><label class="block text-sm font-medium mb-1" for="st-bio">Bio</label><textarea id="st-bio" name="bio" class="input" rows="3"></textarea></div>
      <div class="flex gap-3">
        <button type="submit" class="btn btn-primary">Add Staff</button>
        <button type="button" id="cancel-form-btn" class="btn btn-ghost">Cancel</button>
      </div>
    </form>
  </div>

  <!-- Staff Table -->
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr class="text-left" style="background: var(--color-background); color: var(--color-muted);">
          <th class="p-4 font-medium">Name</th>
          <th class="p-4 font-medium hidden md:table-cell">Role</th>
          <th class="p-4 font-medium hidden sm:table-cell">Subject</th>
          <th class="p-4 font-medium hidden lg:table-cell">Email</th>
          <th class="p-4 font-medium text-right">Actions</th>
        </tr></thead>
        <tbody>
          {staff.map((s: any) => (
            <tr style="border-top: 1px solid var(--color-border);">
              <td class="p-4 font-medium">{s.firstName} {s.lastName}</td>
              <td class="p-4 hidden md:table-cell" style="color: var(--color-muted);">{s.role || '-'}</td>
              <td class="p-4 hidden sm:table-cell" style="color: var(--color-muted);">{s.subject || '-'}</td>
              <td class="p-4 hidden lg:table-cell" style="color: var(--color-muted);">{s.email || '-'}</td>
              <td class="p-4 text-right">
                <button class="text-xs font-medium mr-3" style="color: var(--color-primary);" data-edit-staff={s.id}>Edit</button>
                <button class="text-xs font-medium" style="color: #DC2626;" data-delete-staff={s.id}>Delete</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {staff.length === 0 && <div class="p-8 text-center text-sm" style="color: var(--color-muted);">No staff members yet.</div>}
  </div>

  <script>
    const toggleBtn = document.getElementById('toggle-form-btn');
    const cancelBtn = document.getElementById('cancel-form-btn');
    const createForm = document.getElementById('create-form');
    toggleBtn?.addEventListener('click', () => createForm?.classList.toggle('hidden'));
    cancelBtn?.addEventListener('click', () => createForm?.classList.add('hidden'));

    document.getElementById('staff-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const body: Record<string, string> = {};
      fd.forEach((v, k) => { body[k] = v as string; });
      try {
        const res = await fetch('/api/admin/school/content', { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-collection': 'school_staff' }, body: JSON.stringify(body) });
        if (res.ok) window.location.reload(); else { const err = await res.json(); showToast(err.error || 'Failed', 'error'); }
      } catch { showToast('Network error', 'error'); }
    });
  </script>
</AdminLayout>
