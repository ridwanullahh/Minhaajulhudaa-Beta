---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { lightbase } from '../../../lib/lightbase';
const result = await lightbase.query('charity_testimonials', { sort: 'publishedAt', limit: 100 });
const allItems = result.data || [];
---
<AdminLayout title="Testimonials" platform="charity" section="testimonials">
  <div class="mb-6 fade-in"><h2 class="text-lg font-bold">Testimonials</h2><p class="text-sm" style="color: var(--color-muted);">{allItems.length} total</p></div>
  <div class="grid lg:grid-cols-2 gap-6">
    <div><div class="flex items-center justify-between mb-3"><h3 class="font-bold text-sm">All Items</h3><button id="new-btn" class="btn btn-primary text-sm">New</button></div>
      <div class="card overflow-hidden"><div class="max-h-[600px] overflow-y-auto"><table class="w-full text-sm"><thead class="sticky top-0" style="background: var(--color-background);"><tr class="text-left" style="color: var(--color-muted);"><th class="p-3 font-medium">Name</th><th class="p-3 font-medium text-right">Actions</th></tr></thead><tbody>{allItems.map((item) => (<tr data-item={JSON.stringify(item)} style="border-top: 1px solid var(--color-border);"><td class="p-3 font-medium">{item.authorName}</td><td class="p-3 text-right"><div class="flex items-center justify-end gap-1"><button class="edit-btn p-1.5 rounded-lg hover:bg-[rgb(5,179,77,0.1)]" title="Edit"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button><button class="del-btn p-1.5 rounded-lg hover:bg-[rgb(220,38,38,0.1)]" data-id={item.id} data-title={item.authorName} title="Delete"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #DC2626;"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button></div></td></tr>))}</tbody></table></div>{allItems.length === 0 && <div class="p-8 text-center text-sm" style="color: var(--color-muted);">No items yet.</div>}</div></div>
    <div id="edit-panel" class="card p-6"><h3 id="form-title" class="font-bold mb-4">Create New</h3><form id="cms-form" class="space-y-4"><input type="hidden" id="f-id" /><div><label class="block text-sm font-medium mb-1">Author Name</label><input id="f-authorName" class="input" required /></div><div class="grid grid-cols-2 gap-3"><div><label class="block text-sm font-medium mb-1">Role</label><input id="f-role" class="input" /></div><div><label class="block text-sm font-medium mb-1">Rating</label><select id="f-rating" class="input"><option value="5">5 Stars</option><option value="4">4 Stars</option><option value="3">3 Stars</option></select></div></div><div><label class="block text-sm font-medium mb-1">Content</label><textarea id="f-content" class="input" rows="4"></textarea></div><div><label class="block text-sm font-medium mb-1">Status</label><select id="f-status" class="input"><option value="approved">Approved</option><option value="pending">Pending</option></select></div><div class="flex gap-2 pt-2"><button type="submit" id="save-btn" class="btn btn-primary flex-1">Save</button><button type="button" id="cancel-btn" class="btn btn-ghost">Clear</button></div></form></div>
  </div>
  <script is:inline>(function(){var f=document.getElementById('cms-form'),p=document.getElementById('edit-panel'),t=document.getElementById('form-title'),s=document.getElementById('save-btn');document.getElementById('new-btn').addEventListener('click',function(){f.reset();document.getElementById('f-id').value='';t.textContent='Create New';s.textContent='Create';p.scrollIntoView({behavior:'smooth'});});document.querySelectorAll('.edit-btn').forEach(function(b){b.addEventListener('click',function(){var d=JSON.parse(b.closest('tr').dataset.item);document.getElementById('f-id').value=d.id||'';document.getElementById('f-authorName').value=d.authorName||'';document.getElementById('f-role').value=d.role||'';document.getElementById('f-rating').value=d.rating||5;document.getElementById('f-content').value=d.content||'';document.getElementById('f-status').value=d.status||'approved';t.textContent='Edit: '+d.authorName;s.textContent='Update';p.scrollIntoView({behavior:'smooth'});});});document.querySelectorAll('.del-btn').forEach(function(b){b.addEventListener('click',function(){var id=b.dataset.id,title=b.dataset.title;if(window.showConfirm){showConfirm('Delete "'+title+'"?',function(){fetch('/api/admin/charity/testimonials?id='+id,{method:'DELETE'}).then(function(r){return r.json();}).then(function(d){if(d.success||d.deleted){showToast('Deleted!','success');b.closest('tr').remove();}else{showToast('Failed','error');}});},'Delete');}});});f.addEventListener('submit',async function(e){e.preventDefault();s.textContent='Saving...';s.disabled=true;var b={authorName:document.getElementById('f-authorName').value,role:document.getElementById('f-role').value,rating:parseInt(document.getElementById('f-rating').value)||5,content:document.getElementById('f-content').value,status:document.getElementById('f-status').value};var id=document.getElementById('f-id').value;var m=id?'PATCH':'POST';var u='/api/admin/charity/testimonials'+(id?'?id='+id:'');try{var r=await fetch(u,{method:m,headers:{'Content-Type':'application/json'},body:JSON.stringify(b)});var d=await r.json();if(r.ok){showToast(id?'Updated!':'Created!','success');setTimeout(function(){location.reload();},1000);}else{showToast(d.error||'Failed','error');}}catch{showToast('Network error','error');}s.textContent=id?'Update':'Create';s.disabled=false;});document.getElementById('cancel-btn').addEventListener('click',function(){f.reset();document.getElementById('f-id').value='';t.textContent='Create New';s.textContent='Create';});})();</script>
</AdminLayout>
