---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';

export async function getStaticPaths() {
  try {
    const result = await lightbase.query('travels_packages', {
      filter: { field: 'category', op: 'eq', value: 'tour' },
      limit: 100,
    });
    return (result.data || []).filter(doc => doc.slug).map(doc => ({ params: { slug: doc.slug }, props: { pkg: doc } }));
  } catch { return []; }
}

const { pkg } = Astro.props;

let itineraries: any[] = [];
try {
  const itinResult = await lightbase.query('travels_itineraries', {
    filter: { field: 'packageId', op: 'eq', value: pkg.id },
    sort: 'day:asc',
    limit: 30,
  });
  itineraries = itinResult.data || [];
} catch {}
---
export const prerender = true;

<PlatformLayout title={`${pkg.title} - Minhaajulhudaa Travels`} platform="travels">
  <section class="container-app py-12 max-w-4xl">
    <a href="/travels/tours" class="text-sm font-medium mb-6 inline-flex items-center gap-1" style="color: var(--color-primary);">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      All Tours
    </a>

    {pkg.imageUrl && <img src={pkg.imageUrl} alt={pkg.title} class="w-full aspect-[16/9] object-cover rounded-2xl mb-8" />}

    <div class="grid md:grid-cols-3 gap-8">
      <div class="md:col-span-2">
        <div class="flex gap-2 mb-4">
          <span class="badge badge-primary">{pkg.type ? pkg.type.replace(/-/g, ' ') : 'Tour'}</span>
          {pkg.tier && <span class="badge badge-accent uppercase">{pkg.tier}</span>}
          {pkg.isFeatured && <span class="badge" style="background: var(--color-accent); color: var(--color-brand-dark);">Featured</span>}
        </div>
        <h1 class="text-2xl md:text-3xl font-extrabold mb-4">{pkg.title}</h1>
        <p class="text-lg mb-6" style="color: var(--color-muted);">{pkg.description}</p>

        <!-- Inclusions -->
        {pkg.inclusions && pkg.inclusions.length > 0 && (
          <div class="mb-8">
            <h2 class="text-xl font-bold mb-4">What's Included</h2>
            <div class="grid md:grid-cols-2 gap-2">
              {pkg.inclusions.map((item: string) => (
                <div class="flex items-start gap-2 text-sm">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);" class="shrink-0 mt-0.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Exclusions -->
        {pkg.exclusions && pkg.exclusions.length > 0 && (
          <div class="mb-8">
            <h2 class="text-xl font-bold mb-4">Not Included</h2>
            <div class="grid md:grid-cols-2 gap-2">
              {pkg.exclusions.map((item: string) => (
                <div class="flex items-start gap-2 text-sm">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-muted);" class="shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                  <span style="color: var(--color-muted);">{item}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Itinerary -->
        {itineraries.length > 0 && (
          <div class="mb-8">
            <h2 class="text-xl font-bold mb-4">Itinerary</h2>
            <div class="space-y-4">
              {itineraries.map((day) => (
                <div class="card p-5">
                  <div class="flex items-center gap-3 mb-2">
                    <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm shrink-0" style="background: var(--color-primary); color: white;">
                      Day {day.day}
                    </div>
                    <h3 class="font-bold">{day.title}</h3>
                  </div>
                  <p class="text-sm mb-3" style="color: var(--color-muted);">{day.description}</p>
                  {day.activities && day.activities.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {day.activities.map((act: string) => <span class="badge" style="background: rgb(5,179,77,0.1); color: var(--color-primary);">{act}</span>)}
                    </div>
                  )}
                  <div class="text-xs mt-2" style="color: var(--color-muted);">
                    {day.meals && day.meals.length > 0 && <span>Meals: {day.meals.join(', ')}</span>}
                    {day.accommodation && <span> | Stay: {day.accommodation}</span>}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <div class="md:col-span-1">
        <div class="card p-6 sticky top-20">
          <div class="mb-4">
            <div class="text-3xl font-extrabold" style="color: var(--color-primary);">&#8358;{pkg.basePrice?.toLocaleString() || '0'}</div>
            <div class="text-sm" style="color: var(--color-muted);">per person</div>
          </div>

          <div class="space-y-3 mb-6 text-sm">
            {pkg.destination && (
              <div class="flex justify-between">
                <span style="color: var(--color-muted);">Destination</span>
                <span class="font-medium">{pkg.destination}</span>
              </div>
            )}
            {pkg.duration && (
              <div class="flex justify-between">
                <span style="color: var(--color-muted);">Duration</span>
                <span class="font-medium">{pkg.duration}</span>
              </div>
            )}
            {pkg.startDate && (
              <div class="flex justify-between">
                <span style="color: var(--color-muted);">Start Date</span>
                <span class="font-medium">{new Date(pkg.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
              </div>
            )}
            {pkg.availableSlots != null && (
              <div class="flex justify-between">
                <span style="color: var(--color-muted);">Available</span>
                <span class="font-medium" style="color: var(--color-primary);">{pkg.availableSlots} slots</span>
              </div>
            )}
          </div>

          <a href={`/travels/book?package=${pkg.slug}`} class="btn btn-primary w-full mb-3">Book This Tour</a>
          <a href="/travels/contact" class="btn btn-ghost w-full">Ask a Question</a>
        </div>
      </div>
    </div>
  </section>
</PlatformLayout>
