---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import { lightbase } from '../../lib/lightbase';

const [packagesResult, reviewsResult, blogResult] = await Promise.all([
  lightbase.query('travels_packages', { filter: { field: 'status', op: 'eq', value: 'active' }, sort: 'isFeatured:desc', limit: 4 }),
  lightbase.query('travels_reviews', { filter: { field: 'status', op: 'eq', value: 'approved' }, limit: 3 }),
  lightbase.query('travels_blog_posts', { filter: { field: 'status', op: 'eq', value: 'published' }, sort: 'publishedAt:desc', limit: 3 }),
]);

const packages = packagesResult.data || [];
const reviews = reviewsResult.data || [];
const blogPosts = blogResult.data || [];

const features = [
  { title: 'Licensed & Trusted', description: 'Officially licensed travel agency with experienced Hajj and Umrah guides.' },
  { title: 'Complete Packages', description: 'Everything included - visa, flights, hotels, transport, and guided tours.' },
  { title: 'Expert Guidance', description: 'Scholar-led groups with step-by-step guidance for all rituals.' },
  { title: '24/7 Support', description: 'Dedicated support throughout your sacred journey, anytime you need us.' },
];
---

<PlatformLayout title="Minhaajulhudaa Travels - Hajj & Umrah Services" platform="travels">
  <!-- Hero -->
  <section class="relative overflow-hidden" style="background: linear-gradient(135deg, rgb(242,185,28,0.08), rgb(5,179,77,0.05));">
    <div class="container-app py-12 md:py-20">
      <div class="max-w-3xl fade-in">
        <span class="badge badge-accent mb-4">Your Trusted Partner for Sacred Journeys</span>
        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-6">
          Embark on Your <span style="color: var(--color-primary);">Sacred Journey</span>
        </h1>
        <p class="text-lg md:text-xl mb-8" style="color: var(--color-muted);">
          Making Hajj and Umrah accessible, affordable, and meaningful. Complete packages with expert guidance every step of the way.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/travels/book" class="btn btn-primary">
            Book Now
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/travels/hajj-umrah" class="btn btn-ghost">View Packages</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="container-app py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {features.map((feature) => (
        <div class="card card-hover p-6">
          <div class="w-10 h-10 rounded-lg mb-3 flex items-center justify-center" style="background: rgb(5,179,77,0.1);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <h3 class="font-bold text-sm mb-2">{feature.title}</h3>
          <p class="text-xs" style="color: var(--color-muted);">{feature.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured Packages -->
  {packages.length > 0 && (
    <section class="container-app py-8">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold">Featured Packages</h2>
          <p class="text-sm mt-1" style="color: var(--color-muted);">Choose from our carefully curated Hajj and Umrah packages</p>
        </div>
        <a href="/travels/hajj-umrah" class="text-sm font-medium" style="color: var(--color-primary);">View All</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {packages.map((pkg) => (
          <div class="card card-hover overflow-hidden">
            <div class="aspect-[16/9] relative">
              {pkg.imageUrl && <img src={pkg.imageUrl} alt={pkg.title} class="w-full h-full object-cover" loading="lazy" />}
              <div class="absolute top-3 left-3 flex gap-2">
                <span class="badge badge-primary">{pkg.type.replace('-', ' ')}</span>
                <span class="badge badge-accent uppercase">{pkg.tier}</span>
              </div>
              {pkg.isFeatured && (
                <div class="absolute top-3 right-3">
                  <span class="badge" style="background: var(--color-accent); color: var(--color-brand-dark);">Featured</span>
                </div>
              )}
            </div>
            <div class="p-6">
              <h3 class="font-bold text-lg mb-1">{pkg.title}</h3>
              <p class="text-sm mb-3" style="color: var(--color-muted);">{pkg.destination} - {pkg.duration}</p>
              <p class="text-sm mb-4 line-clamp-2" style="color: var(--color-muted);">{pkg.shortDescription}</p>
              <div class="flex items-center justify-between">
                <div>
                  <div class="text-2xl font-extrabold" style="color: var(--color-primary);">₦{pkg.basePrice.toLocaleString()}</div>
                  <div class="text-xs" style="color: var(--color-muted);">per person</div>
                </div>
                <a href={`/travels/book?package=${pkg.slug}`} class="btn btn-primary">Book Now</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Reviews -->
  {reviews.length > 0 && (
    <section class="container-app py-16">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-12">What Our Pilgrims Say</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {reviews.map((review) => (
          <div class="card p-6">
            <div class="flex gap-1 mb-4">
              {Array.from({ length: review.rating }).map(() => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="color: var(--color-accent);">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>
            <h3 class="font-semibold mb-2">{review.title}</h3>
            <p class="text-sm mb-4" style="color: var(--color-muted);">"{review.content}"</p>
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold" style="background: rgb(5,179,77,0.1); color: var(--color-primary);">
                {review.customerName.charAt(0)}
              </div>
              <div>
                <div class="font-semibold text-sm">{review.customerName}</div>
                <div class="text-xs" style="color: var(--color-muted);">Verified Pilgrim</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Travel Guide Preview -->
  <section class="container-app py-16">
    <div class="card p-8 md:p-12">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold mb-4">Prepare for Your Journey</h2>
          <p class="mb-6" style="color: var(--color-muted);">Access our comprehensive travel guides, visa information, packing checklists, and pre-travel education courses to ensure you are fully prepared for your sacred journey.</p>
          <a href="/travels/guide" class="btn btn-primary">
            Explore Travel Guide
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="card p-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);" class="mb-2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <div class="text-sm font-semibold">Visa Info</div>
          </div>
          <div class="card p-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-accent);" class="mb-2"><path d="M20 7h-4V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v3H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/></svg>
            <div class="text-sm font-semibold">Packing List</div>
          </div>
          <div class="card p-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);" class="mb-2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            <div class="text-sm font-semibold">Rituals Guide</div>
          </div>
          <div class="card p-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-accent);" class="mb-2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            <div class="text-sm font-semibold">Health Tips</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-app py-16">
    <div class="card p-8 md:p-12 text-center" style="background: linear-gradient(135deg, rgb(5,179,77,0.1), rgb(242,185,28,0.1));">
      <h2 class="text-2xl md:text-4xl font-bold mb-4">Ready for Your Sacred Journey?</h2>
      <p class="mb-8 max-w-2xl mx-auto" style="color: var(--color-muted);">Let us handle the details while you focus on your worship. Book your Hajj or Umrah package today.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/travels/book" class="btn btn-primary">Book Now</a>
        <a href="/travels/contact" class="btn btn-ghost">Contact Us</a>
      </div>
    </div>
  </section>
</PlatformLayout>
