---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import { lightbase } from '../../lib/lightbase';

const packages = await lightbase.query('travels_packages', {
  filter: { field: 'status', op: 'eq', value: 'active' },
  sort: 'isFeatured:desc',
  limit: 50,
});

const selectedSlug = Astro.url.searchParams.get('package');
const selectedPkg = selectedSlug ? packages.data.find(p => p.slug === selectedSlug) : packages.data[0];
---
export const prerender = true;

<PlatformLayout title="Book Your Journey - Minhaajulhudaa Travels" platform="travels">
  <section class="container-app py-12 max-w-3xl">
    <h1 class="text-3xl md:text-4xl font-extrabold mb-4">Book Your Sacred Journey</h1>
    <p style="color: var(--color-muted);" class="mb-8">Complete the form below to book your package. Our team will confirm your booking within 24 hours.</p>

    <form id="booking-form" class="card p-6 md:p-8 space-y-6">
      <!-- Package Selection -->
      <div>
        <h2 class="text-lg font-bold mb-4 pb-2 border-b" style="border-color: var(--color-border);">Package Selection</h2>
        <label class="block text-sm font-medium mb-2">Select Package *</label>
        <select name="packageSlug" id="package-select" required class="input">
          {packages.data.map(pkg => (
            <option value={pkg.slug} selected={selectedPkg && pkg.slug === selectedPkg.slug}>
              {pkg.title} - ₦{pkg.basePrice.toLocaleString()} ({pkg.duration})
            </option>
          ))}
        </select>
        {selectedPkg && (
          <div class="mt-3 p-3 rounded-lg" style="background: rgb(5,179,77,0.05);">
            <div class="text-sm">
              <strong>{selectedPkg.title}</strong><br />
              <span style="color: var(--color-muted);">{selectedPkg.destination} - {selectedPkg.duration}</span><br />
              <span style="color: var(--color-primary);">₦{selectedPkg.basePrice.toLocaleString()} per person</span>
            </div>
          </div>
        )}
      </div>

      <!-- Lead Traveler -->
      <div>
        <h2 class="text-lg font-bold mb-4 pb-2 border-b" style="border-color: var(--color-border);">Lead Traveler Information</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1">Full Name *</label>
            <input type="text" name="customerName" required class="input" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Email *</label>
            <input type="email" name="customerEmail" required class="input" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Phone *</label>
            <input type="tel" name="customerPhone" required class="input" placeholder="+234..." />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Nationality</label>
            <input type="text" name="nationality" value="Nigerian" class="input" />
          </div>
        </div>
      </div>

      <!-- Travel Details -->
      <div>
        <h2 class="text-lg font-bold mb-4 pb-2 border-b" style="border-color: var(--color-border);">Travel Details</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1">Number of Travelers *</label>
            <input type="number" name="travelerCount" id="traveler-count" min="1" max="10" value="1" required class="input" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Preferred Start Date *</label>
            <input type="date" name="startDate" required class="input" />
          </div>
        </div>
      </div>

      <!-- Additional Travelers -->
      <div>
        <label class="block text-sm font-medium mb-2">Additional Travelers (optional)</label>
        <textarea name="additionalTravelers" class="input" rows="4" placeholder="List full names, dates of birth, and passport numbers of additional travelers (one per line)"></textarea>
      </div>

      <!-- Special Requests -->
      <div>
        <label class="block text-sm font-medium mb-1">Special Requests</label>
        <textarea name="specialRequests" class="input" rows="3" placeholder="Dietary requirements, accessibility needs, etc."></textarea>
      </div>

      <!-- Total Estimate -->
      <div class="p-4 rounded-lg" style="background: rgb(5,179,77,0.05);">
        <div class="flex justify-between items-center">
          <span class="font-semibold">Estimated Total:</span>
          <span class="text-2xl font-extrabold" style="color: var(--color-primary);" id="total-estimate">₦{selectedPkg ? selectedPkg.basePrice.toLocaleString() : '0'}</span>
        </div>
        <div class="text-xs mt-1" style="color: var(--color-muted);">Final price may vary based on dynamic pricing and add-ons</div>
      </div>

      <button type="submit" class="btn btn-primary w-full">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        Submit Booking
      </button>
    </form>
    <div id="form-message" class="hidden mt-4 p-4 rounded-lg"></div>
  </section>

  <script is:inline define:vars={{ packages: packages.data }}>
    const packageSelect = document.getElementById('package-select');
    const travelerCount = document.getElementById('traveler-count');
    const totalEstimate = document.getElementById('total-estimate');

    function updateTotal() {
      const pkg = packages.find(p => p.slug === packageSelect.value);
      const count = parseInt(travelerCount.value) || 1;
      if (pkg) {
        const total = pkg.basePrice * count;
        totalEstimate.textContent = '₦' + total.toLocaleString();
      }
    }

    packageSelect.addEventListener('change', updateTotal);
    travelerCount.addEventListener('input', updateTotal);

    document.getElementById('booking-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const btn = form.querySelector('button[type="submit"]');
      const msg = document.getElementById('form-message');
      btn.disabled = true;
      btn.textContent = 'Submitting...';

      const formData = new FormData(form);
      const data = Object.fromEntries(formData);
      const pkg = packages.find(p => p.slug === data.packageSlug);

      data.packageTitle = pkg ? pkg.title : '';
      data.totalAmount = pkg ? pkg.basePrice * parseInt(data.travelerCount) : 0;
      data.currency = 'NGN';
      data.bookingNumber = 'MHS-TRV/' + new Date().getFullYear() + '/' + Date.now().toString(36).toUpperCase();
      data.status = 'pending';
      data.paymentStatus = 'unpaid';
      data.bookedAt = new Date().toISOString();
      data.travelers = [];

      try {
        const response = await fetch('/api/travels/book', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await response.json();
        if (response.ok) {
          msg.className = 'mt-4 p-4 rounded-lg';
          msg.style.background = 'rgb(5,179,77,0.1)';
          msg.style.color = 'var(--color-primary)';
          msg.innerHTML = 'Booking submitted successfully! Your booking number is <strong>' + data.bookingNumber + '</strong>. Total: ₦' + data.totalAmount.toLocaleString() + '.<br><br>Our team will contact you within 24 hours to confirm your booking and arrange payment.';
          msg.classList.remove('hidden');
          form.reset();
          msg.scrollIntoView({ behavior: 'smooth' });
        } else {
          throw new Error(result.error || 'Booking failed');
        }
      } catch (err) {
        msg.className = 'mt-4 p-4 rounded-lg';
        msg.style.background = 'rgb(220,38,38,0.1)';
        msg.style.color = '#DC2626';
        msg.textContent = 'Error: ' + err.message;
        msg.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Submit Booking';
      }
    });
  </script>
</PlatformLayout>
