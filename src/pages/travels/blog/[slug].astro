---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';
import { formatDate } from '../../../lib/utils';

export async function getStaticPaths() {
  try {
    const result = await lightbase.query('travels_blog_posts', {
      filter: { field: 'status', op: 'eq', value: 'published' },
      limit: 100,
    });
    return (result.data || []).filter(doc => doc.slug).map(doc => ({ params: { slug: doc.slug }, props: { post: doc } }));
  } catch { return []; }
}

const { post } = Astro.props;
if (!post) {
  return Astro.redirect('/travels/blog');
}
---

<PlatformLayout title={`${post.title} - Travels Blog`} platform="travels">
  <article class="container-app py-12 max-w-3xl">
    <a href="/travels/blog" class="text-sm font-medium mb-6 inline-flex items-center gap-1" style="color: var(--color-primary);">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      All Posts
    </a>

    {post.category && <span class="badge badge-primary mb-4 inline-block">{post.category}</span>}
    <h1 class="text-3xl md:text-4xl font-extrabold mb-4">{post.title}</h1>

    <div class="flex items-center gap-4 mb-8 text-sm" style="color: var(--color-muted);">
      {post.authorName && <span>{post.authorName}</span>}
      {post.authorName && post.publishedAt && <span>|</span>}
      {post.publishedAt && <span>{formatDate(post.publishedAt, 'long')}</span>}
    </div>

    {post.featuredImage && (
      <img src={post.featuredImage} alt={post.title} class="w-full aspect-[16/9] object-cover rounded-2xl mb-8" />
    )}

    {post.tags && post.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        {post.tags.map((tag: string) => (
          <span class="badge" style="background: rgb(5,179,77,0.1); color: var(--color-primary);">{tag}</span>
        ))}
      </div>
    )}

    <div class="prose max-w-none">
      <Fragment set:html={post.content || ''} />
    </div>
  </article>
</PlatformLayout>
