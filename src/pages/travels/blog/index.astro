---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';
import { formatDate } from '../../../lib/utils';

const result = await lightbase.query('travels_blog_posts', {
  filter: { field: 'status', op: 'eq', value: 'published' },
  sort: 'publishedAt:desc',
  limit: 100,
});

const posts = result.data || [];
---

<PlatformLayout title="Blog - Minhaajulhudaa Travels" platform="travels">
  <!-- Hero -->
  <section class="relative overflow-hidden" style="background: linear-gradient(135deg, rgb(242,185,28,0.08), rgb(5,179,77,0.05));">
    <div class="container-app py-12 md:py-16">
      <div class="max-w-3xl fade-in">
        <span class="badge badge-accent mb-4">Travel Insights</span>
        <h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-6">
          Our <span style="color: var(--color-primary);">Blog</span>
        </h1>
        <p class="text-lg" style="color: var(--color-muted);">Travel tips, destination guides, Islamic travel perspectives, and news from our team.</p>
      </div>
    </div>
  </section>

  <!-- Posts Grid -->
  <section class="container-app py-12">
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post: any) => (
          <a href={`/travels/blog/${post.slug}`} class="card card-hover overflow-hidden block">
            {post.featuredImage && (
              <div class="aspect-[16/9]">
                <img src={post.featuredImage} alt={post.title} class="w-full h-full object-cover" loading="lazy" />
              </div>
            )}
            <div class="p-5">
              {post.category && <span class="badge badge-primary mb-3 inline-block">{post.category}</span>}
              <h3 class="font-bold text-lg mb-2 line-clamp-2">{post.title}</h3>
              {post.excerpt && <p class="text-sm mb-4 line-clamp-2" style="color: var(--color-muted);">{post.excerpt}</p>}
              <div class="flex items-center gap-2 text-xs" style="color: var(--color-muted);">
                {post.authorName && <span>{post.authorName}</span>}
                {post.authorName && post.publishedAt && <span>|</span>}
                {post.publishedAt && <span>{formatDate(post.publishedAt, 'date')}</span>}
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="card p-12 text-center">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--color-muted);" class="mx-auto mb-4"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        <h3 class="font-bold text-lg mb-2">No Blog Posts Yet</h3>
        <p class="text-sm" style="color: var(--color-muted);">We are preparing insightful content for you. Check back soon.</p>
      </div>
    )}
  </section>
</PlatformLayout>
