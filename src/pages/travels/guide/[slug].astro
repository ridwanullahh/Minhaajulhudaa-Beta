---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';
import { renderMarkdown } from '../../../lib/markdown';
import ArticleMeta from '../../../components/ArticleMeta.astro';

const { slug } = Astro.params;

let resource: any = null;
try {
  resource = await lightbase.findOne('travels_resources', { field: 'slug', op: 'eq', value: slug });
} catch (err) {
  console.error('[travels/guide/[slug]] fetch error:', err);
}

if (!resource) {
  Astro.response.status = 404;
  return Astro.redirect('/404');
}

const renderedContent = renderMarkdown(resource.content || '');
---

<PlatformLayout title={`${resource.title} - Minhaajulhudaa Travels`} description={resource.summary || resource.content?.substring(0, 160)} platform="travels">
  <article class="container-app py-12 max-w-3xl">
    <a href="/travels/guide" class="text-sm font-medium mb-6 inline-flex items-center gap-1" style="color: var(--color-primary);">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      All Resources
    </a>

    <h1 class="text-3xl md:text-4xl font-extrabold mb-4">{resource.title}</h1>

    <ArticleMeta
      title={resource.title}
      content={resource.content}
      category={resource.category}
      tags={resource.tags}
    />

    <div class="prose prose-lg max-w-none article-content" set:html={renderedContent} />

    {resource.attachments && resource.attachments.length > 0 && (
      <div class="mt-8 pt-8 border-t" style="border-color: var(--color-border);">
        <h3 class="font-bold mb-4">Attachments</h3>
        <div class="space-y-2">
          {resource.attachments.map(function(att) {
            return (
              <a href={att.url || '#'} class="card p-4 flex items-center gap-3 card-hover">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                <span class="text-sm font-medium">{att.title || 'Download'}</span>
              </a>
            );
          })}
        </div>
      </div>
    )}

    <div class="mt-12 card p-6 text-center" style="background: rgb(5,179,77,0.05);">
      <h3 class="font-bold mb-2">Ready for Your Journey?</h3>
      <p class="text-sm mb-4" style="color: var(--color-muted);">Browse our packages and book your sacred journey today.</p>
      <a href="/travels/hajj-umrah" class="btn btn-primary">View Packages</a>
    </div>
  </article>

  <style is:global>
    .article-content h1 { font-size: 2rem; font-weight: 700; margin: 1.5rem 0 1rem; }
    .article-content h2 { font-size: 1.5rem; font-weight: 700; margin: 1.5rem 0 0.75rem; }
    .article-content h3 { font-size: 1.25rem; font-weight: 600; margin: 1.25rem 0 0.5rem; }
    .article-content p { margin: 0.75rem 0; line-height: 1.8; color: var(--color-muted); }
    .article-content ul, .article-content ol { margin: 0.75rem 0; padding-left: 1.5rem; }
    .article-content ul { list-style: disc; }
    .article-content ol { list-style: decimal; }
    .article-content li { margin: 0.375rem 0; color: var(--color-muted); }
    .article-content blockquote { border-left: 3px solid var(--color-primary); padding-left: 1rem; margin: 1rem 0; color: var(--color-muted); font-style: italic; }
    .article-content code { background: var(--color-surface); padding: 0.125rem 0.375rem; border-radius: 3px; font-size: 0.875em; }
    .article-content pre { background: var(--color-surface); padding: 0.75rem; border-radius: 6px; overflow-x: auto; margin: 0.75rem 0; }
    .article-content pre code { background: none; padding: 0; }
    .article-content table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
    .article-content th, .article-content td { border: 1px solid var(--color-border); padding: 0.5rem; text-align: left; }
    .article-content th { background: var(--color-surface); font-weight: 600; }
    .article-content hr { border: none; border-top: 1px solid var(--color-border); margin: 1.5rem 0; }
    .article-content img { max-width: 100%; height: auto; border-radius: 6px; }
    .article-content a { color: var(--color-primary); text-decoration: underline; }
  </style>
</PlatformLayout>
