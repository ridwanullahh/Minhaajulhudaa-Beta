---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';

const result = await lightbase.query('travels_courses', {
  filter: { field: 'status', op: 'eq', value: 'published' },
  sort: 'isFeatured:desc,_created_at:desc',
  limit: 100,
});

const courses = result.data || [];
---

<PlatformLayout title="Pre-Travel Courses - Minhaajulhudaa Travels" platform="travels">
  <!-- Hero -->
  <section class="relative overflow-hidden" style="background: linear-gradient(135deg, rgb(242,185,28,0.08), rgb(5,179,77,0.05));">
    <div class="container-app py-12 md:py-16">
      <div class="max-w-3xl fade-in">
        <span class="badge badge-accent mb-4">Travel Education</span>
        <h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-6">
          Pre-Travel <span style="color: var(--color-primary);">Courses</span>
        </h1>
        <p class="text-lg" style="color: var(--color-muted);">Prepare for your sacred journey with our comprehensive courses on Hajj rituals, Umrah guide, and the history of Makkah and Madinah.</p>
      </div>
    </div>
  </section>

  <!-- Courses Grid -->
  <section class="container-app py-12">
    {courses.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {courses.map((course: any) => (
          <a href={`/travels/courses/${course.slug}`} class="card card-hover overflow-hidden block">
            {course.featuredImage && (
              <div class="aspect-[16/9]">
                <img src={course.featuredImage} alt={course.title} class="w-full h-full object-cover" loading="lazy" />
              </div>
            )}
            <div class="p-5">
              <div class="flex items-center gap-2 mb-3">
                {course.level && <span class="badge badge-primary capitalize">{course.level}</span>}
                {course.duration && <span class="text-xs" style="color: var(--color-muted);">{course.duration}</span>}
              </div>
              <h3 class="font-bold text-lg mb-2">{course.title}</h3>
              {course.shortDescription && <p class="text-sm mb-4 line-clamp-2" style="color: var(--color-muted);">{course.shortDescription}</p>}
              <div class="flex items-center justify-between">
                {course.isFree ? (
                  <span class="text-sm font-bold" style="color: var(--color-primary);">Free</span>
                ) : (
                  <span class="text-sm font-bold" style="color: var(--color-primary);">&#8358;{course.price?.toLocaleString() || '0'}</span>
                )}
                <span class="btn btn-outline text-xs">View Course</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="card p-12 text-center">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--color-muted);" class="mx-auto mb-4"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
        <h3 class="font-bold text-lg mb-2">No Courses Available</h3>
        <p class="text-sm" style="color: var(--color-muted);">We are preparing educational content for your journey. Check back soon.</p>
      </div>
    )}
  </section>

  <!-- CTA -->
  <section class="container-app py-16">
    <div class="card p-8 md:p-12 text-center" style="background: linear-gradient(135deg, rgb(5,179,77,0.1), rgb(242,185,28,0.1));">
      <h2 class="text-2xl md:text-3xl font-bold mb-4">Prepare Before You Travel</h2>
      <p class="mb-8 max-w-2xl mx-auto" style="color: var(--color-muted);">Our courses are designed to help you understand the rituals and make the most of your pilgrimage experience.</p>
      <a href="/travels/book" class="btn btn-primary">Book a Package</a>
    </div>
  </section>
</PlatformLayout>
