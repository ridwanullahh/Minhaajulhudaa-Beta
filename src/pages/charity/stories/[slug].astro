---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';
import { renderMarkdown } from '../../../lib/markdown';
import ArticleMeta from '../../../components/ArticleMeta.astro';

const { slug } = Astro.params;

let story: any = null;
try {
  story = await lightbase.findOne('charity_success_stories', { field: 'slug', op: 'eq', value: slug });
} catch (err) {
  console.error('[charity/stories/[slug]] fetch error:', err);
}

if (!story) {
  Astro.response.status = 404;
  return Astro.redirect('/404');
}

let related: any[] = [];
try {
  const relatedStories = await lightbase.query('charity_success_stories', {
    filter: { field: 'status', op: 'eq', value: 'published' },
    sort: 'publishedAt:desc',
    limit: 5,
  });
  related = (relatedStories.data || []).filter(function(s: any) { return s.slug !== story.slug; }).slice(0, 3);
} catch (err) {
  console.error('[charity/stories/[slug]] related query error:', err);
}

const renderedContent = renderMarkdown(story.content || '');
---

<PlatformLayout title={`${story.title} - Success Stories - Minhaajulhudaa Charity`} description={story.summary || story.content?.substring(0, 160)} platform="charity">
  <section class="container-app py-12 max-w-4xl">
    <a href="/charity/stories" class="text-sm font-medium mb-6 inline-flex items-center gap-1" style="color: var(--color-primary);">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      All Stories
    </a>

    <article>
      <h1 class="text-3xl md:text-4xl font-extrabold mb-4">{story.title}</h1>

      {story.summary && <p class="text-lg mb-6" style="color: var(--color-muted);">{story.summary}</p>}

      <ArticleMeta
        title={story.title}
        content={story.content}
        publishedAt={story.publishedAt}
        category={story.category}
        tags={story.tags}
      />

      {story.imageUrl && (
        <img src={story.imageUrl} alt={story.title} class="w-full rounded-2xl mb-8" />
      )}

      <div class="prose max-w-none article-content" set:html={renderedContent} />

      {story.impactMetrics && Object.keys(story.impactMetrics).length > 0 && (
        <div class="mt-8 p-6 rounded-2xl" style="background: rgb(5,179,77,0.05); border: 1px solid rgb(5,179,77,0.15);">
          <h3 class="font-bold mb-4" style="color: var(--color-primary);">Impact Metrics</h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {Object.entries(story.impactMetrics).map(function(entry) {
              const key = entry[0];
              const value = entry[1];
              return (
                <div class="text-center">
                  <div class="text-2xl font-extrabold" style="color: var(--color-primary);">{value}</div>
                  <div class="text-xs mt-1" style="color: var(--color-muted);">{key.replace(/([A-Z])/g, ' $1').trim()}</div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {story.testimonial && (
        <div class="mt-8 card p-6">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mb-3" style="color: var(--color-accent);"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V21z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
          <p class="italic" style="color: var(--color-muted);">"{story.testimonial}"</p>
          {story.beneficiaryName && <p class="text-sm font-medium mt-2">- {story.beneficiaryName}</p>}
        </div>
      )}
    </article>

    {related.length > 0 && (
      <div class="mt-12 pt-8" style="border-top: 1px solid var(--color-border);">
        <h2 class="text-xl font-bold mb-6">More Stories</h2>
        <div class="grid md:grid-cols-3 gap-6">
          {related.map(function(r) {
            return (
              <a href={`/charity/stories/${r.slug}`} class="card card-hover overflow-hidden block">
                <div class="aspect-[16/9]">
                  {r.imageUrl ? <img src={r.imageUrl} alt={r.title} class="w-full h-full object-cover" loading="lazy" /> : <div class="w-full h-full" style="background: var(--color-surface);"></div>}
                </div>
                <div class="p-4">
                  <h3 class="font-bold text-sm mb-1">{r.title}</h3>
                  <p class="text-xs line-clamp-2" style="color: var(--color-muted);">{r.summary}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}
  </section>

  <style is:global>
    .article-content h1 { font-size: 2rem; font-weight: 700; margin: 1.5rem 0 1rem; }
    .article-content h2 { font-size: 1.5rem; font-weight: 700; margin: 1.5rem 0 0.75rem; }
    .article-content h3 { font-size: 1.25rem; font-weight: 600; margin: 1.25rem 0 0.5rem; }
    .article-content p { margin: 0.75rem 0; line-height: 1.8; color: var(--color-muted); }
    .article-content ul, .article-content ol { margin: 0.75rem 0; padding-left: 1.5rem; }
    .article-content ul { list-style: disc; }
    .article-content ol { list-style: decimal; }
    .article-content li { margin: 0.375rem 0; color: var(--color-muted); }
    .article-content blockquote { border-left: 3px solid var(--color-primary); padding-left: 1rem; margin: 1rem 0; color: var(--color-muted); font-style: italic; }
    .article-content img { max-width: 100%; height: auto; border-radius: 6px; }
    .article-content a { color: var(--color-primary); text-decoration: underline; }
  </style>
</PlatformLayout>
