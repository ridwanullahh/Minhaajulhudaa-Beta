---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';

const { slug } = Astro.params;

let campaign: any = null;
try {
  campaign = await lightbase.findOne('charity_campaigns', { field: 'slug', op: 'eq', value: slug });
} catch (err) {
  console.error('[charity/campaigns/[slug].astro] fetch error:', err);
}

if (!campaign) {
  Astro.response.status = 404;
  return Astro.redirect('/404');
}

let updates: any[] = [];
try {
  const updatesResult = await lightbase.query('charity_campaign_updates', {
    filter: { field: 'campaignId', op: 'eq', value: campaign.id },
    limit: 5,
  });
  updates = updatesResult.data || [];
} catch (err) {
  console.error('[charity/campaigns/[slug]] updates query error:', err);
}
---

<PlatformLayout title={`${campaign.title} - Minhaajulhudaa Charity`} platform="charity">
  <section class="container-app py-12 max-w-4xl">
    <a href="/charity/campaigns" class="text-sm font-medium mb-6 inline-flex items-center gap-1" style="color: var(--color-primary);">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      All Campaigns
    </a>

    <div class="grid md:grid-cols-2 gap-8 mb-8">
      <div>
        {campaign.imageUrl && <img src={campaign.imageUrl} alt={campaign.title} class="w-full rounded-2xl" />}
      </div>
      <div>
        <div class="flex gap-2 mb-4">
          <span class="badge badge-primary">{campaign.category}</span>
          {campaign.isUrgent && <span class="badge badge-accent">Urgent</span>}
        </div>
        <h1 class="text-2xl md:text-3xl font-extrabold mb-4">{campaign.title}</h1>
        <p style="color: var(--color-muted);" class="mb-6">{campaign.description}</p>

        <!-- Progress -->
        <div class="mb-6">
          <div class="flex justify-between text-sm mb-1">
            <span class="font-semibold text-lg" style="color: var(--color-primary);">₦{campaign.raisedAmount.toLocaleString()}</span>
            <span style="color: var(--color-muted);">of ₦{campaign.goalAmount.toLocaleString()}</span>
          </div>
          <div class="h-3 rounded-full" style="background: var(--color-border);">
            <div class="h-full rounded-full" style={`width: ${Math.round((campaign.raisedAmount / campaign.goalAmount) * 100)}%; background: var(--color-primary);`}></div>
          </div>
          <div class="flex justify-between text-xs mt-2" style="color: var(--color-muted);">
            <span>{Math.round((campaign.raisedAmount / campaign.goalAmount) * 100)}% funded</span>
            <span>{campaign.beneficiaryCount} beneficiaries</span>
          </div>
        </div>

        <!-- Donation Form -->
        <form id="campaign-donation-form" class="card p-4 space-y-3">
          <div>
            <label class="block text-sm font-medium mb-2">Donation Amount (NGN)</label>
            <div class="grid grid-cols-4 gap-2 mb-2">
              {[5000, 10000, 25000, 50000].map(amt => (
                <button type="button" class="amount-btn p-2 rounded-lg text-xs font-semibold border" style="border-color: var(--color-border);" data-amount={amt}>₦{amt / 1000}k</button>
              ))}
            </div>
            <input type="number" name="amount" id="amount-input" placeholder="Custom amount" class="input" min="100" required />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <input type="text" name="donorName" placeholder="Your name *" class="input" required />
            <input type="email" name="donorEmail" placeholder="Email *" class="input" required />
          </div>
          <input type="hidden" name="category" value={campaign.category || 'sadaqah'} />
          <input type="hidden" name="campaignId" value={campaign.id} />
          <button type="submit" class="btn btn-primary w-full">Donate Now</button>
        </form>
        <div id="form-message" class="hidden mt-3 p-3 rounded-lg text-sm"></div>
      </div>
    </div>

    <!-- Campaign Updates -->
    {updates.length > 0 && (
      <div class="mt-12">
        <h2 class="text-2xl font-bold mb-6">Campaign Updates</h2>
        <div class="space-y-4">
          {updates.map((update) => (
            <div class="card p-6">
              <div class="text-xs mb-2" style="color: var(--color-muted);">{new Date(update.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
              <h3 class="font-bold mb-2">{update.title}</h3>
              <p class="text-sm" style="color: var(--color-muted);">{update.content}</p>
            </div>
          ))}
        </div>
      </div>
    )}
  </section>

  <script is:inline>
    document.querySelectorAll('.amount-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.amount-btn').forEach(function(b) {
          b.classList.remove('border-[var(--color-primary)]', 'bg-[rgb(5,179,77,0.05)]');
          b.style.borderColor = 'var(--color-border)';
        });
        btn.classList.add('border-[var(--color-primary)]', 'bg-[rgb(5,179,77,0.05)]');
        btn.style.borderColor = 'var(--color-primary)';
        document.getElementById('amount-input').value = btn.dataset.amount;
      });
    });

    document.getElementById('campaign-donation-form')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      const form = e.target;
      const btn = form.querySelector('button[type="submit"]');
      const msg = document.getElementById('form-message');
      btn.disabled = true;
      btn.textContent = 'Processing...';

      const data = Object.fromEntries(new FormData(form));
      data.reference = 'CHR-DON-' + Date.now().toString(36).toUpperCase();
      data.status = 'pending';
      data.currency = 'NGN';
      data.method = 'card';
      data.isAnonymous = false;
      data.donatedAt = new Date().toISOString();

      try {
        const response = await fetch('/api/charity/donate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await response.json();
        if (response.ok) {
          msg.style.background = 'rgb(5,179,77,0.1)';
          msg.style.color = 'var(--color-primary)';
          msg.innerHTML = 'Jazakum Allahu Khairan! Your donation of ₦' + parseInt(data.amount).toLocaleString() + ' has been initiated. Reference: ' + data.reference;
          msg.classList.remove('hidden');
          form.reset();
        } else {
          throw new Error(result.error || 'Failed');
        }
      } catch (err) {
        msg.style.background = 'rgb(220,38,38,0.1)';
        msg.style.color = '#DC2626';
        msg.textContent = 'Error: ' + err.message;
        msg.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Donate Now';
      }
    });
  </script>
</PlatformLayout>
