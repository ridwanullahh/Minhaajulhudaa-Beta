---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';
import { renderMarkdown } from '../../../lib/markdown';
import ArticleMeta from '../../../components/ArticleMeta.astro';
import { formatDate } from '../../../lib/utils';

const { slug } = Astro.params;

let post: any = null;
try {
  post = await lightbase.findOne('charity_blog_posts', { field: 'slug', op: 'eq', value: slug });
} catch (err) {
  console.error('[charity/blog/[slug]] fetch error:', err);
}

if (!post) {
  Astro.response.status = 404;
  return Astro.redirect('/404');
}

let relatedPosts: any[] = [];
try {
  if (post.category) {
    const result = await lightbase.query('charity_blog_posts', {
      filter: { field: 'category', op: 'eq', value: post.category },
      sort: 'publishedAt:desc',
      limit: 3,
    });
    relatedPosts = (result.data || []).filter((p: any) => p.id !== post.id);
  }
} catch {}

const renderedContent = renderMarkdown(post.content || '');
---

<PlatformLayout title={`${post.title} - Charity Blog`} description={post.excerpt || post.content?.substring(0, 160)} platform="charity">
  <article class="container-app py-8 md:py-12 fade-in">
    <div class="max-w-3xl mx-auto">
      <nav class="flex items-center gap-2 text-sm mb-8" style="color: var(--color-muted);">
        <a href="/charity" class="hover:underline">Charity</a>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/charity/blog" class="hover:underline">Blog</a>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span style="color: var(--color-foreground);">{post.title}</span>
      </nav>

      <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-4">{post.title}</h1>

      <ArticleMeta
        title={post.title}
        content={post.content}
        authorName={post.authorName}
        publishedAt={post.publishedAt}
        category={post.category}
        tags={post.tags}
      />

      {post.featuredImageUrl && (
        <div class="aspect-[16/9] rounded-xl overflow-hidden mb-8">
          <img src={post.featuredImageUrl} alt={post.title} class="w-full h-full object-cover" />
        </div>
      )}

      <div class="prose max-w-none article-content" set:html={renderedContent} />

      <div class="card p-8 mt-12 text-center" style="background: linear-gradient(135deg, rgb(5,179,77,0.08), rgb(242,185,28,0.05));">
        <h3 class="font-bold text-xl mb-2">Support Our Mission</h3>
        <p class="text-sm mb-4" style="color: var(--color-muted);">Your donations make stories like this possible. Join us in making a difference.</p>
        <a href="/charity/campaigns" class="btn btn-primary">Donate Now</a>
      </div>

      {relatedPosts.length > 0 && (
        <div class="mt-16">
          <h3 class="font-bold text-xl mb-6">Related Articles</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {relatedPosts.slice(0, 3).map((rp: any) => (
              <a href={`/charity/blog/${rp.slug}`} class="card card-hover p-4 block">
                <span class="text-xs" style="color: var(--color-muted);">{rp.category || ''}</span>
                <h4 class="font-bold text-sm mt-1 mb-2 leading-snug">{rp.title}</h4>
                <span class="text-xs" style="color: var(--color-muted);">{rp.publishedAt ? formatDate(rp.publishedAt) : ''}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>

  <style is:global>
    .article-content h1 { font-size: 2rem; font-weight: 700; margin: 1.5rem 0 1rem; }
    .article-content h2 { font-size: 1.5rem; font-weight: 700; margin: 1.5rem 0 0.75rem; }
    .article-content h3 { font-size: 1.25rem; font-weight: 600; margin: 1.25rem 0 0.5rem; }
    .article-content p { margin: 0.75rem 0; line-height: 1.8; color: var(--color-muted); }
    .article-content ul, .article-content ol { margin: 0.75rem 0; padding-left: 1.5rem; }
    .article-content ul { list-style: disc; }
    .article-content ol { list-style: decimal; }
    .article-content li { margin: 0.375rem 0; color: var(--color-muted); }
    .article-content blockquote { border-left: 3px solid var(--color-primary); padding-left: 1rem; margin: 1rem 0; color: var(--color-muted); font-style: italic; }
    .article-content code { background: var(--color-surface); padding: 0.125rem 0.375rem; border-radius: 3px; font-size: 0.875em; }
    .article-content pre { background: var(--color-surface); padding: 0.75rem; border-radius: 6px; overflow-x: auto; margin: 0.75rem 0; }
    .article-content pre code { background: none; padding: 0; }
    .article-content table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
    .article-content th, .article-content td { border: 1px solid var(--color-border); padding: 0.5rem; text-align: left; }
    .article-content th { background: var(--color-surface); font-weight: 600; }
    .article-content hr { border: none; border-top: 1px solid var(--color-border); margin: 1.5rem 0; }
    .article-content img { max-width: 100%; height: auto; border-radius: 6px; }
    .article-content a { color: var(--color-primary); text-decoration: underline; }
  </style>
</PlatformLayout>
