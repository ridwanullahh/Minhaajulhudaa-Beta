---
import PlatformLayout from '../../../layouts/PlatformLayout.astro';
import { lightbase } from '../../../lib/lightbase';
import { formatDate, truncate } from '../../../lib/utils';

let posts: any[] = [];
try {
  const result = await lightbase.query('charity_blog_posts', {
    filter: { field: 'status', op: 'eq', value: 'published' },
    sort: 'publishedAt:desc',
    limit: 100,
  });
  posts = result.data || [];
} catch {}

const categories = [...new Set(posts.map((p: any) => p.category).filter(Boolean))];
---
export const prerender = true;

<PlatformLayout title="Blog - Minhaajulhudaa Charity" platform="charity">
  <!-- Hero -->
  <section class="relative overflow-hidden" style="background: linear-gradient(135deg, rgb(5,179,77,0.08), rgb(242,185,28,0.05));">
    <div class="container-app py-12 md:py-16">
      <div class="max-w-3xl fade-in">
        <span class="badge badge-accent mb-4">Insights and Updates</span>
        <h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-4">Charity Blog</h1>
        <p class="text-lg" style="color: var(--color-muted);">Stories of impact, Islamic perspectives on giving, and updates from the field.</p>
      </div>
    </div>
  </section>

  <!-- Category Filter -->
  {categories.length > 0 && (
    <section class="container-app py-6">
      <div class="flex flex-wrap gap-2">
        <a href="/charity/blog" class="btn btn-primary btn-sm text-xs">All</a>
        {categories.map((cat: string) => (
          <span class="badge badge-accent cursor-pointer text-xs">{cat}</span>
        ))}
      </div>
    </section>
  )}

  <!-- Posts Grid -->
  <section class="container-app pb-16">
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post: any) => (
          <a href={`/charity/blog/${post.slug}`} class="card card-hover overflow-hidden block">
            <div class="aspect-[16/9]" style="background: var(--color-background);">
              {post.featuredImageUrl && <img src={post.featuredImageUrl} alt={post.title} class="w-full h-full object-cover" loading="lazy" />}
              {!post.featuredImageUrl && (
                <div class="w-full h-full flex items-center justify-center" style="color: var(--color-border);">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                </div>
              )}
            </div>
            <div class="p-6">
              {post.category && <span class="badge badge-primary text-xs mb-3">{post.category}</span>}
              <h2 class="font-bold text-lg mb-2 leading-snug">{post.title}</h2>
              <p class="text-sm mb-4 line-clamp-2" style="color: var(--color-muted);">{post.excerpt || truncate(post.content || '', 120)}</p>
              <div class="flex items-center gap-3 text-xs" style="color: var(--color-muted);">
                {post.authorName && <span class="font-medium" style="color: var(--color-foreground);">{post.authorName}</span>}
                {post.publishedAt && <span>{formatDate(post.publishedAt)}</span>}
                {post.readingTimeMinutes && <span>{post.readingTimeMinutes} min read</span>}
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="card p-12 text-center">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto mb-4" style="color: var(--color-muted);"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        <h3 class="font-bold text-lg mb-2">No Articles Yet</h3>
        <p class="text-sm" style="color: var(--color-muted);">Check back soon for inspiring stories and updates from our charity work.</p>
      </div>
    )}
  </section>
</PlatformLayout>
