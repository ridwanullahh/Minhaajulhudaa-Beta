---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import { lightbase } from '../../lib/lightbase';

const roles = await lightbase.query('charity_volunteer_roles', { filter: { field: 'status', op: 'eq', value: 'open' }, limit: 10 });
---
export const prerender = true;

<PlatformLayout title="How to Help - Minhaajulhudaa Charity" platform="charity">
  <section class="container-app py-12 max-w-4xl">
    <h1 class="text-3xl md:text-4xl font-extrabold mb-4">How You Can Help</h1>
    <p style="color: var(--color-muted);" class="mb-8">There are many ways to support our mission. Every contribution makes a difference.</p>

    <!-- Donate -->
    <div class="card p-8 mb-6">
      <div class="flex items-start gap-4">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center shrink-0" style="background: rgb(5,179,77,0.1);">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <div class="flex-1">
          <h2 class="text-xl font-bold mb-2">Donate</h2>
          <p class="text-sm mb-4" style="color: var(--color-muted);">Your financial contribution funds our campaigns and provides direct relief to those in need. Choose from one-time or recurring donations.</p>
          <a href="/charity/campaigns" class="btn btn-primary">Donate Now</a>
        </div>
      </div>
    </div>

    <!-- Volunteer -->
    <div class="card p-8 mb-6">
      <div class="flex items-start gap-4">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center shrink-0" style="background: rgb(242,185,28,0.15);">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-accent);"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="flex-1">
          <h2 class="text-xl font-bold mb-2">Volunteer</h2>
          <p class="text-sm mb-4" style="color: var(--color-muted);">Share your time and skills. Join our team of dedicated volunteers making a difference on the ground.</p>

          <form id="volunteer-form" class="space-y-4 mt-4">
            <div class="grid md:grid-cols-2 gap-4">
              <input type="text" name="name" placeholder="Full Name *" class="input" required />
              <input type="email" name="email" placeholder="Email *" class="input" required />
              <input type="tel" name="phone" placeholder="Phone *" class="input" required />
              <select name="preferredRole" class="input">
                <option value="">Preferred Role...</option>
                {roles.data && roles.data.map(r => <option value={r.title}>{r.title}</option>)}
              </select>
            </div>
            <div class="grid md:grid-cols-2 gap-4">
              <select name="availability" class="input">
                <option value="flexible">Availability...</option>
                <option value="weekdays">Weekdays</option>
                <option value="weekends">Weekends</option>
                <option value="evenings">Evenings</option>
                <option value="flexible">Flexible</option>
              </select>
              <input type="text" name="location" placeholder="Your Location" class="input" />
            </div>
            <textarea name="bio" placeholder="Tell us about yourself and your skills..." class="input" rows="4"></textarea>
            <button type="submit" class="btn btn-primary">Register as Volunteer</button>
          </form>
          <div id="form-message" class="hidden mt-4 p-4 rounded-lg"></div>
        </div>
      </div>
    </div>

    <!-- Spread the Word -->
    <div class="card p-8">
      <div class="flex items-start gap-4">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center shrink-0" style="background: rgb(5,179,77,0.1);">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-primary);"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
        </div>
        <div class="flex-1">
          <h2 class="text-xl font-bold mb-2">Spread the Word</h2>
          <p class="text-sm" style="color: var(--color-muted);">Share our campaigns with your network. Awareness multiplies impact and brings more support to those in need.</p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.getElementById('volunteer-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const btn = form.querySelector('button[type="submit"]');
      const msg = document.getElementById('form-message');
      btn.disabled = true; btn.textContent = 'Registering...';
      const data = Object.fromEntries(new FormData(form));
      data.status = 'pending'; data.joinedAt = new Date().toISOString(); data.hoursLogged = 0;
      try {
        const response = await fetch('/api/charity/volunteer', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        if (response.ok) {
          msg.style.background = 'rgb(5,179,77,0.1)'; msg.style.color = 'var(--color-primary)';
          msg.textContent = 'Thank you for registering! Our volunteer coordinator will contact you within 5 business days.';
          msg.classList.remove('hidden'); form.reset();
        } else throw new Error('Registration failed');
      } catch (err) {
        msg.style.background = 'rgb(220,38,38,0.1)'; msg.style.color = '#DC2626';
        msg.textContent = 'Error: ' + err.message; msg.classList.remove('hidden');
      } finally { btn.disabled = false; btn.textContent = 'Register as Volunteer'; }
    });
  </script>
</PlatformLayout>
